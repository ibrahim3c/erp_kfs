@model ERP_KFS_MVC.Areas.Identity.ViewModels.EditRoleViewModel

@{
    ViewData["Title"] = "تعديل الدور";
    var isProtected = ViewBag.IsProtected as bool? ?? false;
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1><i class="fas fa-edit mr-2"></i> تعديل الدور</h1>
            </div>
        </div>
    </div>
</div>

@if (isProtected)
{
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle"></i> هذا الدور أساسي ولا يمكن تعديله.
    </div>
}

<section class="content">
    <div class="container-fluid">
        <div class="card card-outline card-primary">
            <div class="card-header">
                <h3 class="card-title">بيانات الدور</h3>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <div class="form-group">
                        <label asp-for="Name" class="control-label">اسم الدور</label>
                        <input asp-for="Name" class="form-control" placeholder="أدخل اسم الدور" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-group mt-3">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> حفظ التعديلات</button>
                        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-right"></i> رجوع</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}