@model ERP_KFS_MVC.Areas.Identity.ViewModels.CreateRoleViewModel

@{
    ViewData["Title"] = "إضافة دور جديد";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1><i class="fas fa-user-plus mr-2"></i> إضافة دور جديد</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-outline card-primary">
            <div class="card-header">
                <h3 class="card-title">بيانات الدور</h3>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="Name" class="control-label">اسم الدور</label>
                        <input asp-for="Name" class="form-control" placeholder="أدخل اسم الدور (مثل: Admin, HR, Manager)" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-group mt-3">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> حفظ</button>
                        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-right"></i> رجوع</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}