@model ERP_KFS_MVC.Areas.Identity.ViewModels.RoleUsersViewModel

@{
    ViewData["Title"] = "مستخدمي الدور: " + Model.RoleName;
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1><i class="fas fa-users mr-2"></i> مستخدمي الدور: @Model.RoleName</h1>
            </div>
            <div class="col-sm-6 text-left">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-right mr-1"></i> رجوع
                </a>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <strong>Success:</strong> @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <strong>Error:</strong> @TempData["Error"]
    </div>
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-outline card-success">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-user-check mr-1"></i> المستخدمون في هذا الدور (@Model.UsersInRole.Count)</h3>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-striped text-center">
                            <thead>
                                <tr>
                                    <th>اسم المستخدم</th>
                                    <th>البريد الإلكتروني</th>
                                    <th>إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.UsersInRole)
                                {
                                    <tr>
                                        <td>@user.FullName</td>
                                        <td>@user.Email</td>
                                        <td>
                                            @if (Model.RoleName == "Admin" && user.Email == "admin@erp.com")
                                            {
                                                <span class="badge badge-warning">مدير عام</span>
                                            }
                                            else
                                            {
                                                <form asp-action="RemoveUserFromRole" method="post" style="display:inline">
                                                    <input type="hidden" name="roleId" value="@Model.RoleId" />
                                                    <input type="hidden" name="userId" value="@user.Id" />
                                                    <button type="submit" class="btn btn-xs btn-danger"
                                                            onclick="return confirm('هل أنت متأكد من إزالة هذا المستخدم من الدور؟')">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (!Model.UsersInRole.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-muted">لا يوجد مستخدمين في هذا الدور</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card card-outline card-primary">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-user-plus mr-1"></i> إضافة مستخدم للدور</h3>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-striped text-center">
                            <thead>
                                <tr>
                                    <th>اسم المستخدم</th>
                                    <th>البريد الإلكتروني</th>
                                    <th>إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.AllUsers)
                                {
                                    <tr>
                                        <td>@user.FullName</td>
                                        <td>@user.Email</td>
                                        <td>
                                            <form asp-action="AddUserToRole" method="post" style="display:inline">
                                                <input type="hidden" name="roleId" value="@Model.RoleId" />
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn btn-xs btn-success">
                                                    <i class="fas fa-plus"></i> إضافة
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                @if (!Model.AllUsers.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-muted">لا يوجد مستخدمين متاحين</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>