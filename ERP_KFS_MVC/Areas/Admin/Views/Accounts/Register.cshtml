@model ERP_KFS_MVC.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "إنشاء حساب جديد";
    var returnUrl = ViewData["ReturnUrl"] as string;
    Layout = "_LoginLayout";
}

<style>
    /* --- كسر حاجز العرض الخاص بالـ LoginLayout --- */
    .login-box, .register-box {
        width: 95% !important; /* زيادة العرض قليلاً لاستيعاب العناصر المضغوطة */
        max-width: 850px !important;
        margin: auto;
    }

    .card {
        margin-bottom: 0 !important;
        padding: 15px !important; /* تقليل الـ Padding الداخلي للـ Card نفسه لو موجود */
    }

    /* حركة دخول ناعمة للفورم */
    .register-form-container {
        animation: formFadeIn 0.5s ease-out;
        padding: 5px; /* تقليل البادنج هنا */
    }

    @@keyframes formFadeIn {
        from {
            opacity: 0;
            transform: scale(0.98);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* تقسيم الفورم لعمودين (CSS Grid) */
    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px 20px; /* **تقليل الـ Gap بين الصفوف والأعمدة** */
    }

    @@media (max-width: 768px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .login-box, .register-box {
            width: 100% !important;
        }
    }

    .input-group-custom {
        margin-bottom: 0; /* **إلغاء المارجن السفلي بالكامل** الاعتماد على الـ Gap بتاع الـ Grid */
    }

        .input-group-custom label {
            display: block;
            font-size: 0.8rem; /* **تصغير حجم الخط قليلاً** */
            font-weight: 600;
            color: #334155;
            margin-bottom: 4px; /* **تقليل المسافة تحت الـ Label** */
        }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

        .input-wrapper .main-icon {
            position: absolute;
            right: 12px; /* تقليل المسافة */
            color: #94a3b8;
            font-size: 1rem; /* تصغير الأيقونة */
            pointer-events: none;
        }

        .input-wrapper .toggle-password {
            position: absolute;
            left: 12px;
            color: #94a3b8;
            font-size: 1rem;
            cursor: pointer;
            padding: 2px;
        }

            .input-wrapper .toggle-password:hover {
                color: #007c92;
            }

        .input-wrapper input {
            width: 100%;
            padding: 8px 35px 8px 35px; /* **تقليل البادنج الداخلي للـ Input** لتقليل ارتفاعه */
            font-size: 0.9rem; /* **تصغير خط الـ Input** */
            color: #1e293b;
            background-color: #f8fafc;
            border: 1.5px solid #e2e8f0;
            border-radius: 8px; /* تقليل دوران الحواف ليتناسب مع الحجم الجديد */
            transition: all 0.3s ease;
            font-family: 'Cairo', sans-serif;
        }

            .input-wrapper input:focus {
                background-color: #ffffff;
                border-color: #007c92;
                box-shadow: 0 0 0 2px rgba(0, 124, 146, 0.1); /* تقليل حجم الـ Shadow */
                outline: none;
            }

        .input-wrapper:focus-within .main-icon {
            color: #007c92;
        }

    /* رسائل الخطأ */
    .validation-message {
        font-size: 0.7rem;
        font-weight: 500;
        margin-top: 2px;
        display: block;
        min-height: 14px; /* حجز مساحة لرسالة الخطأ عشان الفورم ماتتحركش لما تظهر */
    }

    /* شبكة الأزرار عشان يكونوا جنب بعض */
    .actions-grid {
        display: flex;
        gap: 15px;
        margin-top: 10px; /* **تقليل المسافة فوق الأزرار** */
        grid-column: 1 / -1;
    }

    .btn-primary-custom, .btn-secondary-custom {
        flex: 1;
        padding: 10px; /* **تقليل البادنج الخاص بالأزرار** */
        font-size: 0.95rem; /* تصغير خط الأزرار */
        font-weight: 700;
        border-radius: 8px; /* تقليل دوران الحواف */
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #007c92 0%, #005f73 100%);
        color: white;
        border: none;
        box-shadow: 0 4px 8px rgba(0, 124, 146, 0.2); /* تقليل الظل */
    }

        .btn-primary-custom:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 10px rgba(0, 124, 146, 0.3);
            color: white;
        }

    .btn-secondary-custom {
        background: transparent;
        color: #007c92;
        border: 1.5px solid #007c92;
    }

        .btn-secondary-custom:hover {
            background: #f0f9fa;
            color: #005f73;
            border-color: #005f73;
        }

    .alert-custom {
        background-color: #fef2f2;
        border-right: 4px solid #ef4444;
        border-radius: 8px;
        padding: 8px 12px; /* تقليل البادنج */
        color: #b91c1c;
        font-size: 0.8rem;
        margin-bottom: 5px; /* تقليل المارجن */
        grid-column: 1 / -1;
    }
</style>

<div class="register-form-container">
    <form asp-action="Register" asp-route-returnUrl="@returnUrl" method="post">

        <div class="form-grid">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-custom">
                    <div asp-validation-summary="All" class="m-0 p-0" style="list-style-type: none; padding-right: 0;"></div>
                </div>
            }

            <div class="input-group-custom">
                <label asp-for="FullName">الاسم الكامل</label>
                <div class="input-wrapper">
                    <i class="fas fa-user main-icon"></i>
                    <input asp-for="FullName" placeholder="أدخل اسمك الكامل" />
                </div>
                <span asp-validation-for="FullName" class="text-danger validation-message"></span>
            </div>

            <div class="input-group-custom">
                <label asp-for="Email">البريد الإلكتروني</label>
                <div class="input-wrapper">
                    <i class="fas fa-envelope main-icon"></i>
                    <input asp-for="Email" placeholder="name@gov.eg" dir="ltr" style="text-align: left;" />
                </div>
                <span asp-validation-for="Email" class="text-danger validation-message"></span>
            </div>

            <div class="input-group-custom">
                <label asp-for="Password">كلمة المرور</label>
                <div class="input-wrapper">
                    <i class="fas fa-lock main-icon"></i>
                    <input asp-for="Password" type="password" id="PasswordInput" placeholder="••••••••" dir="ltr" style="text-align: left;" />
                    <i class="fas fa-eye toggle-password" onclick="togglePasswordVisibility('PasswordInput', this)"></i>
                </div>
                <span asp-validation-for="Password" class="text-danger validation-message"></span>
            </div>

            <div class="input-group-custom">
                <label asp-for="ConfirmPassword">تأكيد كلمة المرور</label>
                <div class="input-wrapper">
                    <i class="fas fa-lock main-icon"></i>
                    <input asp-for="ConfirmPassword" type="password" id="ConfirmPasswordInput" placeholder="••••••••" dir="ltr" style="text-align: left;" />
                    <i class="fas fa-eye toggle-password" onclick="togglePasswordVisibility('ConfirmPasswordInput', this)"></i>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger validation-message"></span>
            </div>

            <div class="actions-grid">
                <button type="submit" class="btn-primary-custom">
                    <span>إنشاء حساب</span>
                    <i class="fas fa-user-plus"></i>
                </button>

                <a asp-controller="Accounts" asp-action="Login" asp-area="Admin" asp-route-returnUrl="@returnUrl" class="btn-secondary-custom">
                    <i class="fas fa-sign-in-alt"></i>
                    <span>تسجيل الدخول</span>
                </a>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
        function togglePasswordVisibility(inputId, icon) {
        const input = document.getElementById(inputId);
        if (input.type === "password") {
        input.type = "text";
        icon.classList.remove("fa-eye");
        icon.classList.add("fa-eye-slash");
        } else {
        input.type = "password";
        icon.classList.remove("fa-eye-slash");
        icon.classList.add("fa-eye");
        }
        }
    </script>
}