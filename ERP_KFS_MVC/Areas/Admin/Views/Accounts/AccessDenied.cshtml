@{
    ViewData["Title"] = "غير مصرح لك";
    Layout = "_LoginLayout";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - نظام إدارة المحافظة</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.rtlcss.com/bootstrap/v4.6.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            font-family: 'Cairo', sans-serif !important;
            background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 50%, #0f172a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 20px;
        }

        .error-card {
            background: white;
            border-radius: 24px;
            padding: 60px 40px;
            text-align: center;
            max-width: 500px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            margin:auto;
        }

        .error-icon {
            font-size: 5rem;
            color: #dc3545;
            margin-bottom: 25px;
            width: 100px;
            height: 100px;
            background: #fef2f2;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        h1 {
            color: #1e293b;
            font-weight: 700;
            font-size: 1.8rem;
            margin-bottom: 15px;
        }

        p {
            color: #64748b;
            font-size: 1rem;
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .btn-home {
            background: linear-gradient(135deg, #007c92 0%, #005a6b 100%);
            color: white;
            border: none;
            padding: 14px 30px;
            border-radius: 12px;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s;
        }

        .btn-home:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0, 124, 146, 0.3);
            color: white;
            text-decoration: none;
        }

        .btn-login {
            background: transparent;
            color: #007c92;
            border: 2px solid #007c92;
            padding: 12px 25px;
            border-radius: 12px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-right: 15px;
            transition: all 0.3s;
        }

        .btn-login:hover {
            background: #007c92;
            color: white;
            text-decoration: none;
        }
    </style>
</head>
<body>

    <div class="error-card">
        <div class="error-icon">
            <i class="fas fa-ban"></i>
        </div>
        <h1>غير مصرح لك</h1>
        <p>عذراً، ليس لديك صلاحية للوصول إلى هذه الصفحة.<br>يرجى التواصل مع مسؤول النظام للحصول على الصلاحيات المطلوبة.</p>
        <div>
            <a asp-controller="Home" asp-action="Index" asp-area="" class="btn-home">
                <i class="fas fa-home"></i> العودة للرئيسية
            </a>
            <a asp-controller="Account" asp-action="Login" asp-area="Admin" class="btn-login">
                <i class="fas fa-sign-in-alt"></i> تسجيل الدخول
            </a>
        </div>
    </div>

</body>
</html>