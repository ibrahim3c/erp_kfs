@model Organization.Application.Dtos.LeadershipPosition.AssignPositionDto
@{
    ViewData["Title"] = "تعيين منصب قيادي";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark"><i class="fas fa-user-tie text-secondary me-2"></i> تسكين قائد على منصب قيادي</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mx-3" role="alert">
                <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
                <button type="button" class="close" data-dismiss="alert">
                    <span>&times;</span>
                </button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mx-3" role="alert">
                <i class="fas fa-exclamation-circle me-1"></i> @TempData["ErrorMessage"]
                <button type="button" class="close" data-dismiss="alert">
                    <span>&times;</span>
                </button>
            </div>
        }

        <div class="card card-outline card-primary mb-4">
            <div class="card-header">
                <h3 class="card-title">اختر القائد والمنصب</h3>
            </div>
            <div class="card-body">
                <form asp-action="AssignPosition" method="post">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-4">
                                <label asp-for="EmployeeId" class="form-label">اسم القائد</label>
                                <select asp-for="EmployeeId" class="form-control select2" asp-items="@(new SelectList(ViewBag.Employees, "Id", "Name"))">
                                    <option value="">-- ابحث واختر الموظف --</option>
                                </select>
                                <span asp-validation-for="EmployeeId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-4">
                                <label asp-for="LeadershipPositionId" class="form-label">المنصب القيادي </label>
                                <select asp-for="LeadershipPositionId" class="form-control select2" asp-items="@(new SelectList(ViewBag.Positions, "Id", "Name"))">
                                    <option value="">-- ابحث واختر المنصب --</option>
                                </select>
                                <span asp-validation-for="LeadershipPositionId" class="text-danger"></span>
                            </div>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-4">
                                <label asp-for="Notes" class="form-label">ملاحظات</label>
                                <textarea asp-for="Notes" class="form-control" rows="2"
                                          placeholder="أدخل أي ملاحظات تخص هذا التعيين (اختياري)"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mt-2">
                        <button type="submit" class="btn btn-primary px-4"><i class="fas fa-plus me-1"></i> إضافة التعيين</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card card-outline card-info">
            <div class="card-header">
                <h3 class="card-title">المناصب القيادية الحالية</h3>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-hover text-nowrap table-bordered">
                    <thead class="bg-light">
                        <tr>
                            <th>#</th>
                            <th>اسم القائد</th>
                            <th>المنصب القيادي الحالي</th>
                            <th class="text-center">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.AssignedEmployees != null && ViewBag.AssignedEmployees.Count > 0)
                        {
                            int index = 1;
                            foreach (var item in ViewBag.AssignedEmployees)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td>@item.EmployeeName</td>
                                    <td><span class="badge badge-success">@item.PositionName</span></td>
                                    <td class="text-center">
                                        <a asp-action="PositionHistory"
                                           asp-route-employeeId="@item.EmployeeId"
                                           asp-route-employeeName="@item.EmployeeName"
                                           class="btn btn-sm btn-info me-1"
                                           title="سجل المناصب">
                                            <i class="fas fa-history"></i> السجل
                                        </a>
                                        <form asp-action="RemovePosition" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="employeeId" value="@item.EmployeeId" />
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('هل أنت متأكد من إعفاء هذا الموظف من منصبه؟')">
                                                <i class="fas fa-user-minus"></i> إعفاء
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted p-4">
                                    <i class="fas fa-info-circle mb-2 text-info" style="font-size: 24px;"></i><br />
                                    <strong>لا يوجد موظفين مسكنين على مناصب قيادية حالياً.</strong><br />
                                    <small>ستبدأ القائمة بالامتلاء بمجرد إضافة وتسكين الموظفين من النموذج بالأعلى.</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            $('.select2').select2({
                // theme: 'bootstrap4', 🔴 لغينا السطر ده عشان هو سبب المشكلة واللون الأبيض
                language: "ar",
                dir: "rtl",
                width: '100%'
            });
        });
    </script>

    <style>
        .select2-container .select2-selection--single {
            height: 38px !important;
            border: 1px solid #ced4da !important; /* لون الإطار الرمادي بتاع Bootstrap */
            border-radius: .25rem !important;
            background-color: #fff !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px !important;
            top: 1px !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 36px !important;
            color: #495057 !important; /* لون النص */
            padding-right: 12px !important; /* مسافة للنص عشان الـ RTL */
        }
    </style>
}
