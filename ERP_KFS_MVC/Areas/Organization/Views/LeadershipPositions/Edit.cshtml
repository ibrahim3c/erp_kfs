@model Organization.Application.Dtos.LeadershipPosition.UpdateLeadershipPositionDto
@{
    ViewData["Title"] = "تعديل منصب قيادي";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark"><i class="fas fa-edit text-secondary me-2"></i> تعديل منصب قيادي</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-outline card-primary">
            <div class="card-header">
                <h3 class="card-title">بيانات المنصب</h3>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="OrgUnitId" class="form-label"></label>
                                <select asp-for="OrgUnitId" class="form-control" asp-items="@(new SelectList(ViewBag.OrgUnits, "Id", "Name"))">
                                    <option value="">-- اختر الوحدة التنظيمية --</option>
                                </select>
                                <span asp-validation-for="OrgUnitId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="JobTitleId" class="form-label"></label>
                                <select asp-for="JobTitleId" class="form-control" asp-items="@(new SelectList(ViewBag.JobTitles, "Id", "Name"))">
                                    <option value="">-- اختر المسمى الوظيفي --</option>
                                </select>
                                <span asp-validation-for="JobTitleId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label asp-for="Description" class="form-label"></label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> حفظ</button>
                        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> رجوع</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}