@using HR.Application.Retriement.Query.GetPendingRetirement
@model List<PendingRetirementDto>
@{
    ViewData["Title"] = "الموظفون المحالون للمعاش (الموشكون على التقاعد)";
}

<link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">

<div id="loadingOverlay" style="
    display:flex;
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:rgba(255,255,255,.8);
    z-index:99999;
    justify-content:center;
    align-items:center;">

    <div class="text-center">
        <div class="spinner-border text-primary" style="width:4rem;height:4rem;"></div>
        <div class="mt-3 fw-bold">جاري تحميل بيانات الموظفين...</div>
    </div>

</div>

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark"><i class="fas fa-hourglass-half text-warning me-2"></i> خطة الإحالة للمعاش</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">HR</a></li>
                    <li class="breadcrumb-item active">المعاشات</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        <div class="card bg-gradient-navy">
            <div class="card-body">
                <div class="row align-items-end">
                    <div class="col-md-3">
                        <label class="mb-1 text-light">استعرض الخروج للمعاش لعام:</label>
                        <form asp-action="Pending" method="get" id="yearForm">
                            <select name="year" class="form-control form-control-sm font-weight-bold" onchange="submitYearForm()">
                                @{
                                    var selectedYear = Context.Request.Query["year"].FirstOrDefault() ?? DateTime.Now.Year.ToString();
                                }
                                @for (int y = DateTime.Now.Year - 2; y <= DateTime.Now.Year + 2; y++)
                                {
                                    <option value="@y" selected="@(y.ToString() == selectedYear)">@y</option>
                                }
                            </select>
                        </form>
                    </div>
                    <div class="col-md-9 text-light">
                        <i class="fas fa-info-circle ms-2"></i> يعرض هذا التقرير أسماء الموظفين الذين سيتمون سن الستين خلال العام المحدد، للبدء في إجراءات تسوية مستحقاتهم وتجهيز البديل.
                    </div>
                </div>
            </div>
        </div>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                <i class="fas fa-exclamation-circle me-1"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card card-outline card-warning">
            <div class="card-header border-0">
                <h3 class="card-title text-bold">قائمة الموظفين (سن 60) - العام المحدد</h3>
            </div>
            <div class="card-body p-0">
                <table id="retirementTable" class="table table-hover table-striped text-center align-middle">
                    <thead class="bg-secondary text-white">
                        <tr>
                            <th>م</th>
                            <th>الموظف</th>
                            <th>الوظيفة الحالية</th>
                            <th>تاريخ الميلاد</th>
                            <th>تاريخ الخروج (يتم الستين)</th>
                            <th>المدة المتبقية</th>
                            <th>حالة الملف</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 1;
                        }
                        @foreach (var emp in Model)
                        {
                            var remainingDays = (emp.RetirementDate - DateTime.Now).TotalDays;
                            var isUrgent = remainingDays <= 30;

                            var statusText = emp.FileStatus switch
                            {
                                null => "لم يبدأ",
                                "PendingReview" => "جاري تجهيز الملف",
                                "UnderFinancialReview" => "تحت المراجعة المالية",
                                "AwaitingSignatures" => "في انتظار التوقيعات",
                                "DeliveredToAuthority" => "تم التسليم",
                                "Rejected" => "مرتد",
                                _ => emp.FileStatus
                            };
                            var statusClass = emp.FileStatus switch
                            {
                                null => "bg-secondary",
                                "DeliveredToAuthority" => "bg-success",
                                "Rejected" => "bg-danger",
                                _ => "bg-warning text-dark"
                            };

                            <tr class="@(isUrgent ? "bg-white" : "")" style="@(isUrgent ? "border-left: 5px solid #dc3545;" : "")">
                                <td>@i</td>
                                <td class="text-end fw-bold">@emp.EmployeeName</td>
                                <td>@emp.JobTitle</td>
                                <td>@emp.DateOfBirth.ToString("dd/MM/yyyy")</td>
                                <td class="@(isUrgent ? "text-danger fw-bold" : "text-primary fw-bold")">@emp.RetirementDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (remainingDays <= 30)
                                    {
                                        <span class="badge bg-danger p-2">أقل من شهر</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info p-2">@((int)(remainingDays / 30)) شهور</span>
                                    }
                                </td>
                                <td><span class="badge @statusClass">@statusText</span></td>
                                <td>
                                    @if (emp.RetirementFileId is null)
                                    {
                                        <form asp-action="CreateFile"
                                              asp-controller="Retirement"
                                              asp-area="HR"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="employeeId" value="@emp.EmployeeId" />
                                            <input type="hidden" name="referralDate" value="@emp.RetirementDate.ToString("yyyy-MM-dd")" />

                                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-plus me-1"></i>
                                                بدء الملف
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-action="Files" class="btn btn-sm btn-outline-dark">
                                            <i class="fas fa-tasks me-1"></i> متابعة الإجراءات
                                        </a>
                                    }
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>


<!-- Script منفصل لإخفاء الـ Overlay - بدون أي اعتماد على jQuery أو DataTables -->
<script>
    (function() {
        function hideOverlay() {
            var overlay = document.getElementById("loadingOverlay");
            if (overlay) overlay.style.display = "none";
        }
        // نخفيه أول ما الـ DOM يخلص تحميل، مش لازم ننتظر كل الـ resources (صور، خطوط..)
        if (document.readyState === "complete" || document.readyState === "interactive") {
            hideOverlay();
        } else {
            document.addEventListener("DOMContentLoaded", hideOverlay);
        }
        // شبكة أمان: لو لأي سبب فشل الأول، اخفيه على أي حال بعد ثانيتين
        setTimeout(hideOverlay, 2000);
    })();
</script>

<script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="~/plugins/sweetalert2/sweetalert2.min.js"></script>

<script>
    $(function() {
        try {
            $("#retirementTable").DataTable({
                "lengthChange": false,
                "autoWidth": false,
                "language": { "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Arabic.json" }
            });
        } catch (e) {
            console.error("DataTable init error:", e);
        }
    });

    function submitYearForm() {
        document.getElementById("loadingOverlay").style.display = "flex";
        setTimeout(function() {
            document.getElementById("yearForm").submit();
        }, 300);
    }
</script>