@using HR.Application.Secondments.Query.GetActiveSecondments
@model List<SecondmentListItemDto>
@{
    ViewData["Title"] = "الندب والإعارات (Secondments & Loans)";
}

<link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-briefcase text-primary me-2"></i> سجل الندب والإعارات
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">HR</a></li>
                    <li class="breadcrumb-item active">الإعارات</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-1"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @{
            var expiringSoonCount = Model.Count(s => s.Status == "Active" && (s.EndDate - DateTime.Now).TotalDays <= 30);
        }
        @if (expiringSoonCount > 0)
        {
            <div class="callout callout-danger">
                <h5><i class="fas fa-bell text-danger me-2"></i> تنبيهات تجديد الندب:</h5>
                <p>يوجد عدد <b>(@expiringSoonCount)</b> موظفين تنتهي فترة ندبهم خلال 30 يوم، يرجى مراجعة الموافقة على التجديد أو إنهاء الندب.</p>
            </div>
        }

        <div class="card card-outline card-primary">
            <div class="card-header border-0">
                <h3 class="card-title text-bold">قائمة المنتدبين والمعارين حالياً</h3>
                <div class="card-tools">
                    <a asp-action="Create" class="btn btn-primary btn-sm">
                        <i class="fas fa-plane-departure me-1"></i> تسجيل إعارة / ندب جديد
                    </a>
                </div>
            </div>

            <div class="card-body">
                <table id="loanTable" class="table table-bordered table-striped table-hover text-center align-middle">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>م</th>
                            <th>الموظف</th>
                            <th>نوع الحركة</th>
                            <th>الجهة الخارجية</th>
                            <th>تاريخ البدء</th>
                            <th>تاريخ الانتهاء</th>
                            <th>حالة الراتب</th>
                            <th>الحالة</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 1; }
                        @foreach (var s in Model)
                        {
                            var typeText = s.Type == "Internal" ? "ندب داخلي" : "إعارة خارجية";
                            var typeClass = s.Type == "Internal" ? "bg-info text-dark" : "bg-purple";

                            var salaryText = s.SalaryBearer switch
                            {
                                "OriginalEntity" => "علينا (بالكامل)",
                                "HostEntity" => "على الجهة المستعيرة",
                                "Unpaid" => "بدون أجر",
                                _ => s.SalaryBearer
                            };

                            var isExpiringSoon = s.Status == "Active" && (s.EndDate - DateTime.Now).TotalDays <= 30;

                            <tr class="@(isExpiringSoon ? "table-danger" : "")">
                                <td>@i</td>
                                <td class="text-end fw-bold">@s.EmployeeName</td>
                                <td><span class="badge @typeClass">@typeText</span></td>
                                <td>@s.HostEntityName</td>
                                <td>@s.StartDate.ToString("dd/MM/yyyy")</td>
                                <td class="@(isExpiringSoon ? "text-danger fw-bold" : "")">@s.EndDate.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-light text-dark border">@salaryText</span></td>
                                <td>
                                    @if (s.Status == "Active")
                                    {
                                        <span class="badge bg-success">فعّال</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@s.Status</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-default btn-sm border" title="التفاصيل">
                                            <i class="fas fa-eye text-primary"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>

<script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>

<script>
    $(function () {
        $("#loanTable").DataTable({
            "language": { "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Arabic.json" },
            "autoWidth": false
        });
    });
</script>