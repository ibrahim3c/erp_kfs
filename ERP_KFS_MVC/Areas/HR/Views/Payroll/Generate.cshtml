@model HR.Application.Payrolls.GetPayrollCycle.GetPayrollCycleResponse
@{
    ViewData["Title"] = "مسير الرواتب والأجور";
    int selectedMonth = (int)ViewBag.SelectedMonth;
    int selectedYear = (int)ViewBag.SelectedYear;

    var monthNames = new[] {
        "", "يناير","فبراير","مارس","أبريل","مايو","يونيو",
        "يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر"
    };

    bool hasCycle = Model is not null;
    bool isLocked = hasCycle && Model!.Status == "Locked";
    string statusBadge = !hasCycle ? "badge bg-secondary"
                       : isLocked ? "badge bg-danger"
                       : "badge bg-warning text-dark";
    string statusText = !hasCycle ? "لا يوجد مسير"
                       : isLocked ? "مقفل"
                       : "قيد المراجعة";
}

<!-- Styles -->
<link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
<link rel="stylesheet" href="~/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

@if (TempData["SuccessMessage"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show mx-3" role="alert">
        <i class="fas fa-check-circle me-2"></i> @successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show mx-3" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @errorMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-file-invoice-dollar text-success me-2"></i>
                    مسير الرواتب الشهري
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">الموارد البشرية</a></li>
                    <li class="breadcrumb-item active">الرواتب</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        <!-- ══════════════════════════════════════════════ -->
        <!-- 1. لوحة التشغيل                                -->
        <!-- ══════════════════════════════════════════════ -->
        <div class="card card-outline card-success">
            <div class="card-header">
                <h3 class="card-title text-bold">إعداد وحساب الدورة المستندية</h3>
            </div>
            <div class="card-body bg-light">

                <!-- فورم GET — فلتر الشهر والسنة -->
                <form method="get" asp-action="Generate" id="filterForm" class="mb-3">
                    <div class="row align-items-end g-2">
                        <div class="col-md-2">
                            <label class="form-label">الشهر</label>
                            <select name="month" class="form-select fw-bold">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m" selected="@(m == selectedMonth)">
                                        @monthNames[m]
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">السنة</label>
                            <input type="number" name="year" class="form-control fw-bold"
                                   value="@selectedYear" min="2020" max="2099">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label d-block">&nbsp;</label>
                            <button type="submit" class="btn btn-outline-primary w-100">
                                <i class="fas fa-search"></i> عرض
                            </button>
                        </div>
                    </div>
                </form>

                <!-- فورم POST — حساب الرواتب + الأزرار كلها في صف واحد -->
                <form method="post" asp-action="CalculateCycle" id="calcForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="month" value="@selectedMonth">
                    <input type="hidden" name="year" value="@selectedYear">

                    <div class="row align-items-end g-2">

                        <!-- نوع الكادر -->
                        <div class="col-md-3">
                            <label class="form-label">نوع الكادر</label>
                            <select name="employmentTypeId"
                                    class="form-select"
                                    asp-items="ViewBag.EmploymentTypeId">
                                <option value="">-- الكل --</option>
                            </select>
                        </div>

                        <!-- الأزرار -->
                        <div class="col-md-9">
                            <label class="form-label d-block">&nbsp;</label>
                            <div class="d-flex gap-2 flex-wrap">

                                <!-- حساب الرواتب -->
                                <button type="button" onclick="confirmCalculate()"
                                        class="btn btn-success shadow-sm"
                                    @(isLocked ? "disabled" : "")>
                                    <i class="fas fa-calculator me-1"></i> حساب الرواتب
                                </button>

                                <!-- إقفال الشهر -->
                                @if (hasCycle && !isLocked)
                                {
                                    <button type="button" onclick="confirmLock()"
                                            class="btn btn-danger shadow-sm"
                                            id="btnLock">
                                        <i class="fas fa-lock me-1"></i> إقفال الشهر
                                    </button>
                                }

                                <!-- إرسال مفردات -->
                                <button type="button"
                                        class="btn btn-secondary shadow-sm"
                                    @(!hasCycle ? "disabled" : "")>
                                    <i class="fas fa-envelope me-1"></i> إرسال مفردات
                                </button>

                            </div>
                        </div>
                    </div>
                </form>

                <!-- فورم إقفال منفصل (POST) -->
                @if (hasCycle && !isLocked)
                {
                    <form method="post" asp-action="LockCycle" id="lockForm" class="d-none">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="cycleId" value="@Model!.CycleId">
                        <input type="hidden" name="month" value="@selectedMonth">
                        <input type="hidden" name="year" value="@selectedYear">
                    </form>
                }

            </div>
        </div>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 2. ملخص الأرقام                                -->
        <!-- ══════════════════════════════════════════════ -->
        <div class="row">
            <div class="col-12 col-sm-6 col-md-3">
                <div class="info-box">
                    <span class="info-box-icon bg-info elevation-1"><i class="fas fa-users"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">عدد الموظفين</span>
                        <span class="info-box-number">
                            @(hasCycle ? Model!.EmployeeCount.ToString() : "—")
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <div class="info-box">
                    <span class="info-box-icon bg-warning elevation-1">
                        <i class="fas fa-minus-circle text-white"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">إجمالي الاستقطاعات</span>
                        <span class="info-box-number">
                            @(hasCycle ? Model!.TotalDeductions.ToString("N0") + " جم" : "—")
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <div class="info-box mb-3">
                    <span class="info-box-icon bg-success elevation-1">
                        <i class="fas fa-money-bill-wave"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">صافي مستحق للصرف</span>
                        <span class="info-box-number text-success" style="font-size:1.2rem">
                            @(hasCycle ? Model!.TotalNetSalary.ToString("N0") + " جم" : "—")
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <div class="info-box mb-3">
                    <span class="info-box-icon bg-purple elevation-1">
                        <i class="fas fa-check-double"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">حالة المسير</span>
                        <span class="info-box-number">
                            <span class="@statusBadge">@statusText</span>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 3. جدول المرتبات                               -->
        <!-- ══════════════════════════════════════════════ -->
        @if (!hasCycle)
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                لا يوجد مسير محسوب لشهر <strong>@monthNames[selectedMonth] @selectedYear</strong>.
                اضغط <strong>حساب الرواتب</strong> لبدء الدورة.
            </div>
        }
        else
        {
            <div class="card card-outline card-secondary">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-list me-1"></i>
                        كشف استحقاقات — @monthNames[selectedMonth] @selectedYear
                    </h3>
                    <div class="card-tools">
                        <button class="btn btn-sm btn-outline-success">
                            <i class="fas fa-file-excel"></i> تصدير للبنك
                        </button>
                        <button class="btn btn-sm btn-outline-dark">
                            <i class="fas fa-print"></i> كشف التوقيع
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <table id="payrollTable"
                           class="table table-bordered table-hover text-center table-striped"
                           style="font-size:0.9rem">
                        <thead class="bg-dark text-white">
                            <tr>
                                <th>م</th>
                                <th>الاسم</th>
                                <th>الأجر الوظيفي</th>
                                <th>الحوافز (مكمل)</th>
                                <th>بدلات / مكافآت</th>
                                <th>إجمالي الاستحقاق</th>
                                <th class="bg-danger">الاستقطاعات</th>
                                <th class="bg-success">صافي الراتب</th>
                                <th>إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNum = 1;
                            }
                            @foreach (var entry in Model!.Entries)
                            {
                                <tr>
                                    <td>@(rowNum++)</td>
                                    <td class="text-end fw-bold">@entry.EmployeeName</td>
                                    <td class="fw-bold">@entry.BasicSalary.ToString("N0")</td>
                                    <td>@entry.Incentives.ToString("N0")</td>
                                    <td>@entry.Allowances.ToString("N0")</td>
                                    <td class="text-primary fw-bold">@entry.GrossSalary.ToString("N0")</td>
                                    <td class="text-danger fw-bold">
                                        @entry.TotalDeductions.ToString("N0")
                                        <br>
                                        <small class="text-muted" style="font-size:0.75rem">
                                            @(entry.HasPenalty == 1
                                                ? $"(شامل {entry.PenaltyDeduction:N0} جنيه جزاءات)"
                                                : "(تأمينات + ضرائب)")
                                        </small>
                                    </td>
                                    <td class="bg-gradient-success fw-bold text-lg">
                                        @entry.NetSalary.ToString("N0")
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <a asp-action="Payslip"
                                               asp-route-entryId="@entry.EntryId"
                                               class="btn btn-sm btn-info"
                                               title="مفردات مرتب">
                                                <i class="fas fa-file-invoice"></i>
                                            </a>
                                            @if (!isLocked)
                                            {
                                                <button class="btn btn-sm btn-warning"
                                                        onclick="openAdjustModal('@entry.EntryId')"
                                                        title="تسوية يدوية">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-light fw-bold">
                            <tr>
                                <td colspan="5" class="text-end">الإجمالي</td>
                                <td class="text-primary">
                                    @Model.Entries.Sum(e => e.GrossSalary).ToString("N0")
                                </td>
                                <td class="text-danger">
                                    @Model.TotalDeductions.ToString("N0")
                                </td>
                                <td class="text-success">
                                    @Model.TotalNetSalary.ToString("N0")
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }

    </div>
</section>

<!-- Modal: التسوية اليدوية -->
<div class="modal fade" id="adjustModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">
                    <i class="fas fa-sliders-h me-2"></i> تسوية يدوية (إضافة / خصم)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="AddAdjustment" id="adjustForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="entryId" id="adjustEntryId">
                <input type="hidden" name="month" value="@selectedMonth">
                <input type="hidden" name="year" value="@selectedYear">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">نوع التسوية</label>
                        <select name="adjType" class="form-select">
                            <option value="plus">إضافة مبلغ (مكافأة بأثر رجعي)</option>
                            <option value="minus">خصم مبلغ (غرامة / سلفة)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">المبلغ</label>
                        <input type="number" name="amount" class="form-control fw-bold"
                               placeholder="0.00" step="0.01" min="0.01" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">السبب / الملاحظات</label>
                        <textarea name="reason" class="form-control" rows="2" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> تحديث صافي الراتب
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Scripts -->
<script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="~/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
<script src="~/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
<script src="~/plugins/datatables-buttons/js/buttons.print.min.js"></script>
<script src="~/plugins/jszip/jszip.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>

<script>
    $(function () {
    @if (hasCycle)
    {
        <text>
            $("#payrollTable").DataTable({
            language: { url: "//cdn.datatables.net/plug-ins/1.10.25/i18n/Arabic.json" },
            responsive: true,
            lengthChange: true,
            autoWidth: false,
            order: [],
            buttons: [
            { extend: 'excel', text: '<i class="fas fa-file-excel"></i> Excel', className: 'btn-success btn-sm' },
            { extend: 'print', text: '<i class="fas fa-print"></i> طباعة', className: 'btn-dark btn-sm' }
            ]
            }).buttons().container().appendTo('#payrollTable_wrapper .col-md-6:eq(0)');
        </text>
    }
    });

    function openAdjustModal(entryId) {
    document.getElementById('adjustEntryId').value = entryId;
    new bootstrap.Modal(document.getElementById('adjustModal')).show();
    }

    function confirmCalculate() {
    Swal.fire({
    title: 'تأكيد حساب الرواتب',
    html: 'سيتم حساب رواتب شهر <b>@monthNames[selectedMonth] @selectedYear</b>.<br>هل تريد المتابعة؟',
    icon: 'question',
    showCancelButton: true,
    confirmButtonText: 'نعم، احسب',
    cancelButtonText: 'إلغاء',
    confirmButtonColor: '#28a745',
    }).then(result => {
    if (!result.isConfirmed) return;
    Swal.fire({
    title: 'جاري الحساب...',
    html: 'يتم احتساب الجزاءات، الأذونات، والتأمينات الاجتماعية.',
    allowOutsideClick: false,
    allowEscapeKey: false,
    didOpen: () => {
    Swal.showLoading();
    setTimeout(() => document.getElementById('calcForm').submit(), 300);
    }
    });
    });
    }

    function confirmLock() {
    Swal.fire({
    title: 'تأكيد إقفال المسير',
    html: 'بعد الإقفال <b>لن تتمكن</b> من تعديل أي بيانات لهذا الشهر.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'نعم، أقفل',
    cancelButtonText: 'إلغاء',
    confirmButtonColor: '#dc3545',
    }).then(result => {
    if (result.isConfirmed)
    document.getElementById('lockForm').submit();
    });
    }
</script>