@model HR.Application.Payrolls.GetPayslip.PayslipResponse
@{
    ViewData["Title"] = "مفردات مرتب";
    var monthNames = new[] {
        "", "يناير","فبراير","مارس","أبريل","مايو","يونيو",
        "يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر"
    };
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-file-invoice text-info me-2"></i> مفردات مرتب
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-action="Generate">الرواتب</a></li>
                    <li class="breadcrumb-item active">مفردات مرتب</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-outline card-info" id="payslipCard">
            <div class="card-header bg-dark text-white text-center py-3">
                <h4 class="mb-0">
                    <i class="fas fa-file-invoice-dollar me-2"></i>
                    مفردات مرتب شهر @monthNames[Model.Month] @Model.Year
                </h4>
            </div>
            <div class="card-body">

                <!-- بيانات الموظف -->
                <div class="row mb-4 p-3 bg-light rounded">
                    <div class="col-md-4">
                        <strong>الاسم:</strong> @Model.EmployeeName
                    </div>
                    <div class="col-md-4">
                        <strong>الكود:</strong> @Model.EmployeeCode
                    </div>
                    <div class="col-md-4">
                        <strong>الوظيفة:</strong> @Model.JobTitle
                    </div>
                    <div class="col-md-4 mt-2">
                        <strong>البنك:</strong> @Model.BankName
                    </div>
                    <div class="col-md-4 mt-2">
                        <strong>رقم الحساب:</strong> @Model.BankAccount
                    </div>
                </div>

                <div class="row">
                    <!-- الاستحقاقات -->
                    <div class="col-md-6">
                        <table class="table table-bordered text-center">
                            <thead class="bg-success text-white">
                                <tr><th colspan="2">الاستحقاقات</th></tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>الأجر الوظيفي</td>
                                    <td class="fw-bold">@Model.BasicSalary.ToString("N2") جم</td>
                                </tr>
                                <tr>
                                    <td>الحوافز (مكمل)</td>
                                    <td>@Model.Incentives.ToString("N2") جم</td>
                                </tr>
                                <tr>
                                    <td>البدلات</td>
                                    <td>@Model.Allowances.ToString("N2") جم</td>
                                </tr>
                                @if (Model.ManualAdditions > 0)
                                {
                                    <tr class="table-success">
                                        <td>إضافات يدوية</td>
                                        <td>@Model.ManualAdditions.ToString("N2") جم</td>
                                    </tr>
                                }
                                <tr class="bg-success text-white fw-bold">
                                    <td>إجمالي الاستحقاق</td>
                                    <td>@Model.GrossSalary.ToString("N2") جم</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- الاستقطاعات -->
                    <div class="col-md-6">
                        <table class="table table-bordered text-center">
                            <thead class="bg-danger text-white">
                                <tr><th colspan="2">الاستقطاعات</th></tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>التأمينات الاجتماعية</td>
                                    <td>@Model.InsuranceDeduction.ToString("N2") جم</td>
                                </tr>
                                <tr>
                                    <td>ضريبة الدخل</td>
                                    <td>@Model.TaxDeduction.ToString("N2") جم</td>
                                </tr>
                                @if (Model.LoanDeduction > 0)
                                {
                                    <tr>
                                        <td>قسط السلفة</td>
                                        <td>@Model.LoanDeduction.ToString("N2") جم</td>
                                    </tr>
                                }
                                @if (Model.InsurancePurchaseDeduction > 0)
                                {
                                    <tr>
                                        <td>قسط شراء المدة</td>
                                        <td>@Model.InsurancePurchaseDeduction.ToString("N2") جم</td>
                                    </tr>
                                }
                                @if (Model.PenaltyDeduction > 0)
                                {
                                    <tr class="table-danger">
                                        <td>جزاءات</td>
                                        <td>@Model.PenaltyDeduction.ToString("N2") جم</td>
                                    </tr>
                                }
                                @if (Model.ManualDeductions > 0)
                                {
                                    <tr class="table-warning">
                                        <td>خصومات يدوية</td>
                                        <td>@Model.ManualDeductions.ToString("N2") جم</td>
                                    </tr>
                                }
                                <tr class="bg-danger text-white fw-bold">
                                    <td>إجمالي الاستقطاعات</td>
                                    <td>@Model.TotalDeductions.ToString("N2") جم</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- صافي الراتب -->
                <div class="row mt-2">
                    <div class="col-12">
                        <div class="alert alert-success text-center fs-5 fw-bold">
                            <i class="fas fa-money-bill-wave me-2"></i>
                            صافي الراتب المستحق:
                            <span class="fs-4">@Model.NetSalary.ToString("N2") جنيه</span>
                        </div>
                    </div>
                </div>

            </div>
            <div class="card-footer text-end">
                <button onclick="window.print()" class="btn btn-dark">
                    <i class="fas fa-print me-1"></i> طباعة
                </button>
                <a asp-action="Generate" class="btn btn-secondary">
                    <i class="fas fa-arrow-right me-1"></i> رجوع
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    @@media print {
        .content-header, .main-header, .main-sidebar,
        .card-footer, .breadcrumb {
            display: none !important;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }
    }
</style>