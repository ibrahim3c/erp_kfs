@using HR.Application.Secondments.Query.GetEmployeesForSelect
@using HR.Application.ServiceTerms.Query.GetServiceTerms
@model List<ServiceTermListItemDto>
@{
    ViewData["Title"] = "ضم مدد الخدمة السابقة";
    var employees = ViewBag.Employees as List<EmployeeSelectDto> ?? new();
}

<link rel="stylesheet" href="~/css/global/hr-custom.css" asp-append-version="true">

<div class="hr-page-container animate__animated animate__fadeIn">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h5 font-weight-bold text-dark mb-1">تسجيل مدد الخدمة السابقة</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent p-0 small mb-0">
                    <li class="breadcrumb-item"><a href="#">التعيينات</a></li>
                    <li class="breadcrumb-item active" aria-current="page">ضم الخدمة</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <button class="hr-btn hr-btn-outline" data-bs-toggle="collapse" href="#newRequestCollapse">
                <i class="fas fa-plus"></i> تسجيل طلب جديد
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-1"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- نموذج طلب جديد -->
    <div class="collapse mb-4" id="newRequestCollapse">
        <div class="hr-card shadow-sm border-primary" style="border-top: 3px solid var(--hr-primary) !important;">
            <div class="hr-card-header">
                <h3 class="hr-card-title"><i class="fas fa-plus-circle"></i> إضافة طلب ضم مدة جديد</h3>
            </div>
            <div class="hr-filter-section bg-white p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-4 hr-form-group">
                            <label>اسم الموظف</label>
                            <select class="form-select hr-form-control" name="employeeId" required>
                                <option value="">-- ابحث بالاسم او الكود --</option>
                                @foreach (var emp in ViewBag.Employees)
                                {
                                    <option value="@emp.Id">@emp.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 hr-form-group">
                            <label>الجهة السابقة</label>
                            <input type="text" class="form-control hr-form-control" name="previousEntityName" placeholder="مكان العمل السابق..." required>
                        </div>
                        <div class="col-md-4 hr-form-group">
                            <label>نوع المدة</label>
                            <select class="form-select hr-form-control" name="type" required>
                                <option value="Government">مدة حكومية (ضم كامل)</option>
                                <option value="PrivateSector">قطاع خاص (خاضع للتأمينات)</option>
                                <option value="Conscription">مدة تجنيد / خدمة عامة</option>
                            </select>
                        </div>

                        <div class="col-md-3 hr-form-group">
                            <label>تاريخ بداية المدة</label>
                            <input type="date" class="form-control hr-form-control" name="startDate" id="startDate" onchange="calculatePeriod()" required>
                        </div>
                        <div class="col-md-3 hr-form-group">
                            <label>تاريخ نهاية المدة</label>
                            <input type="date" class="form-control hr-form-control" name="endDate" id="endDate" onchange="calculatePeriod()" required>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="hr-form-label text-primary">صافي المدة المحسوبة (تقديري):</label>
                            <div class="d-flex gap-2 bg-light p-3 rounded-3 border">
                                <input type="number" readonly class="form-control hr-form-control text-center bg-white" id="calcYear" placeholder="سنة">
                                <input type="number" readonly class="form-control hr-form-control text-center bg-white" id="calcMonth" placeholder="شهر">
                                <input type="number" readonly class="form-control hr-form-control text-center bg-white" id="calcDay" placeholder="يوم">
                            </div>
                            <small class="text-muted">القيمة النهائية بتتحسب في السيرفر بدقة وقت الحفظ.</small>
                        </div>

                        <div class="col-md-6 hr-form-group">
                            <label>المستندات المؤيدة (PDF أو صورة)</label>
                            <input type="file" class="form-control hr-form-control" name="attachmentFile" accept=".pdf,.jpg,.jpeg,.png">
                        </div>
                        <div class="col-md-6 hr-form-group">
                            <label>رقم قرار اللجنة (إن وجد)</label>
                            <input type="text" class="form-control hr-form-control" name="committeeDecisionNumber" placeholder="أدخل رقم القرار...">
                        </div>
                    </div>
                    <div class="d-flex justify-content-end mt-3 gap-2 border-top pt-3">
                        <button type="button" class="hr-btn hr-btn-outline" data-bs-toggle="collapse" href="#newRequestCollapse">إلغاء</button>
                        <button type="submit" class="hr-btn hr-btn-primary px-5"><i class="fas fa-save"></i> حفظ وتفعيل الطلب</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- جدول السجلات -->
    <div class="hr-card">
        <div class="hr-card-header">
            <h3 class="hr-card-title"><i class="fas fa-history"></i> سجل المدد المضمومة (History)</h3>
        </div>

        <div class="hr-table-wrapper">
            <table id="serviceTable" class="hr-table table-hover">
                <thead>
                    <tr>
                        <th style="width: 50px">#</th>
                        <th>الموظف</th>
                        <th>الجهة السابقة</th>
                        <th>من تاريخ</th>
                        <th>إلى تاريخ</th>
                        <th>صافي المدة</th>
                        <th>الحالة</th>
                        <th>الأقدمية المعدلة</th>
                        <th style="width: 150px">خيارات</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                    }
                    @foreach (var s in Model)
                    {
                        var duration = s.EndDate - s.StartDate;
                        var years = duration.Days / 365;
                        var months = (duration.Days % 365) / 30;

                        var statusBadge = s.Status switch
                        {
                            "Approved" => ("hr-badge-success", "تم الضم"),
                            "Rejected" => ("hr-badge-danger", "مرفوض"),
                            _ => ("hr-badge-warning text-warning", "تحت المراجعة")
                        };

                        <tr>
                            <td>@i</td>
                            <td class="font-weight-bold">@s.EmployeeName</td>
                            <td>@s.PreviousEntityName</td>
                            <td>@s.StartDate.ToString("dd-MM-yyyy")</td>
                            <td>@s.EndDate.ToString("dd-MM-yyyy")</td>
                            <td><span class="hr-badge hr-badge-secondary">@years سنة @months شهر</span></td>
                            <td><span class="hr-badge @statusBadge.Item1">@statusBadge.Item2</span></td>
                            <td class="text-success font-weight-bold">
                                @(s.AdjustedSeniorityDate?.ToString("dd-MM-yyyy") ?? "-")
                            </td>
                            <td>
                                @if (s.Status == "UnderReview")
                                {
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-light btn-sm rounded-3 border" data-bs-toggle="dropdown">
                                            <i class="fas fa-ellipsis-h text-muted"></i>
                                        </button>
                                        <ul class="dropdown-menu shadow border-0 p-2">
                                            <li>
                                                <a class="dropdown-item rounded-2" asp-action="Details" asp-route-id="@s.Id">
                                                    <i class="fas fa-eye text-primary me-2"></i> عرض التفاصيل والمستند
                                                </a>
                                            </li>
                                            <li>
                                                <form asp-action="Approve" method="post" onsubmit="return confirm('تأكيد اعتماد ضم هذه المدة؟');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="serviceTermId" value="@s.Id" />
                                                    <button type="submit" class="dropdown-item rounded-2 border-0 bg-transparent w-100 text-start">
                                                        <i class="fas fa-check text-success me-2"></i> اعتماد الضم
                                                    </button>
                                                </form>
                                            </li>
                                            <li>
                                                <a class="dropdown-item rounded-2 text-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@s.Id">
                                                    <i class="fas fa-times me-2"></i> رفض الطلب
                                                </a>
                                            </li>
                                             <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form asp-action="Delete" method="post" onsubmit="return confirm('تحذير: سيتم حذف السجل نهائيًا ولا يمكن التراجع. هل أنت متأكد؟');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="serviceTermId" value="@s.Id" />
                                                    <button type="submit" class="dropdown-item rounded-2 border-0 bg-transparent w-100 text-start text-danger">
                                                        <i class="fas fa-trash me-2"></i> حذف السجل
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>

                                    <!-- Modal بسيط لسبب الرفض - Form عادي، مش Ajax -->
                                    <div class="modal fade" id="rejectModal-@s.Id" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <form asp-action="Reject" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="serviceTermId" value="@s.Id" />
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">سبب رفض الطلب</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <textarea class="form-control" name="reason" rows="3" required placeholder="اكتب سبب الرفض..."></textarea>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                                                        <button type="submit" class="btn btn-danger">تأكيد الرفض</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                   <div class="btn-group">
            <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-light btn-sm rounded-3 border" title="عرض التفاصيل">
                <i class="fas fa-eye text-primary"></i>
            </a>
            <button type="button" class="btn btn-light btn-sm rounded-3 border" data-bs-toggle="dropdown" title="خيارات">
                <i class="fas fa-ellipsis-h text-muted"></i>
            </button>
            <ul class="dropdown-menu shadow border-0 p-2">
                <li>
                    <form asp-action="Delete" method="post" onsubmit="return confirm('تحذير: سيتم حذف السجل نهائيًا ولا يمكن التراجع. هل أنت متأكد؟');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="serviceTermId" value="@s.Id" />
                        <button type="submit" class="dropdown-item rounded-2 border-0 bg-transparent w-100 text-start text-danger">
                            <i class="fas fa-trash me-2"></i> حذف السجل
                        </button>
                    </form>
                </li>
            </ul>
        </div>
                                }
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        $('#serviceTable').DataTable({
            "language": {
                "emptyTable": "لا توجد بيانات متاحة في الجدول",
                "info": "سجل _START_ - _END_ من _TOTAL_",
                "infoEmpty": "سجل 0 - 0 من 0",
                "lengthMenu": "عرض _MENU_",
                "search": "",
                "searchPlaceholder": "بحث في السجل...",
                "paginate": { "first": "الأول", "last": "الأخير", "next": "التالي", "previous": "السابق" }
            },
            "dom": '<"hr-dt-top p-3 border-bottom w-100"B><"hr-dt-bottom p-3 d-flex align-items-center justify-content-between w-100"lf>rt<"p-3 d-flex flex-column align-items-center gap-2 w-100"pi>',
            "buttons": []
        });
    });

    function calculatePeriod() {
        var start = document.getElementById("startDate").value;
        var end = document.getElementById("endDate").value;

        if (start && end) {
            var date1 = new Date(start);
            var date2 = new Date(end);
            var diff = date2.getTime() - date1.getTime();

            if (diff < 0) {
                alert("تاريخ النهاية يجب أن يكون بعد البداية");
                return;
            }

            var dayCount = diff / (1000 * 3600 * 24);
            var years = Math.floor(dayCount / 365);
            var remainingDays = dayCount % 365;
            var months = Math.floor(remainingDays / 30);
            var days = Math.floor(remainingDays % 30);

            document.getElementById("calcYear").value = years;
            document.getElementById("calcMonth").value = months;
            document.getElementById("calcDay").value = days;
        }
    }
</script>