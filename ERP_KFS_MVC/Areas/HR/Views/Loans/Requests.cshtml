@model HR.Application.Loans.LoanRequestsViewModel
@{
    ViewData["Title"] = "إدارة السلف وشراء المدد";
}

<link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
<link rel="stylesheet" href="~/plugins/select2/css/select2.min.css">
<link rel="stylesheet" href="~/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css">

<style>
    .info-box {
        border-radius: 12px;
        overflow: hidden;
    }

    .info-box-icon {
        border-radius: 0;
    }

    .card-tabs .nav-tabs .nav-link {
        border-radius: 0;
        font-weight: 600;
        padding: 12px 20px;
    }

        .card-tabs .nav-tabs .nav-link.active {
            background: #fff;
            color: #007bff;
            border-bottom: 3px solid #007bff;
        }

    .badge {
        font-size: 0.8rem;
        padding: 5px 10px;
        border-radius: 20px;
    }

    table thead th {
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 0.3px;
    }

    .btn-sm {
        border-radius: 6px;
        font-size: 0.8rem;
    }

    .empty-state {
        padding: 40px 20px;
    }

        .empty-state i {
            font-size: 48px;
            opacity: 0.3;
        }
</style>

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-hand-holding-usd text-success me-2"></i> السلف وشراء المدد
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">HR</a></li>
                    <li class="breadcrumb-item active">الاستقطاعات</li>
                </ol>
            </div>
        </div>
    </div>
</div>

@* ── Alerts ── *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mx-3">
        <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mx-3">
        <i class="fas fa-exclamation-circle me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section class="content">
    <div class="container-fluid">

        @* ── Summary Cards ── *@
        @{
            var totalLoans = Model.Loans.Sum(x => x.Amount);
            var totalInstallments = Model.Loans.Where(x => !x.IsCompleted).Sum(x => x.InstallmentAmount);
            var totalRemaining = Model.Loans.Sum(x => x.RemainingAmount);
            var totalInsurance = Model.InsurancePurchases
                .Where(x => x.Status == "Approved")
                .Sum(x => x.MonthlyInstallment);
        }
        <div style="display:flex;justify-content:space-around;align-items:center;">
            <div class="col-md-3 col-6">
                <div class="info-box bg-white shadow-sm border-bottom border-success">
                    <span class="info-box-icon bg-success"><i class="fas fa-money-bill-wave"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">إجمالي السلف المنصرفة</span>
                        <span class="info-box-number">@totalLoans.ToString("N0") <small>جم</small></span>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="info-box bg-white shadow-sm border-bottom border-primary">
                    <span class="info-box-icon bg-primary"><i class="fas fa-sync"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">إجمالي القسط الشهري المحصل</span>
                        <span class="info-box-number">@totalInstallments.ToString("N0") <small>جم</small></span>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="info-box bg-white shadow-sm border-bottom border-danger">
                    <span class="info-box-icon bg-danger"><i class="fas fa-chart-pie"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">الرصيد المتبقي (مديونية)</span>
                        <span class="info-box-number text-danger">@totalRemaining.ToString("N0") <small>جم</small></span>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="info-box bg-white shadow-sm border-bottom border-info">
                    <span class="info-box-icon bg-info"><i class="fas fa-shield-alt"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">أقساط التأمينات الشهرية</span>
                        <span class="info-box-number">@totalInsurance.ToString("N0") <small>جم</small></span>
                    </div>
                </div>
            </div>
        </div>

        @* ── Tabs ── *@
        <div class="card card-primary card-tabs">
            <div class="card-header p-0 pt-1">
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" data-bs-toggle="pill" href="#content-loan" role="tab">
                            <i class="fas fa-receipt me-1"></i> السلف الشخصية
                            <span class="badge bg-warning text-dark ms-1">@Model.Loans.Count</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="pill" href="#content-purchase" role="tab">
                            <i class="fas fa-shopping-basket me-1"></i> طلبات شراء المدد التأمينية
                            <span class="badge bg-info ms-1">@Model.InsurancePurchases.Count</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="card-body">
                <div class="tab-content">

                    @* ══ TAB 1: السلف ══ *@
                    <div class="tab-pane fade show active" id="content-loan" role="tabpanel">
                        <div class="d-flex justify-content-end mb-3">
                            <button class="btn btn-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#loanModal">
                                <i class="fas fa-plus me-1"></i> صرف سلفة جديدة
                            </button>
                        </div>

                        <table id="tableLoans"
                               class="table table-bordered table-striped text-center align-middle">
                            <thead class="bg-secondary text-white">
                                <tr>
                                    <th>م</th>
                                    <th>الموظف</th>
                                    <th>تاريخ الصرف</th>
                                    <th>قيمة السلفة</th>
                                    <th>عدد الأقساط</th>
                                    <th>القسط الشهري</th>
                                    <th>المتبقي</th>
                                    <th>الحالة</th>
                                    <th>تفاصيل</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Loans.Any())
                                {
                                    <tr>
                                        <td colspan="9">
                                            <div class="empty-state text-center text-muted">
                                                <i class="fas fa-hand-holding-usd d-block mb-3 text-secondary"></i>
                                                <h6 class="fw-bold">لا يوجد سلف حالياً</h6>
                                                <small>يمكنك إضافة سلفة جديدة من الزر أعلاه</small>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    int loanCounter = 1;
                                    foreach (var loan in Model.Loans)
                                    {
                                        <tr>
                                            <td>@loanCounter</td>
                                            <td class="text-end fw-bold">@loan.EmployeeName</td>
                                            <td>@loan.StartDate.ToString("dd/MM/yyyy")</td>
                                            <td class="fw-bold text-success">@loan.Amount.ToString("N0")</td>
                                            <td>@loan.Months شهر</td>
                                            <td class="text-danger fw-bold">@loan.InstallmentAmount.ToString("N0")</td>
                                            <td>@loan.RemainingAmount.ToString("N0")</td>
                                            <td>
                                                @if (loan.IsCompleted)
                                                {
                                                    <span class="badge bg-success">خالصة</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">سارية (يخصم)</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-action="Details"
                                                   asp-route-id="@loan.Id"
                                                   class="btn btn-sm btn-outline-info">
                                                    <i class="fas fa-list-ol"></i> الأقساط
                                                </a>
                                                @if (!loan.IsCompleted)
                                                {
                                                    <form asp-action="SettleLoan"
                                                          method="post"
                                                          class="d-inline"
                                                          onsubmit="return confirm('هل تريد مخالصة هذه السلفة؟')">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@loan.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-dark">
                                                            <i class="fas fa-check"></i> مخالصة
                                                        </button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                        loanCounter++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    @* ══ TAB 2: شراء المدد ══ *@
                    <div class="tab-pane fade" id="content-purchase" role="tabpanel">
                        <div class="row mb-3">
                            <div class="col-md-9">
                                <div class="alert alert-light border border-info p-2">
                                    <i class="fas fa-info-circle me-1"></i>
                                    يتم تسجيل المدد المشتراة لغرض المعاش، ويتم توريد الأقساط للتأمينات الاجتماعية شهرياً.
                                </div>
                            </div>
                            <div class="col-md-3 text-end">
                                <button class="btn btn-info text-white"
                                        data-bs-toggle="modal"
                                        data-bs-target="#purchaseModal">
                                    <i class="fas fa-cart-plus me-1"></i> طلب شراء مدة
                                </button>
                            </div>
                        </div>

                        <table id="tablePurchases"
                               class="table table-bordered table-hover text-center align-middle">
                            <thead class="bg-dark text-white">
                                <tr>
                                    <th>م</th>
                                    <th>الموظف</th>
                                    <th>الجهة التأمينية</th>
                                    <th>عدد السنوات</th>
                                    <th>التكلفة الإجمالية</th>
                                    <th>القسط الشهري</th>
                                    <th>المتبقي</th>
                                    <th>بداية الخصم</th>
                                    <th>حالة الطلب</th>
                                    <th>إجراء</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.InsurancePurchases.Any())
                                {
                                    <tr>
                                        <td colspan="10">
                                            <div class="empty-state text-center text-muted">
                                                <i class="fas fa-shield-alt d-block mb-3 text-secondary"></i>
                                                <h6 class="fw-bold">لا يوجد طلبات شراء مدد حالياً</h6>
                                                <small>يمكنك إضافة طلب جديد من الزر أعلاه</small>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    int insCounter = 1;
                                    foreach (var item in Model.InsurancePurchases)
                                    {
                                        <tr>
                                            <td>@insCounter</td>
                                            <td class="text-end fw-bold">@item.EmployeeName</td>
                                            <td>@item.InsuranceAuthority</td>
                                            <td>@item.PurchasedYears سنوات</td>
                                            <td>@item.TotalCost.ToString("N0") جم</td>
                                            <td class="text-danger fw-bold">@item.MonthlyInstallment.ToString("N0") جم</td>
                                            <td>@item.RemainingAmount.ToString("N0") جم</td>
                                            <td>@item.DeductionStartDate.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                @switch (item.Status)
                                                {
                                                    case "Approved":
                                                        <span class="badge bg-primary">معتمد وساري</span>
                                                        break;
                                                    case "PendingApproval":
                                                        <span class="badge bg-warning text-dark">في انتظار الاعتماد</span>
                                                        break;
                                                    case "Completed":
                                                        <span class="badge bg-success">منتهي</span>
                                                        break;
                                                    case "Rejected":
                                                        <span class="badge bg-danger">مرفوض</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                @if (item.Status == "PendingApproval")
                                                {
                                                    <form asp-action="ApproveInsurancePurchase"
                                                          method="post"
                                                          class="d-inline"
                                                          onsubmit="return confirm('هل تريد اعتماد هذا الطلب؟')">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <button type="submit" class="btn btn-sm btn-success">
                                                            <i class="fas fa-check"></i> اعتماد
                                                        </button>
                                                    </form>
                                                    <form asp-action="RejectInsurancePurchase"
                                                          method="post"
                                                          class="d-inline"
                                                          onsubmit="return confirm('هل تريد رفض هذا الطلب؟')">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <button type="submit" class="btn btn-sm btn-danger">
                                                            <i class="fas fa-times"></i> رفض
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                        </tr>
                                        insCounter++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>

    </div>
</section>

@* ══ Modal 1: صرف سلفة ══ *@
<div class="modal fade" id="loanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateLoan" asp-controller="Loans" asp-area="HR" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-hand-holding-usd me-1"></i> طلب صرف سلفة مالية
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">الموظف المستفيد</label>
                        <select name="employeeId" class="form-select select2-modal" style="width:100%" required>
                            <option value="">-- اختر الموظف --</option>
                            @if (ViewBag.Employees != null)
                            {
                                foreach (var emp in ViewBag.Employees)
                                {
                                    <option value="@emp.Id">@emp.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">قيمة السلفة</label>
                            <input type="number" name="amount" class="form-control fw-bold text-success"
                                   id="loanAmount" min="1" required onkeyup="calcInstallment()">
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">تقسيط على (شهر)</label>
                            <select name="months" class="form-select" id="loanMonths" onchange="calcInstallment()">
                                <option value="1">دفعة واحدة</option>
                                <option value="3">3 شهور</option>
                                <option value="6">6 شهور</option>
                                <option value="10">10 شهور</option>
                                <option value="12">12 شهر (سنة)</option>
                            </select>
                        </div>
                    </div>
                    <div class="alert alert-light border text-center p-2">
                        قيمة القسط الشهري:
                        <strong id="installmentVal" class="text-danger fs-5">0.00</strong> جنيه
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">يبدأ الخصم من راتب شهر</label>
                        <input type="month" name="startMonth" class="form-control"
                               value="@DateTime.Now.ToString("yyyy-MM")" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">سبب السلفة</label>
                        <input type="text" name="reason" class="form-control"
                               placeholder="ظروف طارئة / زواج / تعليم..." required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> حفظ واعتماد
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ══ Modal 2: شراء مدة تأمينية ══ *@
<div class="modal fade" id="purchaseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateInsurancePurchase" asp-controller="Loans" asp-area="HR"
                  method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-shield-alt me-1"></i> تسجيل شراء مدة خدمة/تأمين
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">الموظف</label>
                        <select name="employeeId" class="form-select select2-modal" style="width:100%" required>
                            <option value="">-- اختر الموظف --</option>
                            @if (ViewBag.Employees != null)
                            {
                                foreach (var emp in ViewBag.Employees)
                                {
                                    <option value="@emp.Id">@emp.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">الجهة التأمينية</label>
                        <input type="text" name="insuranceAuthority" class="form-control"
                               value="الهيئة القومية للتأمينات والمعاشات" required maxlength="200">
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">عدد السنوات المشتراة</label>
                            <input type="number" name="purchasedYears" class="form-control"
                                   placeholder="سنة" min="1" max="30" required>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">التكلفة الإجمالية (المقدرة)</label>
                            <input type="number" name="totalCost" class="form-control" min="1" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-danger">القسط الشهري للخصم</label>
                        <div class="input-group">
                            <input type="number" name="monthlyInstallment" class="form-control"
                                   placeholder="المبلغ الذي سيخصم من الراتب" min="1" required>
                            <span class="input-group-text text-danger fw-bold">جم</span>
                        </div>
                        <small class="text-muted">يستمر الخصم حتى سداد كامل المبلغ للهيئة.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">يبدأ الخصم من شهر</label>
                        <input type="month" name="deductionStartMonth" class="form-control"
                               value="@DateTime.Now.ToString("yyyy-MM")" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">صورة قرار الموافقة</label>
                        <input type="file" name="approvalDecisionFile" class="form-control"
                               accept=".pdf,.jpg,.jpeg,.png">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
                    <button type="submit" class="btn btn-info text-white">
                        <i class="fas fa-save me-1"></i> حفظ وجدولة الخصم
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/plugins/select2/js/select2.full.min.js"></script>

    <script>
        $(function () {
        // DataTables — بس لو في بيانات
        @if (Model.Loans.Any())
        {
            <text>
                $('#tableLoans').DataTable({
                lengthChange: false,
                autoWidth: false,
                language: { url: "//cdn.datatables.net/plug-ins/1.10.25/i18n/Arabic.json" }
                });
            </text>
        }

        @if (Model.InsurancePurchases.Any())
        {
            <text>
                $('#tablePurchases').DataTable({
                lengthChange: false,
                autoWidth: false,
                language: { url: "//cdn.datatables.net/plug-ins/1.10.25/i18n/Arabic.json" }
                });
            </text>
        }

        // Select2 جوه الـ Modal
        $('#loanModal').on('shown.bs.modal', function () {
        $(this).find('.select2-modal').select2({
        theme: 'bootstrap4',
        dropdownParent: $('#loanModal'),
        language: 'ar',
        dir: 'rtl',
        width: '100%'
        });
        });

        $('#purchaseModal').on('shown.bs.modal', function () {
        $(this).find('.select2-modal').select2({
        theme: 'bootstrap4',
        dropdownParent: $('#purchaseModal'),
        language: 'ar',
        dir: 'rtl',
        width: '100%'
        });
        });
        });

        function calcInstallment() {
        var amount = parseFloat(document.getElementById("loanAmount").value) || 0;
        var months = parseInt(document.getElementById("loanMonths").value) || 1;
        document.getElementById("installmentVal").innerText = (amount / months).toFixed(2);
        }
    </script>
}
