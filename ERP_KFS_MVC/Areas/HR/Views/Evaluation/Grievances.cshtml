@model List<HR.Application.Evaluations.GetGrievanceList.GetGrievanceListResponse>
@using HR.Application.Evaluations.GetGrievanceStats
@using HR.Application.Evaluations.GetGrievanceList
@using HR.Application.Employees.GetAllEmployees

@{
    ViewData["Title"] = "سجل التظلمات والشكاوى الإدارية";
    var stats = ViewBag.Stats as GetGrievanceStatsResponse ?? new GetGrievanceStatsResponse();
    var employees = ViewBag.Employees as List<EmployeeListResponse> ?? new List<EmployeeListResponse>();
}

<!-- CSS Plugins -->
<link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
<link rel="stylesheet" href="~/plugins/select2/css/select2.min.css">
<link rel="stylesheet" href="~/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css">
<link rel="stylesheet" href="~/plugins/sweetalert2-theme-bootstrap-4/bootstrap-4.min.css">

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark"><i class="fas fa-gavel text-secondary me-2"></i> التظلمات الإدارية</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">HR</a></li>
                    <li class="breadcrumb-item active">التظلمات</li>
                </ol>
            </div>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section class="content">
    <div class="container-fluid">

        <!-- 1. إحصائيات سريعة -->
        <div class="row">
            <div class="col-md-3 col-sm-6">
                <div class="info-box bg-gradient-info">
                    <span class="info-box-icon"><i class="far fa-copy"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">إجمالي التظلمات</span>
                        <span class="info-box-number">@stats.TotalGrievances</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="info-box bg-gradient-warning">
                    <span class="info-box-icon"><i class="fas fa-hourglass-half"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">قيد البحث (لجنة)</span>
                        <span class="info-box-number">@stats.PendingCount</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="info-box bg-gradient-success">
                    <span class="info-box-icon"><i class="fas fa-check"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">تم قبول التظلم</span>
                        <span class="info-box-number">@stats.AcceptedCount</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="info-box bg-gradient-danger">
                    <span class="info-box-icon"><i class="fas fa-times"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">مرفوض شكلاً/موضوعاً</span>
                        <span class="info-box-number">@stats.RejectedCount</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. جدول التظلمات -->
        <div class="card card-outline card-secondary">
            <div class="card-header border-0">
                <h3 class="card-title text-bold">سجل الشكاوى والتظلمات المقدمة</h3>
                <div class="card-tools">
                    <button class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#grievanceModal">
                        <i class="fas fa-plus-circle me-1"></i> تسجيل تظلم جديد
                    </button>
                </div>
            </div>

            <div class="card-body">
                <table id="grievanceTable" class="table table-bordered table-striped text-center align-middle">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>م</th>
                            <th>تاريخ التقديم</th>
                            <th>الموظف</th>
                            <th>يتظلم من (القرار)</th>
                            <th>تاريخ القرار</th>
                            <th>مرفقات</th>
                            <th>قرار اللجنة</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var idx = 1; }
                        @foreach (var item in Model)
                        {
                            var typeBadgeClass = item.GrievanceTypeName switch
                            {
                                "PerformanceReport" => "bg-warning text-dark",
                                "PenaltyDecision" => "bg-danger",
                                "TransferDecision" => "bg-purple",
                                "PromotionSkip" => "bg-info",
                                _ => "bg-secondary"
                            };
                            var typeNameAr = item.GrievanceTypeName switch
                            {
                                "PerformanceReport" => "تقرير الكفاءة",
                                "PenaltyDecision" => "قرار جزاء",
                                "TransferDecision" => "قرار نقل",
                                "PromotionSkip" => "تخطي في الترقية",
                                _ => "أخرى"
                            };

                            var statusBadge = item.StatusName switch
                            {
                                "Pending" => "bg-warning text-dark",
                                "UnderReview" => "bg-warning text-dark",
                                "Accepted" => "bg-success",
                                "Rejected" => "bg-danger",
                                "PartiallyAccepted" => "bg-info",
                                _ => "bg-secondary"
                            };
                            var statusText = item.StatusName switch
                            {
                                "Pending" => "قيد الانتظار",
                                "UnderReview" => "جاري العرض على اللجنة",
                                "Accepted" => "تم القبول",
                                "Rejected" => "رفض التظلم",
                                "PartiallyAccepted" => "قبول جزئي",
                                _ => item.StatusName
                            };

                            var attachmentIcon = item.HasAttachment
                                ? "<i class='fas fa-paperclip text-secondary'></i>"
                                : "-";

                            <tr>
                                <td>@idx</td>
                                <td>@item.SubmissionDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-end fw-bold">@item.EmployeeName</td>
                                <td>
                                    <span class="badge @typeBadgeClass">@typeNameAr</span>
                                    <br><small>@item.ComplainedDecisionNumber</small>
                                </td>
                                <td>@item.ComplainedDecisionDate.ToString("dd/MM/yyyy")</td>
                                <td>@Html.Raw(attachmentIcon)</td>
                                <td>
                                    @if (item.StatusName == "Accepted" || item.StatusName == "Rejected" || item.StatusName == "PartiallyAccepted")
                                    {
                                        <span class="badge @statusBadge p-2">@statusText</span>
                                        if (item.ResolutionDate.HasValue)
                                        {
                                            <div class="text-muted small mt-1">تاريخ البت: @item.ResolutionDate.Value.ToString("dd/MM/yyyy")</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge @statusBadge p-2">@statusText</span>
                                    }
                                </td>
                                <td>
                                    @if (item.StatusName == "Pending" || item.StatusName == "UnderReview")
                                    {
                                        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#decisionModal_@item.Id"><i class="fas fa-gavel me-1"></i> البت في التظلم</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-dark"><i class="fas fa-eye"></i> التفاصيل</button>
                                    }
                                </td>
                            </tr>
                            idx++;
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>

<!-- Modals: قرار اللجنة لكل تظلم معلق -->
@foreach (var item in Model.Where(m => m.StatusName == "Pending" || m.StatusName == "UnderReview"))
{
    <div class="modal fade" id="decisionModal_@item.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title"><i class="fas fa-gavel me-2"></i> قرار لجنة التظلمات</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-action="ResolveGrievance">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="GrievanceId" value="@item.Id" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">الموظف: <span class="text-primary">@item.EmployeeName</span></label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">منطوق قرار اللجنة:</label>
                            <select name="NewStatus" class="form-select form-control-lg" required>
                                <option value="Rejected">رفض التظلم (تأييد القرار الأصلي)</option>
                                <option value="Accepted">قبول التظلم (سحب القرار)</option>
                                <option value="PartiallyAccepted">قبول جزئي (تعديل القرار)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">حيثيات القرار / النتيجة النهائية</label>
                            <textarea name="CommitteeNotes" class="form-control" rows="3" placeholder="مثال: تم التأكد من عدم ارتكاب المخالفة وقبول التظلم..."></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">تاريخ البت</label>
                            <input type="date" name="ResolutionDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
                        <button type="submit" class="btn btn-success"><i class="fas fa-check-double me-1"></i> اعتماد وتغيير الحالة</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Modal: تسجيل تظلم -->
<div class="modal fade" id="grievanceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title"><i class="fas fa-file-alt me-2"></i> استلام طلب تظلم</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="CreateGrievance">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row">
                        <!-- البيانات الأساسية -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">الموظف المتظلم</label>
                            <select name="EmployeeId" class="form-select select2 select2-modal" style="width:100%" required>
                                <option value="">بحث...</option>
                                @foreach (var emp in employees)
                                {
                                    <option value="@emp.Id">@emp.Name (@emp.JobTitleName)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">نوع التظلم</label>
                            <select name="GrievanceType" class="form-select" id="grievanceType" required>
                                <option value="PerformanceReport">من تقرير تقويم الأداء</option>
                                <option value="PenaltyDecision">من قرار جزاء / تأديب</option>
                                <option value="TransferDecision">من قرار نقل / ندب</option>
                                <option value="PromotionSkip">تخطي في الترقية</option>
                                <option value="Other">أخرى</option>
                            </select>
                        </div>

                        <!-- تفاصيل القرار المشكو في حقه -->
                        <div class="col-md-4 mb-3">
                            <label class="form-label">رقم القرار / التقرير</label>
                            <input type="text" name="ComplainedDecisionNumber" class="form-control" placeholder="مثال: جزاء رقم 55" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">تاريخ صدور القرار</label>
                            <input type="date" name="ComplainedDecisionDate" class="form-control" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">تاريخ استلام التظلم (اليوم)</label>
                            <input type="date" name="SubmissionDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="col-md-12 mb-3">
                            <label class="form-label">أسباب التظلم (موجز الشكوى)</label>
                            <textarea name="Reasons" class="form-control" rows="3" placeholder="أذكر الأسباب التي يستند عليها الموظف..." required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-secondary"><i class="fas fa-save me-1"></i> تسجيل وإحالة للجنة</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JS Plugins -->
<script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="~/plugins/select2/js/select2.full.min.js"></script>
<script src="~/plugins/sweetalert2/sweetalert2.min.js"></script>

<script>
    $(function () {
        $("#grievanceTable").DataTable({
            "language": { "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Arabic.json" },
            "autoWidth": false,
            "lengthChange": false
        });

        $('.select2-modal').select2({
            theme: 'bootstrap4',
            dropdownParent: $('#grievanceModal')
        });
    });
</script>
