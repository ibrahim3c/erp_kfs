@model List<ERP_KFS_MVC.Areas.HR.ViewModels.OrgUnitTreeNodeViewModel>
@using HR.Application.Departments.GetOrgUnitTree
@using HR.Application.Departments.GetOrgUnitTypeOptions
@using HR.Application.Employees.GetAllEmployees
@using HR.Application.Departments.GetDepartmentStats

@{
    ViewData["Title"] = "الهيكل التنظيمي (ديوان عام المحافظة)";
    var stats = ViewBag.Stats as GetDepartmentStatsResponse ?? new GetDepartmentStatsResponse();
    var orgUnitTypes = ViewBag.OrgUnitTypes as List<GetOrgUnitTypeOptionsResponse> ?? new();
    var employees = ViewBag.Employees as List<EmployeeListResponse> ?? new();
    var flatUnits = ViewBag.FlatUnits as List<GetOrgUnitTreeResponse> ?? new();
    var parentUnits = flatUnits.Where(u => u.IsActive).OrderBy(u => u.Name).ToList();
}

<!-- CSS مخصص لرسم الشجرة (Tree View) -->
<style>
    .tree ul {
        padding-top: 20px;
        position: relative;
        transition: all 0.5s;
        -webkit-transition: all 0.5s;
        -moz-transition: all 0.5s;
    }

    .tree li {
        float: left;
        text-align: center;
        list-style-type: none;
        position: relative;
        padding: 20px 5px 0 5px;
        transition: all 0.5s;
        -webkit-transition: all 0.5s;
        -moz-transition: all 0.5s;
    }

        .tree li::before, .tree li::after {
            content: '';
            position: absolute;
            top: 0;
            right: 50%;
            border-top: 2px solid #ccc;
            width: 50%;
            height: 20px;
        }

        .tree li::after {
            right: auto;
            left: 50%;
            border-left: 2px solid #ccc;
        }

        .tree li:only-child::after, .tree li:only-child::before {
            display: none;
        }

        .tree li:only-child {
            padding-top: 0;
        }

        .tree li:first-child::before, .tree li:last-child::after {
            border: 0 none;
        }

        .tree li:last-child::before {
            border-right: 2px solid #ccc;
            border-radius: 0 5px 0 0;
        }

        .tree li:first-child::after {
            border-radius: 5px 0 0 0;
        }

    .tree ul ul::before {
        content: '';
        position: absolute;
        top: 0;
        left: 50%;
        border-left: 2px solid #ccc;
        width: 0;
        height: 20px;
    }

    .tree a {
        border: 2px solid #ccc;
        padding: 10px 15px;
        text-decoration: none;
        color: #666;
        font-family: 'Cairo', sans-serif;
        font-size: 14px;
        display: inline-block;
        border-radius: 5px;
        transition: all 0.5s;
        background: white;
    }

        .tree a:hover, .tree a:hover + ul li a {
            background: #c8e4f8;
            color: #000;
            border: 2px solid #94a0b4;
        }

            .tree a:hover + ul li::after, .tree a:hover + ul li::before, .tree a:hover + ul::before, .tree a:hover + ul ul::before {
                border-color: #94a0b4;
            }

    /* ألوان المستويات بناء على الصورة */
    .lvl-1 {
        background-color: #3498db !important;
        color: white !important;
        font-weight: bold;
        font-size: 1.2rem !important;
    }

    .lvl-2 {
        background-color: #85c1e9 !important;
        color: black !important;
        font-weight: bold;
    }

    .lvl-3 {
        background-color: #fce4ec !important;
        border-color: #e91e63 !important;
        color: #880e4f !important;
    }
    /* إدارات عامة */
    .lvl-4 {
        background-color: white !important;
        font-size: 0.8rem !important;
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">الهيكل الإداري والتنظيمي</h1>
            </div>
            <div class="col-sm-6">
                <button class="btn btn-primary float-sm-end" data-bs-toggle="modal" data-bs-target="#deptModal">
                    <i class="fas fa-plus-circle me-1"></i> إضافة وحدة إدارية
                </button>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-outline card-info">
            <div class="card-body">
                <div class="table-responsive" style="overflow-x:auto;">
                    <div class="tree text-center" style="min-width: 2500px;">
                        <!-- عرض كبير عشان الشجرة تسيع -->
                        <ul>
                            @foreach (var node in Model)
                            {
                                @await Html.PartialAsync("_OrgUnitTreeNode", node)
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- جدول سريع للإدارة النصية -->
        <div class="card mt-3 collapsed-card">
            <div class="card-header bg-secondary">
                <h3 class="card-title">إدارة الهيكل (عرض جدولي)</h3>
                <div class="card-tools"><button class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-plus"></i></button></div>
            </div>
            <div class="card-body p-0" style="display:none">
                <table class="table table-sm table-striped">
                    <thead><tr><th>الاسم</th><th>التبعية</th><th>المدير الحالي</th><th>العدد</th></tr></thead>
                    <tbody>
                        @foreach (var unit in flatUnits)
                        {
                            <tr>
                                <td>@unit.Name</td>
                                <td>@(unit.ParentName ?? "—")</td>
                                <td>@(unit.CurrentManagerName ?? "...")</td>
                                <td>@unit.EmployeeCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>

<!-- Modal: إضافة إدارة -->
<div class="modal fade" id="deptModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">إضافة وحدة تنظيمية جديدة</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="Save">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">اسم الإدارة / القسم</label>
                        <input type="text" class="form-control" name="Name" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الكود</label>
                        <input type="text" class="form-control" name="Code" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">نوع الوحدة التنظيمية</label>
                        <select class="form-select" name="OrgUnitTypeId" required>
                            <option value="">-- اختر النوع --</option>
                            @foreach (var t in orgUnitTypes)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">تتبع (المستوى الأعلى)</label>
                        <select class="form-select" name="ParentId">
                            <option value="">-- مستوى رئيسي --</option>
                            @foreach (var p in parentUnits)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">مدير الإدارة</label>
                        <select class="form-select">
                            <option value="">اختيار موظف...</option>
                            @foreach (var e in employees)
                            {
                                <option value="@e.Id">@e.Name - @(e.JobTitleName ?? "")</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </div>
            </form>
        </div>
    </div>
</div>
