@model ERP_KFS_MVC.Areas.HR.ViewModels.CreateFullEmployeeViewModel

@{
    ViewData["Title"] = "إضافة موظف جديد";
}

<link rel="stylesheet" href="~/css/global/hr-custom.css" asp-append-version="true">

<div class="hr-page-container animate__animated animate__fadeIn">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h5 font-weight-bold text-dark mb-1">فتح ملف موظف جديد</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent p-0 small mb-0">
                    <li class="breadcrumb-item"><a asp-action="Index">سجل الموظفين</a></li>
                    <li class="breadcrumb-item active">إضافة جديد</li>
                </ol>
            </nav>
        </div>
        <a asp-action="Index" class="hr-btn hr-btn-outline">
            <i class="fas fa-arrow-right"></i> العودة للسجل
        </a>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="createEmployeeForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 mb-3"></div>

        <div class="hr-card">

            <ul class="nav nav-tabs hr-tabs border-0" id="employeeTabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="tab-personal" data-bs-toggle="tab" href="#personal" role="tab">
                        <i class="fas fa-user-circle"></i> البيانات الشخصية
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="tab-job" data-bs-toggle="tab" href="#job" role="tab">
                        <i class="fas fa-briefcase"></i> الوظيفة والدرجة
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="tab-files" data-bs-toggle="tab" href="#files" role="tab">
                        <i class="fas fa-clone"></i> مسوغات التعيين
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="tab-financial" data-bs-toggle="tab" href="#financial" role="tab">
                        <i class="fas fa-wallet"></i> البيانات المالية
                    </a>
                </li>
            </ul>

            <div class="hr-table-wrapper p-5">
                <div class="tab-content" id="employeeTabsContent">

                    <div class="tab-pane fade show active" id="personal" role="tabpanel">
                        <div class="row">

                            <div class="col-md-3 text-center mb-5 mb-md-0">
                                <div class="hr-image-upload">
                                    <img id="imgPreview" src="~/image/icons/7.png"
                                         alt="Profile" class="hr-image-preview">
                                    <label class="hr-upload-btn shadow-sm">
                                        <i class="fas fa-camera"></i>
                                        <input asp-for="ProfileImage" type="file"
                                               style="display:none;" accept="image/*"
                                               onchange="previewImage(this)">
                                    </label>
                                </div>
                                <p class="text-muted small mt-3">صورة شخصية (اختياري)</p>
                            </div>

                            <div class="col-md-9">
                                <div class="row">

                                    <div class="col-md-4 hr-form-group">
                                        <label asp-for="FirstName" class="hr-form-label">
                                            الاسم الأول <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="FirstName" class="form-control hr-form-control"
                                               placeholder="محمد" />
                                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-4 hr-form-group">
                                        <label asp-for="FatherName" class="hr-form-label">
                                            اسم الأب <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="FatherName" class="form-control hr-form-control"
                                               placeholder="أحمد" />
                                        <span asp-validation-for="FatherName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-4 hr-form-group">
                                        <label asp-for="LastName" class="hr-form-label">
                                            اسم العائلة <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="LastName" class="form-control hr-form-control"
                                               placeholder="السيد" />
                                        <span asp-validation-for="LastName" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6 hr-form-group">
                                        <label asp-for="NationalId" class="hr-form-label">
                                            الرقم القومي (14 رقم) <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="NationalId" class="form-control hr-form-control"
                                               maxlength="14" placeholder="2990901xxxxxxx"
                                               id="nationalIdInput" />
                                        <small class="text-muted">سيتم استخراج تاريخ الميلاد والنوع تلقائياً</small>
                                        <span asp-validation-for="NationalId" class="text-danger small"></span>
                                    </div>


                                    <div class="col-md-3 hr-form-group">
                                        <label asp-for="DateOfBirth" class="hr-form-label">تاريخ الميلاد</label>
                                        <input asp-for="DateOfBirth" type="date" id="dateOfBirthInput"
                                               class="form-control hr-form-control" />
                                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-3 hr-form-group">
                                        <label asp-for="Gender" class="hr-form-label">النوع</label>
                                        <select asp-for="Gender" class="form-select hr-form-control"
                                                id="genderSelect">
                                            <option value="">-- اختر --</option>
                                            <option value="ذكر">ذكر</option>
                                            <option value="أنثى">أنثى</option>
                                        </select>
                                        <span asp-validation-for="Gender" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-3 hr-form-group">
                                        <label asp-for="MaritalStatus" class="hr-form-label">الحالة الاجتماعية</label>
                                        <select asp-for="MaritalStatus" class="form-select hr-form-control">
                                            <option value="">-- اختر --</option>
                                            <option value="أعزب">أعزب</option>
                                            <option value="متزوج">متزوج</option>
                                            <option value="مطلق">مطلق</option>
                                            <option value="أرمل">أرمل</option>
                                        </select>
                                        <span asp-validation-for="MaritalStatus" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6 hr-form-group">
                                        <label asp-for="Phone" class="hr-form-label">رقم الموبايل</label>
                                        <input asp-for="Phone" type="tel"
                                               class="form-control hr-form-control"
                                               placeholder="01x xxxx xxxx" />
                                        <span asp-validation-for="Phone" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6 hr-form-group">
                                        <label asp-for="Email" class="hr-form-label">البريد الإلكتروني <span class="text-danger">*</span></label>
                                        <input asp-for="Email" type="email"
                                               class="form-control hr-form-control"
                                               placeholder="example@domain.com" />
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-12 hr-form-group">
                                        <label asp-for="Address" class="hr-form-label">العنوان بالتفصيل</label>
                                        <input asp-for="Address" class="form-control hr-form-control"
                                               placeholder="المحافظة - المركز - الشارع" />
                                        <span asp-validation-for="Address" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12 mt-3">
                                        <div class="hr-switch-group d-flex align-items-center justify-content-between">
                                            <div>
                                                <h6 class="mb-1 text-dark">فئة خاصة (ذوي الهمم)</h6>
                                                <p class="text-muted small mb-0">
                                                    تفعيل هذه الحالة يرفع رصيد الأجازات الاعتيادية إلى 45 يوم تلقائياً
                                                </p>
                                            </div>
                                            <div class="form-check form-switch m-0">
                                                <input asp-for="IsDisabled" class="form-check-input"
                                                       type="checkbox"
                                                       style="width:3rem; height:1.5rem;">
                                                <label asp-for="IsDisabled"
                                                       class="form-check-label mr-3">نعم (الـ 5%)</label>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="job" role="tabpanel">
                        <div class="row">

                            <div class="col-md-6 hr-form-group">
                                <label class="hr-form-label">كود الموظف</label>
                                <input class="form-control hr-form-control" readonly
                                       placeholder="يتم إنشاؤه تلقائياً" />
                            </div>

                            <div class="col-md-6 hr-form-group">
                                <label asp-for="OrgUnitId" class="hr-form-label">الإدارة التابع لها</label>
                                <select asp-for="OrgUnitId" class="form-select hr-form-control"
                                        asp-items="ViewBag.OrgUnitId">
                                    <option value="">-- اختر الإدارة --</option>
                                </select>
                                <span asp-validation-for="OrgUnitId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 hr-form-group">
                                <label asp-for="JobTitleName" class="hr-form-label">
                                    المسمى الوظيفي <span class="text-danger">*</span>
                                </label>
                                <select asp-for="JobTitleName" class="form-select hr-form-control"
                                        asp-items="ViewBag.JobTitleName">
                                    <option value="">-- اختر المسمى الوظيفي --</option>
                                </select>
                                <span asp-validation-for="JobTitleName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 hr-form-group">
                                <label asp-for="QualificationName" class="hr-form-label">المؤهل الدراسي</label>
                                <input asp-for="QualificationName" class="form-control hr-form-control"
                                       placeholder="مثال: بكالوريوس تجارة" />
                                <span asp-validation-for="QualificationName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 hr-form-group">
                                <label asp-for="JobGradeId" class="hr-form-label">الدرجة المالية</label>
                                <select asp-for="JobGradeId" class="form-select hr-form-control"
                                        asp-items="ViewBag.JobGradeId">
                                    <option value="">-- اختر --</option>
                                </select>
                                <span asp-validation-for="JobGradeId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 hr-form-group">
                                <label asp-for="EmploymentTypeId" class="hr-form-label">نوع الكادر</label>
                                <select asp-for="EmploymentTypeId" class="form-select hr-form-control"
                                        asp-items="ViewBag.EmploymentTypeId">
                                    <option value="">-- اختر --</option>
                                </select>
                                <span asp-validation-for="EmploymentTypeId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 hr-form-group">
                                <label asp-for="HireDate" class="hr-form-label">
                                    تاريخ التعيين الفعلي <span class="text-danger">*</span>
                                </label>
                                <input asp-for="HireDate" type="date"
                                       class="form-control hr-form-control" />
                                <span asp-validation-for="HireDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 hr-form-group">
                                <label asp-for="JobGradeDate" class="hr-form-label">تاريخ الحصول على الدرجة</label>
                                <input asp-for="JobGradeDate" type="date"
                                       class="form-control hr-form-control" />
                                <small class="text-muted">هام جداً لاحتساب أقدمية الترقية</small>
                                <span asp-validation-for="JobGradeDate" class="text-danger small"></span>
                            </div>

                        </div>
                    </div>

                    <div class="tab-pane fade" id="files" role="tabpanel">

                        <div class="alert hr-primary-soft text-primary border-0 rounded-4 p-4 mb-4">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fas fa-info-circle h4 mb-0"></i>
                                <div>
                                    <h6 class="mb-1 font-weight-bold">نظام الأرشفة الإلكترونية (E-File)</h6>
                                    <p class="mb-0 small opacity-75">
                                        يفضل رفع جميع المستندات بصيغة PDF لسهولة العرض في ملف الموظف لاحقاً
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 hr-form-group">
                                <label asp-for="NationalIdCard" class="hr-form-label">صورة بطاقة الرقم القومي</label>
                                <input asp-for="NationalIdCard" type="file"
                                       class="form-control hr-form-control" accept=".pdf,image/*" />
                            </div>
                            <div class="col-md-6 hr-form-group">
                                <label asp-for="QualificationFile" class="hr-form-label">صورة المؤهل الدراسي</label>
                                <input asp-for="QualificationFile" type="file"
                                       class="form-control hr-form-control" accept=".pdf,image/*" />
                            </div>
                            <div class="col-md-6 hr-form-group">
                                <label asp-for="BirthCertificate" class="hr-form-label">شهادة الميلاد المميكنة</label>
                                <input asp-for="BirthCertificate" type="file"
                                       class="form-control hr-form-control" accept=".pdf,image/*" />
                            </div>
                            <div class="col-md-6 hr-form-group">
                                <label asp-for="MilitaryFile" class="hr-form-label">الموقف من التجنيد</label>
                                <input asp-for="MilitaryFile" type="file"
                                       class="form-control hr-form-control" accept=".pdf,image/*" />
                            </div>
                            <div class="col-md-6 hr-form-group">
                                <label asp-for="ContractFile" class="hr-form-label">قرار التعيين / العقد</label>
                                <input asp-for="ContractFile" type="file"
                                       class="form-control hr-form-control" accept=".pdf,image/*" />
                            </div>
                            <div class="col-md-6 hr-form-group">
                                <label asp-for="PoliceClearance" class="hr-form-label">فيش جنائي حديث</label>
                                <input asp-for="PoliceClearance" type="file"
                                       class="form-control hr-form-control" accept=".pdf,image/*" />
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="financial" role="tabpanel">
                        <div class="row">

                            <div class="col-md-6 hr-form-group">
                                <label asp-for="InsuranceNumber" class="hr-form-label">الرقم التأميني</label>
                                <input asp-for="InsuranceNumber" class="form-control hr-form-control" />
                                <span asp-validation-for="InsuranceNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 hr-form-group">
                                <label asp-for="BankAccountNumber" class="hr-form-label">رقم بطاقة الدفع (ميزة)</label>
                                <input asp-for="BankAccountNumber" class="form-control hr-form-control"
                                       placeholder="أرقام البطاقة..." />
                                <span asp-validation-for="BankAccountNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 hr-form-group">
                                <label asp-for="BankName" class="hr-form-label">البنك</label>
                                <select asp-for="BankName" class="form-select hr-form-control">
                                    <option value="">-- اختر البنك --</option>
                                    <option value="البنك الأهلي المصري">البنك الأهلي المصري</option>
                                    <option value="بنك مصر">بنك مصر</option>
                                    <option value="بنك القاهرة">بنك القاهرة</option>
                                    <option value="البريد المصري">البريد المصري</option>
                                </select>
                                <span asp-validation-for="BankName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-3 hr-form-group">
                                <label asp-for="GrossSalary" class="hr-form-label">إجمالي الاستحقاق (Gross)</label>
                                <div class="input-group">
                                    <input asp-for="GrossSalary" type="number" step="0.01"
                                           class="form-control hr-form-control" placeholder="0.00" />
                                    <span class="input-group-text bg-light">جم</span>
                                </div>
                                <span asp-validation-for="GrossSalary" class="text-danger small"></span>
                            </div>

                            <div class="col-md-3 hr-form-group">
                                <label asp-for="BasicSalary2019" class="hr-form-label">الراتب الأساسي 2019</label>
                                <div class="input-group">
                                    <input asp-for="BasicSalary2019" type="number" step="0.01"
                                           class="form-control hr-form-control" placeholder="0.00" />
                                    <span class="input-group-text bg-light">جم</span>
                                </div>
                                <span asp-validation-for="BasicSalary2019" class="text-danger small"></span>
                            </div>

                            <div class="col-12 mt-3">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="hr-switch-group d-flex align-items-center justify-content-between">
                                            <div>
                                                <h6 class="mb-1 text-dark">صندوق الزمالة</h6>
                                                <p class="text-muted small mb-0">مشترك في صندوق الزمالة</p>
                                            </div>
                                            <div class="form-check form-switch m-0">
                                                <input asp-for="HasFellowshipFund" class="form-check-input"
                                                       type="checkbox" style="width:3rem; height:1.5rem;">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="hr-switch-group d-flex align-items-center justify-content-between">
                                            <div>
                                                <h6 class="mb-1 text-dark">صندوق التكافل الصحي</h6>
                                                <p class="text-muted small mb-0">مشترك في صندوق التكافل</p>
                                            </div>
                                            <div class="form-check form-switch m-0">
                                                <input asp-for="HasMedicalFund" class="form-check-input"
                                                       type="checkbox" style="width:3rem; height:1.5rem;">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>

            <div class="hr-card-footer bg-light p-4 d-flex justify-content-between align-items-center border-top">
                <a asp-action="Index" class="text-muted font-weight-bold text-decoration-none">
                    <i class="fas fa-times"></i> إلغاء العملية
                </a>
                <button type="submit" class="hr-btn hr-btn-primary px-5">
                    <i class="fas fa-check-circle"></i> حفظ وتفعيل الملف
                </button>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // ─── 1. معاينة الصورة الشخصية ────────────────────────────
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e =>
                    document.getElementById('imgPreview').src = e.target.result;
                reader.readAsDataURL(input.files[0]);
            }
        }

        // ─── 2. استخراج البيانات من الرقم القومي ─────────────────
        document.getElementById('nationalIdInput').addEventListener('input', function () {
            const id = this.value;
            if (id.length !== 14 || !/^\d{14}$/.test(id)) return;

            const century = id[0] === '2' ? '19' : '20';
            const dob = `${century}${id.substring(1, 3)}-${id.substring(3, 5)}-${id.substring(5, 7)}`;
            document.getElementById('dateOfBirthInput').value = dob;

            const genderDigit = parseInt(id[12]);
            document.getElementById('genderSelect').value =
                genderDigit % 2 !== 0 ? 'ذكر' : 'أنثى';
        });

        // ─── 3. Tab indicator عند وجود validation errors ──────────
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.tab-pane').forEach(pane => {
                const hasError = pane.querySelector('.text-danger:not(:empty)');
                if (hasError) {
                    const tabLink = document.getElementById('tab-' + pane.id);
                    if (tabLink) {
                        tabLink.classList.add('text-danger');
                        tabLink.innerHTML +=
                            ' <i class="fas fa-exclamation-circle text-danger small"></i>';
                    }
                }
            });
        });
    </script>
}