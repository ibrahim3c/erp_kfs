@model HR.Application.Employees.GetEmployeeDetails.GetEmployeeDetailsResponse

@{
    ViewData["Title"] = "ملف الموظف";
}

<link rel="stylesheet" href="~/css/global/hr-custom.css" asp-append-version="true">

<div class="hr-page-container animate__animated animate__fadeIn">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h5 font-weight-bold text-dark mb-1">ملف الموظف</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent p-0 small mb-0">
                    <li class="breadcrumb-item"><a asp-action="Index">سجل الموظفين</a></li>
                    <li class="breadcrumb-item active">@Model.Name</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="hr-btn hr-btn-outline">
                <i class="fas fa-edit"></i> تعديل
            </a>
            <a asp-action="Index" class="hr-btn hr-btn-outline">
                <i class="fas fa-arrow-right"></i> العودة
            </a>
        </div>
    </div>

    <div class="hr-card">
        <ul class="nav nav-tabs hr-tabs border-0" id="detailsTabs" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" data-bs-toggle="tab" href="#d-personal" role="tab">
                    <i class="fas fa-user-circle"></i> البيانات الشخصية
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#d-job" role="tab">
                    <i class="fas fa-briefcase"></i> الوظيفة والدرجة
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#d-files" role="tab">
                    <i class="fas fa-clone"></i> مسوغات التعيين
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#d-financial" role="tab">
                    <i class="fas fa-wallet"></i> البيانات المالية
                </a>
            </li>
        </ul>

        <div class="hr-table-wrapper p-5">
            <div class="tab-content">

                <!-- 1. البيانات الشخصية -->
                <div class="tab-pane fade show active" id="d-personal" role="tabpanel">
                    <div class="row align-items-start">

                        <div class="col-md-3 text-center mb-4 mb-md-0">
                            @if (!string.IsNullOrEmpty(Model.PersonalPhoto))
                            {
                                <img src="@Model.PersonalPhoto" alt="صورة الموظف"
                                     class="hr-image-preview">
                            }
                            else
                            {
                                <img src="~/image/icons/7.png" alt="لا توجد صورة"
                                     class="hr-image-preview">
                            }
                            <div class="mt-3">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success px-3 py-2">نشط</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">غير نشط</span>
                                }
                                @if (Model.IsDisabled)
                                {
                                    <span class="badge bg-info px-3 py-2 mt-1 d-block">ذوي الهمم (5%)</span>
                                }
                            </div>
                        </div>

                        <div class="col-md-9">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="hr-form-label text-muted small">الاسم الكامل</label>
                                    <p class="fw-bold mb-0">@Model.Name</p>
                                </div>
                                <div class="col-md-6">
                                    <label class="hr-form-label text-muted small">كود الموظف</label>
                                    <p class="fw-bold mb-0 font-monospace">@Model.Code</p>
                                </div>
                                <div class="col-md-6">
                                    <label class="hr-form-label text-muted small">الرقم القومي</label>
                                    <p class="fw-bold mb-0 font-monospace">@(Model.NationalId ?? "—")</p>
                                </div>
                                <div class="col-md-3">
                                    <label class="hr-form-label text-muted small">تاريخ الميلاد</label>
                                    <p class="fw-bold mb-0">
                                        @(Model.DateOfBirth.HasValue
                                            ? Model.DateOfBirth.Value.ToString("yyyy/MM/dd")
                                            : "—")
                                    </p>
                                </div>
                                <div class="col-md-3">
                                    <label class="hr-form-label text-muted small">النوع</label>
                                    <p class="fw-bold mb-0">@(Model.Gender ?? "—")</p>
                                </div>
                                <div class="col-md-6">
                                    <label class="hr-form-label text-muted small">رقم الموبايل</label>
                                    <p class="fw-bold mb-0">@(Model.Phone ?? "—")</p>
                                </div>
                                <div class="col-md-6">
                                    <label class="hr-form-label text-muted small">البريد الإلكتروني</label>
                                    <p class="fw-bold mb-0">@(Model.Email ?? "—")</p>
                                </div>
                                <div class="col-md-6">
                                    <label class="hr-form-label text-muted small">الحالة الاجتماعية</label>
                                    <p class="fw-bold mb-0">@(Model.MaritalStatus ?? "—")</p>
                                </div>
                                <div class="col-md-6">
                                    <label class="hr-form-label text-muted small">العنوان</label>
                                    <p class="fw-bold mb-0">@(Model.Address ?? "—")</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. الوظيفة والدرجة -->
                <div class="tab-pane fade" id="d-job" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="hr-form-label text-muted small">الإدارة التابع لها</label>
                            <p class="fw-bold mb-0">@(Model.OrgUnitName ?? "—")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="hr-form-label text-muted small">المسمى الوظيفي</label>
                            <p class="fw-bold mb-0">@(Model.JobTitleName ?? "—")</p>
                        </div>
                        <div class="col-md-4">
                            <label class="hr-form-label text-muted small">الدرجة المالية</label>
                            <p class="fw-bold mb-0">@(Model.JobGradeName ?? "—")</p>
                        </div>
                        <div class="col-md-4">
                            <label class="hr-form-label text-muted small">نوع الكادر</label>
                            <p class="fw-bold mb-0">@(Model.EmploymentTypeName ?? "—")</p>
                        </div>
                        <div class="col-md-4">
                            <label class="hr-form-label text-muted small">المجموعة الوظيفية</label>
                            <p class="fw-bold mb-0">@(Model.FunctionalGroupName ?? "—")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="hr-form-label text-muted small">تاريخ التعيين</label>
                            <p class="fw-bold mb-0">@Model.HireDate.ToString("yyyy/MM/dd")</p>
                        </div>
                    </div>
                </div>

                <!-- 3. مسوغات التعيين -->
                <div class="tab-pane fade" id="d-files" role="tabpanel">
                    <div class="row g-4">
                        @{
                            void FileRow(string label, string? path)
                            {
                                <div class="col-md-6">
                                    <label class="hr-form-label text-muted small">@label</label>
                                    @if (!string.IsNullOrEmpty(path))
                                    {
                                        <div>
                                            <a href="@path" target="_blank"
                                               class="hr-btn hr-btn-outline btn-sm">
                                                <i class="fas fa-eye"></i> عرض الملف
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0 small">لم يُرفع بعد</p>
                                    }
                                </div>
                            }
                        }
                        @{
                            FileRow("الصورة الشخصية", Model.PersonalPhoto);
                        }
                        @{
                            FileRow("بطاقة الرقم القومي", Model.NationalIdCardFront);
                        }
                        @{
                            FileRow("المؤهل الدراسي", Model.QualificationFile);
                        }
                        @{
                            FileRow("شهادة الميلاد", Model.BirthCertificateFile);
                        }
                        @{
                            FileRow("الموقف من التجنيد", Model.MilitaryFile);
                        }
                        @{
                            FileRow("قرار التعيين / العقد", Model.ContractFile);
                        }
                        @{
                            FileRow("الفيش الجنائي", Model.PoliceClearanceCertificate);
                        }
                    </div>
                </div>

                <!-- 4. البيانات المالية -->
                <div class="tab-pane fade" id="d-financial" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="hr-form-label text-muted small">الرقم التأميني</label>
                            <p class="fw-bold mb-0 font-monospace">@(Model.InsuranceNumber ?? "—")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="hr-form-label text-muted small">رقم الحساب البنكي</label>
                            <p class="fw-bold mb-0 font-monospace">@(Model.BankAccount ?? "—")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="hr-form-label text-muted small">البنك</label>
                            <p class="fw-bold mb-0">@(Model.BankName ?? "—")</p>
                        </div>
                        <div class="col-md-3">
                            <label class="hr-form-label text-muted small">إجمالي الاستحقاق</label>
                            <p class="fw-bold mb-0">
                                @if (Model.GrossSalary.HasValue)
                                {
                                    <span class="font-monospace">@($"{Model.GrossSalary.Value:N2} جم")</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }                                
                            </p>
                        </div>
                        <div class="col-md-6">
                            <label class="hr-form-label text-muted small">صندوق الزمالة</label>
                            <p class="fw-bold mb-0">
                                @if (Model.HasFellowshipFund)
                                {
                                    <span class="badge bg-success">مشترك</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">غير مشترك</span>
                                }
                            </p>
                        </div>
                        <div class="col-md-6">
                            <label class="hr-form-label text-muted small">صندوق التكافل الصحي</label>
                            <p class="fw-bold mb-0">
                                @if (Model.HasMedicalFund)
                                {
                                    <span class="badge bg-success">مشترك</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">غير مشترك</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>