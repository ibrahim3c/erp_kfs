@model HR.Application.Employees.GetEmployeeForDelete.GetEmployeeForDeleteResponse

@{
    ViewData["Title"] = "حذف موظف";
}

<link rel="stylesheet" href="~/css/global/hr-custom.css" asp-append-version="true">

<div class="hr-page-container animate__animated animate__fadeIn">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h5 font-weight-bold text-dark mb-1">حذف موظف</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent p-0 small mb-0">
                    <li class="breadcrumb-item"><a asp-action="Index">سجل الموظفين</a></li>
                    <li class="breadcrumb-item active">حذف</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="hr-card" style="max-width: 600px; margin: 0 auto;">
        <div class="p-5 text-center">

            <div class="mb-4">
                <div class="rounded-circle bg-danger bg-opacity-10 d-inline-flex
                    align-items-center justify-content-center"
                     style="width:80px; height:80px;">
                    <i class="fas fa-exclamation-triangle text-danger"
                       style="font-size: 2rem;"></i>
                </div>
            </div>

            <h4 class="font-weight-bold text-dark mb-2">تأكيد الحذف</h4>
            <p class="text-muted mb-4">
                هل أنت متأكد من حذف ملف الموظف التالي؟
                هذا الإجراء <strong class="text-danger">لا يمكن التراجع عنه</strong>.
            </p>

            <div class="hr-card bg-light border-0 p-4 mb-4 text-start">
                <div class="row g-2">
                    <div class="col-6">
                        <small class="text-muted d-block">الاسم</small>
                        <strong>@Model.Name</strong>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">كود الموظف</small>
                        <strong class="font-monospace">@Model.Code</strong>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <div class="col-12 mt-2">
                            <small class="text-muted d-block">البريد الإلكتروني</small>
                            <strong>@Model.Email</strong>
                        </div>
                    }
                </div>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="d-flex justify-content-center gap-3">
                    <a asp-action="Index" class="hr-btn hr-btn-outline px-4">
                        <i class="fas fa-times"></i> إلغاء
                    </a>
                    <button type="submit" class="hr-btn px-4"
                            style="background-color: var(--bs-danger); color: #fff; border: none;">
                        <i class="fas fa-trash"></i> نعم، احذف الملف
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>