@using HR.Application.Secondments.Query.GetEmployeesForSelect
@using HR.Application.Terminations.Query.List
@model TerminationsResult
@{
    ViewData["Title"] = "قرارات إنهاء الخدمة والفصل";
    var employees = ViewBag.Employees as List<EmployeeSelectDto> ?? new();
}

<link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark"><i class="fas fa-user-times text-danger me-2"></i> إنهاء الخدمة والفصل</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">HR</a></li>
                    <li class="breadcrumb-item active">إنهاء الخدمة</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-1"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- إحصائيات الأسباب -->
        <div class="row">
            <div class="col-md-3 col-6">
                <div class="small-box bg-white">
                    <div class="inner">
                        <h3>@Model.ResignationCount</h3>
                        <p>استقالات (بناءً على طلبهم)</p>
                    </div>
                    <div class="icon"><i class="fas fa-walking text-warning"></i></div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="small-box bg-white">
                    <div class="inner">
                        <h3 class="text-danger">@Model.DismissalCount</h3>
                        <p class="text-danger fw-bold">فصل تأديبي / حكم قضائي</p>
                    </div>
                    <div class="icon"><i class="fas fa-gavel text-danger"></i></div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="small-box bg-white">
                    <div class="inner">
                        <h3>@Model.AbsenceCount</h3>
                        <p>انقطاع عن العمل (غياب)</p>
                    </div>
                    <div class="icon"><i class="fas fa-user-clock text-secondary"></i></div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="small-box bg-white">
                    <div class="inner">
                        <h3>@Model.DeathCount</h3>
                        <p>وفاة أثناء الخدمة</p>
                    </div>
                    <div class="icon"><i class="fas fa-procedures text-dark"></i></div>
                </div>
            </div>
        </div>

        <!-- جدول القرارات -->
        <div class="card card-outline card-danger">
            <div class="card-header border-0">
                <h3 class="card-title text-bold">سجل القرارات التنفيذية</h3>
                <div class="card-tools">
                    <button class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#terminateModal">
                        <i class="fas fa-ban me-1"></i> تسجيل قرار إنهاء خدمة
                    </button>
                </div>
            </div>

            <div class="card-body">
                <table id="termTable" class="table table-bordered table-striped text-center align-middle">
                    <thead class="bg-secondary text-white">
                        <tr>
                            <th>رقم القرار</th>
                            <th>الموظف</th>
                            <th>سبب الإنهاء</th>
                            <th>تاريخ القرار</th>
                            <th>تاريخ آخر يوم عمل</th>
                            <th>المرفق</th>
                            <th>حالة النظام</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int attachCounter = 0;
                        }
                        @foreach (var t in Model.Decisions)
                        {
                            var reasonText = t.Reason switch
                            {
                                "Resignation" => "استقالة",
                                "Dismissal" => "فصل (تأديبي / قضائي)",
                                "Absence" => "فصل (انقطاع عمل)",
                                "Death" => "الوفاة",
                                "Medical" => "عدم اللياقة الصحية (عجز)",
                                "Contract" => "انتهاء مدة العقد",
                                _ => t.Reason
                            };
                            var reasonClass = t.Reason switch
                            {
                                "Dismissal" or "Absence" => "bg-danger",
                                "Death" => "bg-dark",
                                "Medical" => "bg-info text-dark",
                                _ => "bg-warning text-dark"
                            };
                            var isSevere = t.Reason is "Dismissal" or "Absence";

                            attachCounter++;
                            string attachModalId = $"attachModal_{attachCounter}";
                            string attachExt = !string.IsNullOrEmpty(t.AttachmentPath) ? System.IO.Path.GetExtension(t.AttachmentPath).ToLower() : "";
                            bool attachIsImage = attachExt is ".jpg" or ".jpeg" or ".png" or ".webp" or ".jfif" or ".gif";
                            string attachSrc = !string.IsNullOrEmpty(t.AttachmentPath)
                                ? (t.AttachmentPath.StartsWith("/") ? t.AttachmentPath : "/" + t.AttachmentPath)
                                : "";

                            <tr class="@(isSevere ? "bg-white" : "")" style="@(isSevere ? "border-left: 5px solid #dc3545;" : "")">
                                <td class="fw-bold @(isSevere ? "text-danger" : "")">@t.DecisionNumber</td>
                                <td class="text-end fw-bold">@t.EmployeeName</td>
                                <td><span class="badge @reasonClass p-2">@reasonText</span></td>
                                <td>@t.DecisionDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-danger fw-bold">@t.LastWorkingDay.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(t.AttachmentPath))
                                    {
                                        if (attachIsImage)
                                        {
                                            <button type="button" class="btn btn-sm btn-link p-0" data-bs-toggle="modal" data-bs-target="#@attachModalId" title="عرض المرفق">
                                                <i class="fas fa-thumbtack text-primary"></i>
                                            </button>

                                            <!-- Modal لعرض الصورة -->
                                            <div class="modal fade" id="@attachModalId" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-lg modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h6 class="modal-title">مرفق القرار @t.DecisionNumber</h6>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body text-center">
                                                            <img src="@attachSrc" class="img-fluid rounded-3" alt="مرفق" />
                                                        </div>
                                                        <div class="modal-footer">
                                                            <a href="@attachSrc" target="_blank" class="btn btn-outline-secondary btn-sm">
                                                                <i class="fas fa-external-link-alt"></i> فتح في تاب جديد
                                                            </a>
                                                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">إغلاق</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <a href="@attachSrc" target="_blank" title="عرض المرفق"><i class="fas fa-thumbtack text-danger"></i></a>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    @if (t.Status == "Executed")
                                    {
                                        <span class="badge bg-danger">موقوف</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">ملغى</span>
                                    }
                                </td>
                               <td>
                                <div class="btn-group" role="group">

                                    <!-- تفاصيل -->
                                    <a asp-action="Details"
                                       asp-route-id="@t.Id"
                                       class="btn btn-sm btn-outline-info me-2"
                                       title="عرض التفاصيل">
                                        <i class="fas fa-eye"></i>
                                    </a>

                                    

                                    @if (t.Status == "Executed")
                                    {
                                        <!-- إلغاء القرار -->
                                        <button type="button"
                                                class="btn btn-sm btn-outline-dark me-2"
                                                data-bs-toggle="modal"
                                                data-bs-target="#cancelModal-@t.Id"
                                                title="إلغاء القرار">
                                            <i class="fas fa-undo"></i>
                                        </button>
                                    }

                                </div>

                                @if (t.Status == "Executed")
                                {
                                    <div class="modal fade" id="cancelModal-@t.Id" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <form asp-action="Cancel" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="terminationId" value="@t.Id" />

                                                    <div class="modal-header">
                                                        <h5 class="modal-title">سبب إلغاء قرار الإنهاء</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>

                                                    <div class="modal-body">
                                                        <p class="text-muted small">
                                                            سيتم إعادة تفعيل الموظف تلقائيًا في النظام.
                                                        </p>

                                                        <textarea class="form-control"
                                                                  name="cancellationReason"
                                                                  rows="3"
                                                                  required
                                                                  placeholder="اكتب سبب الإلغاء..."></textarea>
                                                    </div>

                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                            تراجع
                                                        </button>
                                                        <button type="submit" class="btn btn-warning">
                                                            تأكيد الإلغاء
                                                        </button>
                                                    </div>

                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                                
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>

<!-- Modal: تسجيل قرار إنهاء -->
<div class="modal fade" id="terminateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-file-excel me-2"></i> قرار إنهاء خدمة (خروج من الخدمة)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="CreateDecision" enctype="multipart/form-data" id="terminateForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="alert alert-warning text-sm">
                        <i class="fas fa-exclamation-triangle me-1"></i> <strong>تحذير:</strong> هذا الإجراء سيؤدي إلى إيقاف راتب الموظف وإغلاق حسابه على النظام نهائياً، وتحويل ملفه للأرشيف.
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">الموظف</label>
                            <select class="form-select" name="employeeId" required>
                                <option value="">-- اختر الموظف --</option>
                                @foreach (var emp in employees)
                                {
                                    <option value="@emp.Id">@emp.Name — @emp.JobTitle</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">سبب الإنهاء</label>
                            <select class="form-select border-danger text-danger fw-bold" name="reason" id="reasonSelect" onchange="checkReason()" required>
                                <option value="Resignation">استقالة مكتوبة</option>
                                <option value="Dismissal">فصل (تأديبي / قضائي)</option>
                                <option value="Absence">فصل للانقطاع (غياب متصل/منفصل)</option>
                                <option value="Death">الوفاة</option>
                                <option value="Medical">عدم اللياقة الصحية (عجز كلي)</option>
                                <option value="Contract">انتهاء مدة العقد (عدم التجديد)</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label">رقم القرار التنفيذي</label>
                            <input type="text" class="form-control" name="decisionNumber" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">تاريخ صدور القرار</label>
                            <input type="date" class="form-control" name="decisionDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label text-danger">تاريخ آخر يوم عمل (فعلي)</label>
                            <input type="date" class="form-control" name="lastWorkingDay" required>
                            <small class="text-danger">يتوقف الراتب بعد هذا اليوم.</small>
                        </div>

                        <div class="col-md-12 mb-3">
                            <label class="form-label">السند القانوني / الحيثيات</label>
                            <textarea class="form-control" name="legalBasis" rows="2" placeholder="بناءً على الحكم رقم... / بناءً على طلب الموظف المقدم بتاريخ..."></textarea>
                        </div>

                        <div class="col-md-12 mb-3">
                            <label class="form-label">المرفق (PDF أو صورة)</label>
                            <input type="file" class="form-control" name="attachmentFile" accept=".pdf,.jpg,.jpeg,.png">
                            <small class="text-muted" id="attachHint">(مطلوب: أصل الاستقالة + إخلاء الطرف)</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light justify-content-between">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="button" class="btn btn-danger" onclick="confirmTerminate()">
                        <i class="fas fa-ban me-1"></i> اعتماد وتنفيذ الإيقاف
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>

<script>
    $(function () {
        $("#termTable").DataTable({
            "language": { "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Arabic.json" },
            "lengthChange": false,
            "autoWidth": false
        });
    });

    function checkReason() {
        var reason = document.getElementById("reasonSelect").value;
        var hint = document.getElementById("attachHint");

        if (reason === "Death") {
            hint.innerText = "(مطلوب: شهادة الوفاة + إعلام الوراثة إن وجد)";
        } else if (reason === "Dismissal") {
            hint.innerText = "(مطلوب: منطوق الحكم القضائي أو قرار الجزاء)";
        } else if (reason === "Resignation") {
            hint.innerText = "(مطلوب: طلب الاستقالة الموقع + إخلاء الطرف)";
        } else {
            hint.innerText = "";
        }
    }

    // تأكيد أخير قبل التنفيذ - Form عادي، بيتعمله submit فعلي بعد التأكيد
    function confirmTerminate() {
        var form = document.getElementById("terminateForm");

        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        var confirmed = confirm("تحذير شديد!\n\nأنت على وشك إنهاء خدمة موظف من النظام. لن يتم صرف أي رواتب له بعد الآن.\n\nهل أنت متأكد؟");

        if (confirmed) {
            form.submit();
        }
    }
</script>