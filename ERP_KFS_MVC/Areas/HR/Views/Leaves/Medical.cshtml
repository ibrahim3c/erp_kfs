@model ERP_KFS_MVC.Areas.HR.ViewModels.LeavePageViewModel
@{
    ViewData["Title"] = "الأجازات المرضية واللجان الطبية";
}

<!-- DataTables & Select2 CSS -->
<link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
<link rel="stylesheet" href="~/plugins/select2/css/select2.min.css">
<link rel="stylesheet" href="~/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css">

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">الأجازات المرضية (قومسيون / مستشفيات)</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">الأجازات</a></li>
                    <li class="breadcrumb-item active">أجازات مرضية</li>
                </ol>
            </div>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section class="content">
    <div class="container-fluid">

        <!-- 1. نموذج تسجيل أجازة مرضية -->
        <div class="card card-danger card-outline collapsed-card">
            <div class="card-header">
                <h3 class="card-title text-danger"><i class="fas fa-file-medical-alt me-2"></i> تسجيل قرار لجنة طبية / تقرير مستشفى</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-plus"></i></button>
                </div>
            </div>
            <div class="card-body">
                <form method="post" asp-action="CreateMedicalRequest" asp-antiforgery="true" enctype="multipart/form-data">
                    <div class="row">
                        <!-- بيانات الموظف -->
                        <div class="col-md-4 mb-3">
                            <label class="form-label">الموظف المريض</label>
                            <select name="employeeId" class="form-select select2-medical" style="width:100%" required>
                                <option value="">-- اختر موظف --</option>
                                @if (ViewBag.Employees is IEnumerable<HR.Application.Employees.GetAllEmployees.EmployeeListResponse> employees)
                                {
                                    @foreach (var emp in employees)
                                    {
                                        <option value="@emp.Id">@emp.Name (@emp.Code)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">جهة التقرير الطبي</label>
                            <select name="reportAuthority" class="form-select" required>
                                <option value="اللجنة الطبية العامة (القومسيون)">اللجنة الطبية العامة (القومسيون)</option>
                                <option value="التأمين الصحي">التأمين الصحي</option>
                                <option value="مستشفى حكومي (دخول طوارئ)">مستشفى حكومي (دخول طوارئ)</option>
                                <option value="عيادة خاصة (تحتاج اعتماد)">عيادة خاصة (تحتاج اعتماد)</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">رقم قرار اللجنة</label>
                            <input type="text" name="decisionNumber" class="form-control" placeholder="رقم وتاريخ...">
                        </div>

                        <!-- التواريخ -->
                        <div class="col-md-3 mb-3">
                            <label class="form-label">تاريخ الكشف (البدء)</label>
                            <input type="date" name="startDate" class="form-control" id="startMedicalDate" onchange="calcMedical()" required>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">حتى تاريخ</label>
                            <input type="date" name="endDate" class="form-control" id="endMedicalDate" onchange="calcMedical()" required>
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label">عدد الأيام</label>
                            <input type="text" class="form-control bg-light" id="medicalDays" readonly>
                        </div>

                        <!-- نسبة استحقاق الراتب -->
                        <div class="col-md-4 mb-3">
                            <label class="form-label">نسبة استحقاق الراتب</label>
                            <select name="payPercentage" class="form-select text-danger fw-bold" required>
                                <option value="100">أجر كامل (مرض عادي / عمليات)</option>
                                <option value="100">أجر كامل (مرض مزمن)</option>
                                <option value="75">75% من الأجر</option>
                                <option value="0">بدون أجر (تجاوز المدة)</option>
                            </select>
                            <small class="text-muted">تحدد وفقاً لقرار اللجنة وقانون الخدمة المدنية.</small>
                        </div>

                        <!-- التشخيص -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">التشخيص المبدئي</label>
                            <input type="text" name="diagnosis" class="form-control" placeholder="مثال: إجراء عملية جراحية...">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">مرفق التقرير / صورة قرار اللجنة</label>
                            <input type="file" name="attachment" class="form-control">
                        </div>

                        <div class="col-12 border-top pt-2">
                            <button type="submit" class="btn btn-danger"><i class="fas fa-save me-1"></i> حفظ وتسكين الأجازة</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- 2. أرشيف الحالات المرضية -->
        <div class="card">
            <div class="card-header border-0">
                <h3 class="card-title text-bold">سجل الحالات المرضية السارية والمنتهية</h3>
            </div>
            <div class="card-body">
                <table id="medicalTable" class="table table-bordered table-striped text-center">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>م</th>
                            <th>الموظف</th>
                            <th>التشخيص / السبب</th>
                            <th>من تاريخ</th>
                            <th>إلى تاريخ</th>
                            <th>المدة</th>
                            <th>نسبة الأجر</th>
                            <th>المرفق</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var medIndex = 0; }
                        @foreach (var req in Model.MedicalRequests)
                        {
                            medIndex++;
                            <tr>
                                <td>@medIndex</td>
                                <td class="text-end font-weight-bold">@req.EmployeeName</td>
                                <td>@(req.Diagnosis ?? "--")</td>
                                <td>@req.StartDate.ToString("dd/MM/yyyy")</td>
                                <td>@req.EndDate.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-info text-dark">@req.DurationDays يوم</span></td>
                                @if (req.PayPercentage >= 100)
                                {
                                    <td><span class="badge bg-success">100% (أجر كامل)</span></td>
                                }
                                else if (req.PayPercentage > 0)
                                {
                                    <td><span class="badge bg-warning text-dark">@req.PayPercentage%</span></td>
                                }
                                else
                                {
                                    <td><span class="badge bg-danger">بدون أجر</span></td>
                                }
                                <td>
                                    @if (!string.IsNullOrEmpty(req.AttachmentPath))
                                    {
                                        <a href="~/@req.AttachmentPath" target="_blank"><i class="fas fa-file-medical text-danger"></i></a>
                                    }
                                    else
                                    {
                                        <i class="fas fa-paperclip text-secondary"></i>
                                    }
                                </td>
                                @if (req.Status == "Approved" || req.Status == "معتمدة")
                                {
                                    <td><span class="badge bg-success">معتمدة</span></td>
                                }
                                else if (req.Status == "Pending" || req.Status == "قيد الموافقة")
                                {
                                    <td><span class="badge bg-primary">جديدة</span></td>
                                }
                                else if (req.Status == "Rejected" || req.Status == "مرفوضة")
                                {
                                    <td><span class="badge bg-danger">مرفوضة</span></td>
                                }
                                else
                                {
                                    <td><span class="badge bg-secondary">@req.Status</span></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>

<script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="~/plugins/select2/js/select2.full.min.js"></script>

<script>
    $(function () {
        $('.select2-medical').select2({
            theme: 'bootstrap4'
        });

        $("#medicalTable").DataTable({
            "language": { "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Arabic.json" },
            "autoWidth": false
        });
    });

    function calcMedical() {
        var d1 = new Date(document.getElementById("startMedicalDate").value);
        var d2 = new Date(document.getElementById("endMedicalDate").value);
        if(d1 && d2){
            var diff = (d2.getTime() - d1.getTime()) / (1000 * 3600 * 24);
            document.getElementById("medicalDays").value = (diff + 1) + " يوم";
        }
    }
</script>
