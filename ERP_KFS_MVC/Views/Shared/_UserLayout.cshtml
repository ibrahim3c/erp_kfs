<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - المنصة الرقمية الموحدة</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.rtlcss.com/bootstrap/v4.5.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />

    <style>
            /* ── Base ── */
            body {
                font-family: 'Cairo', sans-serif !important;
                background-color: #f0f4f8;
                text-align: right;
            }

            /* ── Sidebar ── */
            [dir="rtl"] .main-sidebar {
                right: 0 !important;
                left: auto !important;
                background: linear-gradient(180deg, #0d2535 0%, #0a1e2d 100%) !important;
                border-left: 1px solid rgba(255,255,255,0.05);
                box-shadow: none;
            }

            .main-sidebar .brand-link {
                border-bottom: 1px solid rgba(255,255,255,0.07) !important;
                padding: 12px 16px !important;
                background: rgba(0,0,0,0.15);
            }

            /* التعديل هنا: تقليل المسافات بين الروابط */
            .main-sidebar .nav-sidebar .nav-link {
                border-radius: 6px !important;
                margin: 2px 8px !important; /* تقليل الهوامش الجانبية والعمودية */
                padding: 6px 12px !important; /* تقليل المسافة الداخلية (الطول) */
                color: rgba(180,200,215,0.85) !important;
                transition: all 0.2s ease;
                font-weight: 500;
                font-size: 0.9rem;
                display: flex;
                align-items: center; /* توسيط النص مع الأيقونة */
            }

                .main-sidebar .nav-sidebar .nav-link p {
                    margin: 0 !important; /* إلغاء أي هوامش إضافية من باراجراف AdminLTE */
                    line-height: 1.4;
                }

                /* التعديل هنا: تقريب الأيقونة من النص */
                .main-sidebar .nav-sidebar .nav-link .nav-icon {
                    color: rgba(0,180,200,0.6) !important;
                    margin-left: 6px !important; /* تقريب الأيقونة من الكلام */
                    font-size: 0.9rem;
                }

                .main-sidebar .nav-sidebar .nav-link.active,
                .main-sidebar .nav-sidebar .nav-link:hover {
                    background: rgba(0,164,180,0.15) !important;
                    color: #ffffff !important;
                }

                    .main-sidebar .nav-sidebar .nav-link.active .nav-icon,
                    .main-sidebar .nav-sidebar .nav-link:hover .nav-icon {
                        color: #00c9d8 !important;
                    }

                .main-sidebar .nav-sidebar .nav-link.active {
                    font-weight: 600;
                    border-right: 3px solid #00c9d8;
                }

            /* التعديل هنا: تصغير مساحة العناوين الجانبية */
            .nav-header {
                color: rgba(255,255,255,0.3) !important;
                font-size: 0.7rem !important;
                letter-spacing: 0.05em;
                padding: 10px 16px 4px !important; /* تقليل المسافة فوق وتحت العنوان */
                text-transform: uppercase;
                margin-top: 4px;
            }

            /* القوائم الفرعية (Sub-menus) */
            .nav-treeview .nav-link {
                padding: 5px 24px 5px 12px !important; /* مسافة أقل للقوائم الفرعية */
                font-size: 0.85rem !important;
            }

            /* ── Navbar ── */
            .main-header.navbar {
                background: #ffffff !important;
                border-bottom: 1px solid #e8edf2 !important;
                min-height: 60px;
                padding: 0 20px;
                box-shadow: 0 1px 8px rgba(0,0,0,0.06);
            }

            .main-header .navbar-nav .nav-link {
                color: #4a5568 !important;
            }

                .main-header .navbar-nav .nav-link:hover {
                    color: #007c92 !important;
                }

            .navbar-system-title {
                font-size: 0.92rem;
                font-weight: 700;
                color: #1e293b;
                letter-spacing: -0.01em;
            }

            /* date chip */
            .date-chip {
                display: flex;
                align-items: center;
                gap: 6px;
                background: #f0f9fa;
                border: 1px solid #c8eaee;
                color: #006478;
                font-weight: 600;
                border-radius: 8px;
                padding: 5px 12px;
                font-size: 0.82rem;
            }

                .date-chip i {
                    color: #007c92;
                    font-size: 0.8rem;
                }

            /* logout button */
            .btn-logout {
                display: flex;
                align-items: center;
                gap: 6px;
                background: #fff0f0;
                color: #c0392b !important;
                border: 1px solid #f5c6c6;
                border-radius: 8px;
                font-weight: 600;
                font-size: 0.82rem;
                padding: 5px 14px;
                transition: all 0.2s;
            }

                .btn-logout:hover {
                    background: #ffe0e0;
                    border-color: #e57373;
                }

            /* ── Page Header Banner ── */
            .page-header-banner {
                display: flex;
                align-items: center;
                justify-content: space-between;
                background: #ffffff;
                border-bottom: 1px solid #e8edf2;
                padding: 18px 28px;
                margin-bottom: 0;
                position: relative;
                overflow: hidden;
            }

                .page-header-banner::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    right: 0;
                    width: 260px;
                    height: 100%;
                    background: linear-gradient(135deg, rgba(0,124,146,0.04) 0%, transparent 60%);
                    pointer-events: none;
                }

            .phb-text h1 {
                font-size: 1.3rem;
                font-weight: 800;
                color: #0f172a;
                margin: 0 0 3px;
                letter-spacing: -0.02em;
            }

            .phb-text p {
                font-size: 0.8rem;
                color: #94a3b8;
                margin: 0;
                font-weight: 400;
            }

            .phb-logo {
                width: 54px;
                height: 54px;
                background: #f0f9fa;
                border: 1.5px solid #c8eaee;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

                .phb-logo img {
                    width: 38px;
                    height: 38px;
                    object-fit: contain;
                }

            /* ── Content wrapper ── */
            [dir="rtl"] .content-wrapper,
            [dir="rtl"] .main-footer,
            [dir="rtl"] .main-header {
                margin-right: 250px !important;
                margin-left: 0 !important;
                transition: margin-right .3s ease-in-out;
            }

            body.sidebar-collapse[dir="rtl"] .content-wrapper,
            body.sidebar-collapse[dir="rtl"] .main-header,
            body.sidebar-collapse[dir="rtl"] .main-footer {
                margin-right: 4.6rem !important;
            }

            .content-wrapper {
                background: #f0f4f8 !important;
            }

            /* ── Alerts ── */
            .alert-float {
                margin: 16px 24px 0;
                border-radius: 10px;
                border: none;
                font-size: 0.88rem;
                font-weight: 500;
                box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            }

            /* ── Footer ── */
            .main-footer {
                background: #ffffff !important;
                border-top: 1px solid #e8edf2 !important;
                padding: 12px 24px;
                font-size: 0.78rem;
                color: #94a3b8;
            }

            /* ── Breadcrumb ── */
            .content-header {
                padding: 20px 24px 8px;
            }

            .breadcrumb {
                background: transparent;
                padding: 0;
                margin: 0;
                font-size: 0.78rem;
            }

            .breadcrumb-item a {
                color: #007c92;
            }

            .breadcrumb-item.active {
                color: #94a3b8;
            }

            .breadcrumb-item + .breadcrumb-item::before {
                color: #cbd5e1;
            }

            .content-header h1 {
                font-size: 1.15rem;
                font-weight: 700;
                color: #1e293b;
            }

            @@media (max-width: 768px) {
                [dir="rtl"] .content-wrapper,
                [dir="rtl"] .main-header,
                [dir="rtl"] .main-footer {
                    margin-right: 0 !important;
                }

                .page-header-banner {
                    padding: 14px 16px;
                }

                .phb-text h1 {
                    font-size: 1.05rem;
                }
            }
    </style>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">

        <nav class="main-header navbar navbar-expand shadow-sm">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link px-3" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars" style="font-size:1rem;"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-flex align-items-center" style="border-right:1px solid #e8edf2; padding-right:16px; margin-right:4px;">
                    <span class="navbar-system-title">نظام إدارة المؤسسة الموحد</span>
                </li>
            </ul>

            <ul class="navbar-nav mr-auto align-items-center" style="gap:10px;">
                <li class="nav-item d-none d-md-flex">
                    <div class="date-chip">
                        <i class="far fa-calendar-alt"></i>
                        <span>@DateTime.Now.ToString("yyyy/MM/dd")</span>
                    </div>
                </li>
                <li class="nav-item">
                    <form asp-controller="Accounts" asp-action="Logout" asp-area="Admin" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-logout">
                            <i class="fas fa-power-off" style="font-size:0.78rem;"></i>
                            <span>تسجيل الخروج</span>
                        </button>
                    </form>
                </li>
            </ul>
        </nav>

        @await Component.InvokeAsync("EmployeeSidebar")

        <div class="content-wrapper">

            <div class="page-header-banner">
                <div class="phb-text">
                    <h1>نظام إدارة المؤسسة الموحد</h1>
                    <p>ديوان عام محافظة كفر الشيخ &mdash; قطاع التحول الرقمي وتكنولوجيا المعلومات</p>
                </div>
                <div class="phb-logo">
                    <img src="~/image/kfs-logo (2).png" alt="شعار المحافظة" />
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-float alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle ml-2"></i> @TempData["Success"]
                    <button type="button" class="close" data-dismiss="alert" style="outline:none;">
                        <span>&times;</span>
                    </button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-float alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle ml-2"></i> @TempData["Error"]
                    <button type="button" class="close" data-dismiss="alert" style="outline:none;">
                        <span>&times;</span>
                    </button>
                </div>
            }

            <section class="content">
                <div class="container-fluid px-3 pb-4">
                    @RenderBody()
                </div>
            </section>

        </div>

        <footer class="main-footer text-center">
            كافة الحقوق محفوظة &copy; @DateTime.Now.Year &mdash; ديوان عام محافظة كفر الشيخ &mdash; قطاع النظم والتطبيقات
        </footer>

    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();

        setTimeout(function () {
        $('.alert-float').slideUp(500, function () { $(this).remove(); });
        }, 4500);

        if ($.fn.select2) {
        $('.select2').select2({ dir: "rtl", width: '100%' });
        }

        var currentPath = window.location.pathname;
        $('.nav-sidebar .nav-link').each(function () {
        var linkPath = $(this).attr('href');
        if (linkPath && currentPath.indexOf(linkPath) === 0 && linkPath !== "/") {
        $(this).addClass('active');
        $(this).parents('.nav-item').addClass('menu-open');
        $(this).parents('.nav-treeview').show();
        }
        });
        if (currentPath === "/" || currentPath.toLowerCase() === "/home") {
        $('.nav-sidebar .nav-link[href="/"]').addClass('active');
        }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>