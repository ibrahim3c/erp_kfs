<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - المنصة الرقمية الموحدة</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.rtlcss.com/bootstrap/v4.6.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">

    <style>
        :root {
            --dark-navbar: #0f172a;
        }

        body {
            font-family: 'Cairo', sans-serif !important;
            background-color: #f4f6f9;
        }

        .main-header-custom {
            background: var(--dark-navbar) !important;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            height: 62px;
            z-index: 1040;
        }

        .main-sidebar {
            top: 62px !important;
            height: calc(100vh - 62px) !important;
            position: fixed !important;
            background: var(--dark-navbar) !important;
        }

        .sidebar {
            height: calc(100% - 10px) !important;
            overflow-y: auto;
        }

        .content-wrapper {
            margin-top: 0 !important;
            padding-top: 20px;
        }

        .btn-login-style {
            background: transparent;
            border: 1px solid #3b82f6;
            border-radius: 8px;
            color: #3b82f6;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .btn-login-style:hover {
            background: #3b82f6 !important;
            color: #fff !important;
            box-shadow: 0 0 15px rgba(59, 130, 246, 0.4);
        }

        .btn-logout-style {
            background: transparent;
            border: 1px solid rgba(239, 68, 68, 0.7);
            border-radius: 8px;
            color: #ef4444 !important;
            font-weight: 700;
            transition: all 0.3s ease;
            padding: 0.25rem 1rem;
        }

        .btn-logout-style:hover {
            background: #ef4444 !important;
            color: #fff !important;
            box-shadow: 0 0 15px rgba(239, 68, 68, 0.4);
            border-color: #ef4444;
        }

        .small-box {
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            overflow: hidden;
            margin-bottom: 25px;
        }

        .small-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.15);
        }

        .small-box .icon > i {
            right: auto !important;
            left: 15px !important;
        }

        .main-footer-custom {
            background: var(--dark-navbar) !important;
            border-top: 1px solid rgba(255,255,255,0.1) !important;
            padding: 1.2rem 0;
            color: #fff;
        }
    </style>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">

        <nav class="navbar sticky-top shadow-sm main-header-custom px-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <a class="nav-link text-white p-2 rounded-3" data-widget="pushmenu" href="#" role="button" title="فتح/غلق القائمة">
                    <i class="fas fa-bars fs-5"></i>
                </a>
                <div class="navbar-brand d-flex align-items-center m-0" style="cursor: default;">
                    <img src="~/image/kfs-logo (2).png" style="height: 42px; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.3);" alt="شعار المحافظة">
                    <div class="d-flex flex-column me-3 d-none d-md-flex" style="gap: 2px;">
                        <span style="color: #fff; font-weight: 800; font-size: 1.1rem; line-height: 1;">الإدارة المركزية</span>
                        <small style="color: rgba(255,255,255,0.7); font-size: 0.75rem;">محافظة كفر الشيخ</small>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a class="nav-link text-white opacity-75 hover-opacity-100 d-none d-sm-block ms-2" data-widget="fullscreen" href="#" role="button" title="تكبير الشاشة">
                    <i class="fas fa-expand-arrows-alt fs-5"></i>
                </a>

                <a asp-controller="Home" asp-action="Index" class="btn btn-login-style ms-2 d-flex align-items-center gap-2 px-3 py-1">
                    <i class="fa-solid fa-house-user"></i>
                    <span class="d-none d-sm-inline">الرئيسية</span>
                </a>

                <form asp-controller="Account" asp-action="Logout" asp-area="Admin"
                      method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-logout-style ms-2 d-flex align-items-center gap-2 py-1">
                        <i class="fa-solid fa-power-off"></i>
                        <span class="d-none d-sm-inline">خروج</span>
                    </button>
                </form>
            </div>
        </nav>

        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <div class="sidebar p-0 mt-2">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="nav-link @((ViewContext.RouteData.Values["area"]?.ToString() == "Admin" && ViewContext.RouteData.Values["controller"]?.ToString() == "Home") ? "active" : "")">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>لوحة التحكم الرئيسية</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link text-warning">
                                <i class="nav-icon fas fa-user-shield"></i>
                                <p>الأمان والمستخدمين <i class="right fas fa-angle-left"></i></p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="Identity" asp-controller="Users" asp-action="Index" class="nav-link">
                                        <i class="fas fa-users nav-icon"></i>
                                        <p>إدارة المستخدمين</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Identity" asp-controller="Roles" asp-action="Index" class="nav-link">
                                        <i class="fas fa-key nav-icon"></i>
                                        <p>الأدوار والصلاحيات</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-sitemap"></i>
                                <p>الهيكل التنظيمي <i class="fas fa-angle-left right"></i></p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="Organization" asp-controller="OrgUnitTypes" asp-action="Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>أنواع الوحدات</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Organization" asp-controller="OrgUnits" asp-action="Index" class="nav-link">
                                        <i class="far fa-building nav-icon"></i>
                                        <p>الوحدات الإدارية</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Organization" asp-controller="LeadershipPositions" asp-action="Index" class="nav-link">
                                        <i class="fas fa-user-tie nav-icon"></i>
                                        <p>القيادات</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-database"></i>
                                <p>البيانات الجغرافية <i class="fas fa-angle-left right"></i></p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="Geography" asp-controller="Governorates" asp-action="Index" class="nav-link">
                                        <i class="fas fa-map nav-icon"></i>
                                        <p>المحافظات</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Geography" asp-controller="CityCenters" asp-action="Index" class="nav-link">
                                        <i class="fas fa-city nav-icon"></i>
                                        <p>المراكز</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Geography" asp-controller="LocalUnits" asp-action="Index" class="nav-link">
                                        <i class="fas fa-landmark nav-icon"></i>
                                        <p>الوحدات المحلية</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Geography" asp-controller="Villages" asp-action="Index" class="nav-link">
                                        <i class="fas fa-village nav-icon"></i>
                                        <p>القرى</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-users"></i>
                                <p>الموارد البشرية <i class="fas fa-angle-left right"></i></p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="HR" asp-controller="Employees" asp-action="Index" class="nav-link">
                                        <i class="fas fa-user-plus nav-icon"></i>
                                        <p>الموظفين</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="HR" asp-controller="Leaves" asp-action="Index" class="nav-link">
                                        <i class="fas fa-calendar-minus nav-icon"></i>
                                        <p>الإجازات</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="HR" asp-controller="Attendance" asp-action="Index" class="nav-link">
                                        <i class="fas fa-clock nav-icon"></i>
                                        <p>الحضور والانصراف</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                    </ul>
                </nav>
            </div>
        </aside>

        <div class="content-wrapper">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm m-3" role="alert">
                    <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
                    <button type="button" class="close" data-dismiss="alert" style="outline:none;">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm m-3" role="alert">
                    <i class="fas fa-exclamation-circle mr-2"></i> @TempData["Error"]
                    <button type="button" class="close" data-dismiss="alert" style="outline:none;">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }

            <section class="content">
                <div class="container-fluid px-4 pb-4">
                    @RenderBody()
                </div>
            </section>
        </div>

        <footer class="main-footer-custom text-center">
            <div class="container-fluid">
                <p class="m-0 fs-6 opacity-75">
                    حقوق الطبع والنشر &copy; @DateTime.Now.Year الإدارة العامة لنظم المعلومات والتحول الرقمي
                    <a href="#" class="text-primary fw-bold text-decoration-none">إدارة النظم والتطبيقات</a>.
                </p>
            </div>
        </footer>

    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>

    <script>
        $(function () {
            // تفعيل Select2 إذا كانت مستخدمة
            if($('.select2').length) {
                $('.select2').select2();
            }

            // تفعيل Treeview
            $('.nav-treeview').hide();

            // إخفاء التنبيهات تلقائياً
            setTimeout(function () {
                $('.alert').slideUp(500, function() { $(this).remove(); });
            }, 5000);
        });

        // تفعيل الـ treeview menu
        $('.nav-item > a[href="#"]').on('click', function(e) {
            e.preventDefault();
            $(this).next('.nav-treeview').slideToggle();
            $(this).parent('.nav-item').toggleClass('menu-open');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>