@using erp_kfs.Host.Models
@model Department
@{
    ViewData["Title"] = "إضافة إدارة جديدة";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <h1 class="m-0">إضافة إدارة جديدة</h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="form-group">
                        <label asp-for="Name">اسم الإدارة</label>
                        <input asp-for="Name" class="form-control" placeholder="مثال: الإدارة العامة للشئون الوظيفية" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Type">نوع الإدارة</label>
                        <select asp-for="Type" class="form-control" id="deptType">
                            <option value="General">إدارة عامة (تتفرع منها إدارات)</option>
                            <option value="Sub">إدارة فرعية (لا تتفرع منها إدارات)</option>
                        </select>
                    </div>

                    <div class="form-group" id="parentSection" style="display:none;">
                        <label>الإدارة الأم</label>
                        <select asp-for="ParentId" class="form-control">
                            <option value="">-- اختر إدارة عامة --</option>
                            @foreach (var dept in ViewBag.GeneralDepartments as List<Department>)
                            {
                                <option value="@dept.Id">@dept.Name</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary">حفظ الإدارة</button>
                    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.getElementById('deptType').addEventListener('change', function () {
            var parentSection = document.getElementById('parentSection');
            if (this.value === 'Sub') {
                parentSection.style.display = 'block';
            } else {
                parentSection.style.display = 'none';
                document.querySelector('[name="ParentId"]').value = '';
            }
        });
    </script>
}