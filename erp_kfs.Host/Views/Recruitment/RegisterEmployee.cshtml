<!-- Views/Recruitment/RegisterEmployee.cshtml -->
@model MyERP.Web.Models.EmployeeRegistrationModel
@{
    ViewData["Title"] = "تسجيل حساب موظف";
}

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h4>إنشاء حساب الدخول</h4>
            </div>
            <div class="card-body">
                <form asp-action="RegisterEmployee" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="FullName"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="InitialLeaveBalance">رصيد الإجازات الابتدائي</label>
                        <input asp-for="InitialLeaveBalance" class="form-control" type="number" min="0" value="7" />
                        <span asp-validation-for="InitialLeaveBalance" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-success">إنشاء حساب الموظف</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card bg-light">
            <div class="card-body text-center">
                <h4>أو ابدأ بإدخال البيانات الكاملة</h4>
                <p class="text-muted">إذا كنت جاهزًا لإدخال بيانات الموظف بالكامل (الشخصية، الوظيفية، المالية).</p>
                <a asp-controller="Employees" asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="fas fa-user-plus"></i> فتح ملف موظف جديد
                </a>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mt-3">@TempData["Success"]</div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}