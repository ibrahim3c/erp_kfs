@{
    ViewData["Title"] = "لوحة مدير التوظيف";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">مدير التوظيف</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card card-primary card-outline text-center">
                    <div class="card-body">
                        <h3 class="card-title mb-4">مرحباً بك في لوحة التوظيف</h3>
                        <p class="text-muted">يمكنك الآن إنشاء ملف موظف جديد بإدخال بياناته الكاملة.</p>
                        <a asp-controller="Employees" asp-action="Create" class="btn btn-success btn-lg">
                            <i class="fas fa-user-plus mr-2"></i>إضافة بيانات موظف جديد
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>