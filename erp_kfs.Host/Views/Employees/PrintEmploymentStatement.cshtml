@model EmployeeAdmin
@{
    Layout = null; // بدون Layout
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>بيان الحالة الوظيفية - @Model.FullName</title>
    <style>
        body {
            font-family: 'Tajawal', sans-serif;
            direction: rtl;
            padding: 30mm;
            margin: 0;
            background: white;
            color: #000;
        }
        .container {
            max-width: 210mm;
            margin: 0 auto;
        }
        .logo {
            width: 100px;
            display: block;
            margin: 0 auto 10px;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
        }
        .header h2 {
            margin: 10px 0;
            font-size: 24px;
        }
        .content {
            margin: 20px 0;
        }
        .footer {
            margin-top: 40px;
            text-align: center;
            font-style: italic;
        }
        .signature {
            margin-top: 60px;
            text-align: center;
        }
        table { width: 100%; border-collapse: collapse; }
        td { padding: 8px 5px; vertical-align: top; }
        .label { font-weight: bold; width: 40%; }
        .value { width: 60%; }
    </style>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="container">
        <div class="header">
            <img src="@Context.Request.Scheme://@Context.Request.Host/image/kfs-logo%20(2).png" 
                 alt="شعار المحافظة" class="logo" />
            <h2>ديوان عام محافظة كفر الشيخ</h2>
            <h3>بيان الحالة الوظيفية</h3>
        </div>

        <div class="content">
            <table>
                <tr>
                    <td class="label">الاسم الكامل:</td>
                    <td class="value">@Model.FullName</td>
                </tr>
                <tr>
                    <td class="label">الرقم القومي:</td>
                    <td class="value">@Model.NationalId</td>
                </tr>
                <tr>
                    <td class="label">الوظيفة:</td>
                    <td class="value">@Model.JobTitle</td>
                </tr>
                <tr>
                    <td class="label">الإدارة:</td>
                    <td class="value">@(Model.Department?.Name ?? "غير محدد")</td>
                </tr>
                <tr>
                    <td class="label">تاريخ التعيين:</td>
                    <td class="value">@(Model.AppointmentDate?.ToString("dd/MM/yyyy") ?? "غير محدد")</td>
                </tr>
                <tr>
                    <td class="label">الدرجة المالية:</td>
                    <td class="value">@Model.FinancialGrade</td>
                </tr>
                <tr>
                    <td class="label">النوع:</td>
                    <td class="value">@Model.Gender</td>
                </tr>
            </table>

            <div class="footer">
                <p>يُمنح هذا البيان بناءً على طلب صاحب الشأن</p>
                <p>تاريخ الإصدار: @DateTime.Now.ToString("dd/MM/yyyy")</p>
            </div>

            <div class="signature">
                <p>__________________</p>
                <p>مدير الإدارة</p>
            </div>
        </div>
    </div>

    <script>
        window.onload = function() {
            window.print();
        };
    </script>
</body>
</html>