    @model EmployeeConfirmationViewModel
    @{
        Layout = "~/Views/Shared/_UserLayout.cshtml";
        ViewData["Title"] = "تأكيد إنشاء الحساب";
    }

    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0">بيانات دخول الموظف</h1>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card card-success card-outline">
                        <div class="card-header text-center">
                            <h3 class="card-title">
                                <i class="fas fa-user-check mr-2"></i>تم إنشاء الحساب بنجاح!
                            </h3>
                        </div>
                        <div class="card-body">
                            <div class="text-center mb-4">
                                <i class="fas fa-envelope fa-3x text-primary mb-3"></i>
                                <h5>البريد الإلكتروني</h5>
                                <p class="lead font-weight-bold">@Model.Email</p>
                            </div>

                            <div class="text-center mb-4">
                                <i class="fas fa-key fa-3x text-warning mb-3"></i>
                                <h5>كلمة المرور المؤقتة</h5>
                                <p class="lead font-weight-bold" id="password">@Model.Password</p>
                                <button class="btn btn-sm btn-outline-secondary" onclick="copyPassword()">
                                    <i class="fas fa-copy"></i> نسخ
                                </button>
                            </div>

                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i> 
                                يجب على الموظف تغيير كلمة المرور عند أول دخول.
                            </div>

                            <div class="text-center">
                                <button class="btn btn-success" onclick="window.print()">
                                    <i class="fas fa-print mr-1"></i> طباعة بطاقة الدخول
                                </button>
                                <a asp-action="Index" class="btn btn-secondary ml-2">
                                    <i class="fas fa-list mr-1"></i> العودة لقائمة الموظفين
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <style>
        @@media print {
            .content-header, .main-footer, .btn { display: none !important; }
            body { margin: 0; padding: 20px; background: white !important; }
            .card { box-shadow: none !important; border: 2px solid #007bff !important; }
            .card-body { padding: 30px !important; }
        }
    </style>

    <script>
        function copyPassword() {
            const pass = document.getElementById('password').innerText;
            navigator.clipboard.writeText(pass).then(() => {
                alert('تم نسخ كلمة المرور!');
            });
        }
    </script>