@model MyERP.Web.Models.EmployeeAdmin
@{
    ViewData["Title"] = "تفاصيل الموظف";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">@Model.FullName</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-action="Index">الموظفين</a></li>
                    <li class="breadcrumb-item active">التفاصيل</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 text-center">
                        <img src="@(string.IsNullOrEmpty(Model.ProfileImagePath) ? "/image/icons/7.png" : Model.ProfileImagePath)" 
                             alt="Profile" class="img-thumbnail rounded-circle" style="width: 180px; height: 180px;">
                    </div>
                    <div class="col-md-9">
                        <h4>البيانات الشخصية</h4>
                        <p><strong>الاسم:</strong> @Model.FullName</p>
                        <p><strong>الرقم القومي:</strong> @Model.NationalId</p>
                        <p><strong>تاريخ الميلاد:</strong> @(Model.BirthDate?.ToString("dd/MM/yyyy") ?? "غير محدد")</p>
                        <p><strong>النوع:</strong> @Model.Gender</p>
                        <p><strong>الموبايل:</strong> @Model.Mobile</p>
                        <p><strong>العنوان:</strong> @Model.Address</p>

                        <h4 class="mt-4">البيانات الوظيفية</h4>
                        <p><strong>الوظيفة:</strong> @Model.JobTitle</p>
                        <p><strong>الإدارة:</strong> @Model.Department?.Name</p>
                        <p><strong>تاريخ التعيين:</strong> @(Model.AppointmentDate?.ToString("dd/MM/yyyy") ?? "غير محدد")</p>
                        <p><strong>الدرجة المالية:</strong> @Model.FinancialGrade</p>

                        <div class="mt-4">
                     
                            <a asp-action="PrintEmploymentStatement" asp-route-id="@Model.Id" class="btn btn-info">بيان الحالة</a>
                            <a asp-action="Index" class="btn btn-secondary">العودة للقائمة</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>