@model IEnumerable<MyERP.Web.Models.EmployeeAdmin>
@{
    ViewData["Title"] = "سجل الموظفين";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-users"></i> سجل الموظفين
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-left">
                    <li class="breadcrumb-item"><a href="/">الرئيسية</a></li>
                    <li class="breadcrumb-item active">الموظفين</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary card-outline">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-list"></i> قائمة جميع الموظفين
                        </h3>
                        <div class="card-tools">
                            <div class="input-group input-group-sm" style="width: 250px;">
                                <input type="text" id="searchBox" class="form-control float-right" placeholder="بحث بالاسم أو الرقم القومي...">
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-default">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <a asp-action="Create" class="btn btn-success">
                                    <i class="fas fa-user-plus"></i> إضافة موظف جديد
                                </a>
                                <div class="btn-group float-left">
                                    <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown">
                                        <i class="fas fa-download"></i> تصدير
                                    </button>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" href="#"><i class="fas fa-file-excel"></i> Excel</a>
                                        <a class="dropdown-item" href="#"><i class="fas fa-file-pdf"></i> PDF</a>
                                        <a class="dropdown-item" href="#"><i class="fas fa-print"></i> طباعة</a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <table id="employeesTable" class="table table-bordered table-hover table-striped data-table">
                            <thead>
                                <tr class="bg-light">
                                    <th width="50">#</th>
                                    <th width="80">الصورة</th>
                                    <th>الاسم</th>
                                    <th width="120">الرقم القومي</th>
                                    <th>الوظيفة</th>
                                    <th>الإدارة</th>
                                    <th width="100">الحالة</th>
                                    <th width="150">الإجازات</th>
                                    <th width="120">الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int counter = 1;
                                    foreach (var employee in Model)
                                    {
                                        <tr>
                                            <td>@counter</td>
                                            <td class="text-center">
                                                <img src="@(string.IsNullOrEmpty(employee.ProfileImagePath) ? "/image/icons/7.png" : employee.ProfileImagePath)" 
                                                     alt="صورة الموظف" 
                                                     class="img-circle elevation-2" 
                                                     style="width: 40px; height: 40px; object-fit: cover;">
                                            </td>
                                            <td>
                                                <strong>@employee.FullName</strong>
                                                <br>
                                                <small class="text-muted">
                                                    <i class="fas fa-phone"></i> @employee.Mobile
                                                    @if (!string.IsNullOrEmpty(employee.Email))
                                                    {
                                                        <br><i class="fas fa-envelope"></i> @employee.Email
                                                    }
                                                </small>
                                            </td>
                                            <td>
                                                @employee.NationalId
                                                <br>
                                                <small class="text-muted">
                                                    <i class="fas fa-birthday-cake"></i> 
                                                    @(employee.BirthDate?.ToString("yyyy/MM/dd") ?? "غير محدد")
                                                </small>
                                            </td>
                                            <td>
                                                @employee.JobTitle
                                                <br>
                                                <small class="text-muted">
                                                    <i class="fas fa-briefcase"></i> @employee.FinancialGrade
                                                </small>
                                            </td>
                                            <td>
                                                @employee.Department?.Name
                                                <br>
                                                <small class="text-muted">
                                                    <i class="fas fa-calendar"></i> 
                                                    @(employee.AppointmentDate?.ToString("yyyy/MM/dd") ?? "غير محدد")
                                                </small>
                                            </td>
                                            <td class="text-center">
                                                @if (!employee.IsDisabled)
                                                {
                                                    <span class="badge badge-success employee-status-active">
                                                        <i class="fas fa-check-circle"></i> نشط
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-warning">
                                                        <i class="fas fa-wheelchair"></i> ذوي همم
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <div class="progress-group">
                                                    <div class="progress-group-header">
                                                        <span>المستخدم</span>
                                                        <span class="ml-auto">
                                                            <b>@employee.UsedAnnualLeaveThisYear</b>/@employee.AnnualLeaveEntitlement يوم
                                                        </span>
                                                    </div>
                                                    <div class="progress-group-bars">
                                                        <div class="progress progress-sm">
                                                            @{
                                                                var percentage = employee.AnnualLeaveEntitlement > 0 
                                                                    ? (employee.UsedAnnualLeaveThisYear / employee.AnnualLeaveEntitlement) * 100 
                                                                    : 0;
                                                            }
                                                            <div class="progress-bar bg-primary" 
                                                                 style="width: @percentage%"></div>
                                                        </div>
                                                    </div>
                                                    <small class="text-muted">المتبقي: @employee.RemainingAnnualLeave يوم</small>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="btn-group">
                                                    <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown">
                                                        <i class="fas fa-cogs"></i>
                                                    </button>
                                                    <div class="dropdown-menu dropdown-menu-right">
                                                        <a class="dropdown-item" asp-action="Details" asp-route-id="@employee.Id">
                                                            <i class="fas fa-eye text-primary"></i> عرض التفاصيل
                                                        </a>
                                                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@employee.Id">
                                                            <i class="fas fa-edit text-info"></i> تعديل
                                                        </a>
                                                        <div class="dropdown-divider"></div>
                                                        <a class="dropdown-item" href="#">
                                                            <i class="fas fa-calendar-alt text-success"></i> طلب إجازة
                                                        </a>
                                                        <a class="dropdown-item" href="#">
                                                            <i class="fas fa-file-contract text-warning"></i> تقارير الموظف
                                                        </a>
                                                        <div class="dropdown-divider"></div>
                                                        @if (!employee.IsDisabled)
                                                        {
                                                            <a class="dropdown-item text-danger" href="#" onclick="confirmDeactivate('@employee.Id', '@employee.FullName')">
                                                                <i class="fas fa-user-slash"></i> إيقاف الخدمة
                                                            </a>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                        counter++;
                                    }
                                }
                            </tbody>
                            <tfoot>
                                <tr class="bg-light">
                                    <th colspan="8">
                                        <div class="float-left">
                                            <span class="text-muted">إجمالي الموظفين: <strong>@Model.Count()</strong></span>
                                        </div>
                                    </th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="card-footer">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="btn-group">
                                    <button type="button" class="btn btn-outline-primary">
                                        <i class="fas fa-filter"></i> تصفية حسب:
                                    </button>
                                    <button type="button" class="btn btn-outline-primary dropdown-toggle dropdown-icon" data-toggle="dropdown">
                                    </button>
                                    <div class="dropdown-menu" role="menu">
                                        <a class="dropdown-item" href="#">جميع الموظفين</a>
                                        <a class="dropdown-item" href="#">الموظفين النشطين</a>
                                        <a class="dropdown-item" href="#">ذوي الهمم</a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" href="#">حسب الإدارة</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 text-left">
                                <div class="small-box bg-info">
                                    <div class="inner">
                                        <h3>@Model.Count(e => !string.IsNullOrEmpty(e.Email))</h3>
                                        <p>موظفين مفعل لهم حسابات دخول</p>
                                    </div>
                                    <div class="icon">
                                        <i class="fas fa-user-check"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal for Employee Details -->
<div class="modal fade" id="employeeModal" tabindex="-1" role="dialog" aria-labelledby="employeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title" id="employeeModalLabel">تفاصيل الموظف</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="employeeModalBody">
                <!-- Will be loaded via AJAX -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">إغلاق</button>
                <button type="button" class="btn btn-primary">طباعة البطاقة</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable with search functionality
            var table = $('#employeesTable').DataTable({
                "language": {
                    "url": "https://cdn.datatables.net/plug-ins/1.13.4/i18n/ar.json"
                },
                "responsive": true,
                "autoWidth": false,
                "pageLength": 25,
                "order": [[0, 'asc']],
                "dom": '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>' +
                       '<"row"<"col-sm-12"tr>>' +
                       '<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                "columnDefs": [
                    { "orderable": false, "targets": [1, 8] }, // Disable sorting on image and actions columns
                    { "searchable": false, "targets": [1, 8] } // Disable search on image and actions columns
                ]
            });

            // Custom search box
            $('#searchBox').on('keyup', function() {
                table.search(this.value).draw();
            });

            // Quick view modal
            $('#employeesTable tbody').on('click', 'tr', function(e) {
                if (!$(e.target).closest('.btn-group').length) {
                    var data = table.row(this).data();
                    if (data) {
                        var employeeId = $(this).find('td:first').text();
                        loadEmployeeDetails(employeeId);
                    }
                }
            });
        });

        function loadEmployeeDetails(employeeId) {
            $.ajax({
                url: '@Url.Action("QuickView", "Employees")',
                type: 'GET',
                data: { id: employeeId },
                success: function(data) {
                    $('#employeeModalBody').html(data);
                    $('#employeeModal').modal('show');
                },
                error: function() {
                    alert('حدث خطأ أثناء تحميل بيانات الموظف');
                }
            });
        }

        function confirmDeactivate(id, name) {
            if (confirm(`هل أنت متأكد من إيقاف خدمة الموظف ${name}؟`)) {
                $.ajax({
                    url: '@Url.Action("Deactivate", "Employees")',
                    type: 'POST',
                    data: { id: id },
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function() {
                        alert('حدث خطأ أثناء إيقاف خدمة الموظف');
                    }
                });
            }
        }

        // Export functionality
        function exportToExcel() {
            // Implement Excel export logic
        }

        function exportToPDF() {
            // Implement PDF export logic
        }
    </script>
}