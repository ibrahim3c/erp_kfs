@model MyERP.Web.Models.EmployeeProfileViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "ملفي الشخصي";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">ملفي الشخصي</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <!-- العمود الأول -->
            <div class="col-md-6">
                <!-- البيانات الأساسية -->
                <div class="card card-primary card-outline">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-id-card mr-1"></i> البيانات الأساسية</h3>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-4">الاسم الكامل</dt>
                            <dd class="col-sm-8">@Model.Employee.FullName</dd>

                            <dt class="col-sm-4">البريد الإلكتروني</dt>
                            <dd class="col-sm-8">@Model.User.Email</dd>

                            <dt class="col-sm-4">الإدارة</dt>
                            <dd class="col-sm-8">@Model.Employee.Department?.Name</dd>

                            <dt class="col-sm-4">تاريخ التعيين</dt>
                            <dd class="col-sm-8">@Model.Employee.HireDate?.ToString("dd/MM/yyyy")</dd>

                            <dt class="col-sm-4">مدة الخدمة</dt>
                            <dd class="col-sm-8">
                                @Model.Employee.ServiceYears سنة،
                                @Model.Employee.ServiceMonths شهر،
                                @Model.Employee.ServiceDays يوم
                            </dd>
                        </dl>
                    </div>
                </div>

                <!-- الأمان -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-shield-alt mr-1"></i> الأمان</h3>
                    </div>
                    <div class="card-body">
                        <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword"
                           class="btn btn-warning btn-block">
                            <i class="fas fa-key mr-1"></i> تغيير كلمة المرور
                        </a>
                        <p class="text-muted mt-2">
                            يُنصح بتغيير كلمة المرور المؤقتة فور تسجيل الدخول الأول.
                        </p>
                    </div>
                </div>

                <!-- بيانات الدخول -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-user-lock mr-1"></i> بيانات الدخول</h3>
                    </div>
                    <div class="card-body">
                        <p><strong>البريد الإلكتروني:</strong> @Model.User.Email</p>
                        <a asp-action="EmploymentStatement" class="btn btn-info">
                            <i class="fas fa-file-contract mr-1"></i> بيان الحالة الوظيفية
                        </a>
                    </div>
                </div>
            </div>

            <!-- العمود الثاني -->
            <div class="col-md-6">
                <!-- المهام المسموح بها -->
                <div class="card card-outline card-info">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-tasks mr-1"></i> مهام عملي المسموح بها</h3>
                    </div>
                    <div class="card-body">
                        @if (Model.Permissions != null && Model.Permissions.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var perm in Model.Permissions.OrderBy(p => p.Category))
                                {
                                    <li class="list-group-item">
                                        <span class="badge badge-@GetBadgeColor(perm.Category) mr-2">
                                            @GetCategoryName(perm.Category)
                                        </span>
                                        @perm.DisplayName
                                        @if (!string.IsNullOrEmpty(perm.LegalReference))
                                        {
                                            <br />
                                            <small class="text-muted">
                                                <i class="fas fa-balance-scale mr-1"></i> @perm.LegalReference
                                            </small>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle mr-1"></i>
                                لا توجد مهام عمل مسموح بها حالياً. يرجى التواصل مع الإدارة لتعيين المهام.
                            </div>
                        }
                    </div>
                </div>

                <!-- آخر الإجازات -->
                @if (Model.LeaveRequests?.Any() == true)
                {
                    <div class="card card-outline card-success">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-umbrella-beach mr-1"></i> آخر الإجازات</h3>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm table-striped mb-0">
                                <thead>
                                    <tr>
                                        <th>التاريخ</th>
                                        <th>الأيام</th>
                                        <th>الحالة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var lr in Model.LeaveRequests)
                                    {
                                        <tr>
                                            <td>@lr.StartDate?.ToString("dd/MM/yyyy")</td>
                                            <td>@lr.DaysRequested</td>
                                            <td>
                                                @switch (lr.Status)
                                                {
                                                    case "HRApproved":
                                                        <span class="badge badge-success">معتمدة</span>
                                                        break;
                                                    case "Rejected":
                                                        <span class="badge badge-danger">مرفوضة</span>
                                                        break;
                                                    default:
                                                        <span class="badge badge-warning">قيد المراجعة</span>
                                                        break;
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@functions {
    string GetCategoryName(string category) => category switch
    {
        "Recruitment" => "التوظيف",
        "HR" => "الموارد البشرية",
        "Departments" => "الإدارات",
        "Leadership" => "الهيكل القيادي",
        "Employee" => "مهامي",
        "Attendance" => "الحضور",
        "Payroll" => "المرتبات",
        _ => "عام"
    };

    string GetBadgeColor(string category) => category switch
    {
        "Recruitment" => "primary",
        "HR" => "success",
        "Departments" => "info",
        "Leadership" => "warning",
        "Employee" => "secondary",
        "Attendance" => "danger",
        "Payroll" => "dark",
        _ => "light"
    };
}