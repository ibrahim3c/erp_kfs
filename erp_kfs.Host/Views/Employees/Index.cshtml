@model List<MyERP.Web.Models.EmployeeAdmin>
@{
    ViewData["Title"] = "سجل الموظفين العام";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    string GetBadgeClass(string grade)
    {
        return grade switch
        {
            var g when g.Contains("مدير عام") => "badge-warning",
            var g when g.Contains("الأولى") => "badge-primary",
            var g when g.Contains("الثانية") => "badge-info",
            var g when g.Contains("الثالثة") => "badge-secondary",
            var g when g.Contains("الرابعة") => "badge-dark",
            _ => "badge-light"
        };
    }
}

<!-- روابط CSS الخاصة بـ DataTables -->
<link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
<link rel="stylesheet" href="~/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">

<!-- 1. قسم الفلتر والبحث المتقدم -->
<div class="card card-outline card-primary collapsed-card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-filter mr-1"></i> بحث متقدم وفلترة</h3>
        <div class="card-tools">
            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                <i class="fas fa-plus"></i>
            </button>
        </div>
    </div>
    <div class="card-body" style="display: none;">
        <form>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label>الرقم القومي / الوظيفي</label>
                    <input type="text" class="form-control" placeholder="أدخل الرقم...">
                </div>

                <div class="col-md-3 mb-3">
                    <label>اسم الموظف</label>
                    <input type="text" class="form-control" placeholder="بحث بالاسم...">
                </div>

                <div class="col-md-3 mb-3">
                    <label>الإدارة / القسم</label>
                    <select class="form-control select2">
                        <option value="">-- الكل --</option>
                        <option>الإدارة العامة لنظم المعلومات</option>
                        <option>التخطيط العمراني</option>
                        <option>الشئون الهندسية</option>
                    </select>
                </div>

                <div class="col-md-3 mb-3">
                    <label>الدرجة الوظيفية</label>
                    <select class="form-control">
                        <option value="">-- الكل --</option>
                        <option>مدير عام</option>
                        <option>الأولى</option>
                        <option>الثانية</option>
                    </select>
                </div>

                <div class="col-md-3 mb-3">
                    <label>نوع التعيين</label>
                    <select class="form-control">
                        <option value="">-- الكل --</option>
                        <option>دائم</option>
                        <option>مؤقت / عقد</option>
                    </select>
                </div>

                <div class="col-md-3 mb-3">
                    <label>حالة الموظف</label>
                    <select class="form-control">
                        <option value="1">على رأس العمل</option>
                        <option value="2">إجازة بدون مرتب</option>
                        <option value="3">منتهية خدمته</option>
                    </select>
                </div>

                <div class="col-md-12 text-left">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> بحث</button>
                    <button type="reset" class="btn btn-default">إعادة تعيين</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- 2. جدول البيانات (Data Table) -->
<div class="card">
    <div class="card-header border-0">
        <h3 class="card-title text-bold text-dark">قاعدة بيانات العاملين</h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-success btn-sm">
                <i class="fas fa-user-plus"></i> إضافة موظف جديد
            </a>
            <a href="#" class="btn btn-info btn-sm">
                <i class="fas fa-file-excel"></i> استيراد (Excel)
            </a>
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table id="employeesTable" class="table table-bordered table-striped table-hover text-center" style="width:100%">
                <thead class="bg-dark text-white">
                    <tr>
                        <th style="width: 2%">#</th>
                        
                        <th style="width: 20%">الاسم بالكامل</th>
                        <th>الرقم القومي</th>
                        <th>الوظيفة / التخصص</th>
                        <th>الدرجة</th>
                        <th>الإدارة</th>
                        <th>تاريخ التعيين</th>
                        <th>نوع التعيين</th>
                        <th>الحالة</th>
                        <th style="width: 10%">خيارات</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int counter = 1;
                    }
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td>@counter</td>
                            
                            <td class="text-right font-weight-bold">@emp.FullName</td>
                            <td>@emp.NationalId</td>

                            <td>@emp.JobTitle</td>
                            <td>
                                @if (!string.IsNullOrEmpty(emp.FinancialGrade))
                                {
                                    <span class="badge @GetBadgeClass(emp.FinancialGrade)">
                                        @(emp.FinancialGrade.Replace(" (رئيس قطاع)", "").Replace(" (وكيل وزارة)", ""))
                                    </span>
                                }
                            </td>
                            <td>@emp.Department?.Name</td> <!-- استخدام ?. للـ null check -->
                            <td>@(emp.AppointmentDate?.ToString("dd-MM-yyyy") ?? "-")</td>
                            <td>
                                @switch (emp.AppointmentType)
                                {
                                    case "دائم (موازنة)":
                                        <text>موازنة</text>
                                        break;
                                    case "مكافأة شاملة (صناديق)":
                                        <text>صناديق</text>
                                        break;
                                    case "عقد مؤقت / فصل مستقل":
                                        <text>مؤقت</text>
                                        break;
                                    case "منتدب":
                                        <text>منتدب</text>
                                        break;
                                    default:
                                        <text>@emp.AppointmentType</text>
                                        break;
                                }
                            </td>
                            <td>
                                @if (emp.IsDisabled)
                                {
                                    <span class="badge badge-danger">معاق</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">يعمل</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group">
                                   <button type="button"
        class="btn btn-default btn-sm dropdown-toggle"
        data-toggle="dropdown"
        aria-haspopup="true"
        aria-expanded="false">

                                        <i class="fas fa-cog"></i>
                                    </button>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" asp-controller="Employees" asp-action="EmployeeProfile" asp-route-id="@emp.Id">
                                            <i class="fas fa-eye text-primary mr-2"></i> الملف الشخصي
                                        </a>
                                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@emp.Id">
                                            <i class="fas fa-pen text-warning mr-2"></i> تعديل بيانات
                                        </a>

                                        <div class="dropdown-divider"></div>

                                        <a class="dropdown-item" href="#">
                                            <i class="fas fa-print text-secondary mr-2"></i> طباعة بيان حالة
                                        </a>
                                        <a class="dropdown-item" href="#">
                                            <i class="fas fa-umbrella-beach text-success mr-2"></i> رصيد الأجازات
                                        </a>
                                        <!-- <a class="dropdown-item" href="#">
                                            <i class="fas fa-gavel text-danger mr-2"></i> تسجيل جزاء
                                        </a> -->
                                    </div>
                                </div>
                            </td>
                        </tr>
                        counter++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables -->
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
    <script src="~/plugins/datatables-buttons/js/buttons.print.min.js"></script>
    <script src="~/plugins/jszip/jszip.min.js"></script>
    <script src="~/plugins/pdfmake/pdfmake.min.js"></script>
    <script src="~/plugins/pdfmake/vfs_fonts.js"></script>

    <script>
        $(function () {
            $("#employeesTable").DataTable({
                "responsive": true,
                "lengthChange": true,
                "autoWidth": false,
                "language": {
                    "sProcessing": "جاري المعالجة...",
                    "sLengthMenu": "أظهر _MENU_ مدخلات",
                    "sZeroRecords": "لم يُعثر على أية سجلات",
                    "sInfo": "إظهار _START_ إلى _END_ من أصل _TOTAL_ مدخل",
                    "sInfoEmpty": "يعرض 0 إلى 0 من أصل 0 سجل",
                    "sInfoFiltered": "(منتقاة من مجموع _MAX_ مُدخل)",
                    "sSearch": "ابحث:",
                    "oPaginate": {
                        "sFirst": "الأول",
                        "sPrevious": "السابق",
                        "sNext": "التالي",
                        "sLast": "الأخير"
                    }
                },
                "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"]
            }).buttons().container().appendTo('#employeesTable_wrapper .col-md-6:eq(0)');
        });
    </script>
}