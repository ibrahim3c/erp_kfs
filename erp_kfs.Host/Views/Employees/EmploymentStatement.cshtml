@model EmployeeAdmin
@{
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "بيان الحالة الوظيفية";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">بيان الحالة الوظيفية</h1>
            </div>
            <div class="col-sm-6 text-right">
               <a href="/Employees/PrintEmploymentStatement"class="btn btn-success" target="_blank">
                    <i class="fas fa-print"></i> طباعة البيان
                </a>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> العودة
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <div class="text-center mb-4">
                            <img src="~/image/kfs-logo (2).png" alt="شعار المحافظة" width="80" class="mb-2" />
                            <h4 class="mb-0">ديوان عام محافظة كفر الشيخ</h4>
                            <p class="text-muted">بيان الحالة الوظيفية</p>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>الاسم:</strong> @Model.FullName</p>
                                <p><strong>الرقم القومي:</strong> @Model.NationalId</p>
                                <p><strong>الوظيفة:</strong> @Model.JobTitle</p>
                                <p><strong>الإدارة:</strong> @Model.Department?.Name</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>تاريخ التعيين:</strong> @Model.AppointmentDate?.ToString("dd/MM/yyyy")</p>
                                <p><strong>الدرجة المالية:</strong> @Model.FinancialGrade</p>
                                <p><strong>النوع:</strong> @Model.Gender</p>
                                <p><strong>تاريخ الإصدار:</strong> @DateTime.Now.ToString("dd/MM/yyyy")</p>
                            </div>
                        </div>

                        <div class="mt-4 p-3 bg-light rounded">
                            <p class="text-center mb-0">
                                <strong>يُمنح هذا البيان بناءً على طلب صاحب الشأن</strong>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>