@model List<MyERP.Web.Models.ServicePeriodAddition>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "طلبات ضم المدة (بانتظار الموافقة)";
}

<div class="content-header">
    <div class="container-fluid">
        <h1>طلبات ضم المدة - بانتظار الموافقة</h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (Model.Count == 0)
        {
            <div class="alert alert-info">لا توجد طلبات بانتظار الموافقة.</div>
        }
        else
        {
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="bg-light">
                                <tr>
                                    <th>الموظف</th>
                                    <th>الفترة</th>
                                    <th>المدة</th>
                                    <th>المستند</th>
                                    <th>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var req in Model)
                                {
                                    <tr>
                                        <td>@req.Employee?.FullName</td>
                                        <td>@req.StartDate.ToString("dd/MM/yyyy") - @req.EndDate.ToString("dd/MM/yyyy")</td>
                                        <td>@req.Years سنة، @req.Months شهر، @req.Days يوم</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(req.DocumentPath))
                                            {
                                                <a href="@req.DocumentPath" target="_blank" class="btn btn-sm btn-info">
                                                    <i class="fas fa-file-alt"></i> عرض
                                                </a>
                                            }
                                        </td>
                                        <td>
                                            <form asp-action="Approve" method="post" style="display:inline;">
                                                <input type="hidden" name="id" value="@req.Id" />
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    <i class="fas fa-check"></i> اعتماد
                                                </button>
                                            </form>
                                            <button type="button" class="btn btn-danger btn-sm"
                                                    data-toggle="modal" data-target="#rejectModal_@req.Id">
                                                <i class="fas fa-times"></i> رفض
                                            </button>

                                            <div class="modal fade" id="rejectModal_@req.Id">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <form asp-action="Reject" method="post">
                                                            <input type="hidden" name="id" value="@req.Id" />
                                                            <div class="modal-header">
                                                                <h5>رفض الطلب</h5>
                                                                <button type="button" class="close" data-dismiss="modal">&times;</button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="form-group">
                                                                    <label>سبب الرفض</label>
                                                                    <textarea name="rejectionReason" class="form-control" required></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="submit" class="btn btn-danger">تأكيد الرفض</button>
                                                                <button type="button" class="btn btn-secondary" data-dismiss="modal">إغلاق</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</section>