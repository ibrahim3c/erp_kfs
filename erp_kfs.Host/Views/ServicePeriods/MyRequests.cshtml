@model List<MyERP.Web.Models.ServicePeriodAddition>
@{
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "طلبات ضم المدة";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>طلبات ضم المدة</h1>
            </div>
            <div class="col-sm-6 text-right">
                <a asp-action="Create" class="btn btn-success">
                    <i class="fas fa-plus"></i> طلب جديد
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (Model.Count == 0)
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle mr-1"></i> لا توجد طلبات حتى الآن.
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="bg-light">
                                <tr>
                                    <th>الفترة</th>
                                    <th>النوع</th>
                                    <th>المدة</th>
                                    <th>الحالة</th>
                                    <th>التاريخ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var req in Model)
                                {
                                    <tr>
                                        <td>@req.StartDate.ToString("dd/MM/yyyy") - @req.EndDate.ToString("dd/MM/yyyy")</td>
                                        <td>@req.PeriodType</td>
                                        <td>@req.Years سنة، @req.Months شهر، @req.Days يوم</td>
                                        <td>
                                            @switch (req.Status)
                                            {
                                                case "Approved":
                                                    <span class="badge badge-success">معتمد</span>
                                                    break;
                                                case "Rejected":
                                                    <span class="badge badge-danger">مرفوض</span>
                                                    break;
                                                default:
                                                    <span class="badge badge-warning">قيد الانتظار</span>
                                                    break;
                                            }
                                        </td>
                                        <td>@req.RequestDate.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</section>