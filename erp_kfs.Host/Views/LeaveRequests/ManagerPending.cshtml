@model List<LeaveRequest>
@{
    Layout = "~/Views/Shared/_UserLayout.cshtml"; // ← مهم جدًا (مش _UserLayout)
    ViewData["Title"] = "الطلبات المعلقة";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">الطلبات المعلقة للاعتماد</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">الطلبات بانتظار موافقتك</h3>
            </div>
            <div class="card-body">
                @if (Model.Count == 0)
                {
                    <div class="alert alert-info alert-dismissible">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                        <i class="icon fas fa-info"></i> لا توجد طلبات بانتظار الموافقة حالياً.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead class="bg-light">
                                <tr>
                                    <th>الموظف</th>
                                    <th>نوع الإجازة</th>
                                    <th>الفترة</th>
                                    <th>الأيام</th>
                                    <th>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model)
                                {
                                    <tr>
                                        <td>@r.Employee?.FullName</td>
                                        <td>@r.LeaveType?.DisplayName</td>
                                        <td>
                                            @r.StartDate?.ToString("dd/MM/yyyy") - 
                                            @r.EndDate?.ToString("dd/MM/yyyy")
                                        </td>
                                        <td>@r.DaysRequested</td>
                                        <td>
                                            <form asp-action="ApproveByManager" method="post" style="display:inline;" class="mr-1">
                                                <input type="hidden" name="id" value="@r.Id" />
                                                <button type="submit" class="btn btn-success btn-sm" title="موافقة">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                            <form asp-action="RejectByManager" method="post" style="display:inline;">
                                                <input type="hidden" name="id" value="@r.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm" title="رفض">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</section>