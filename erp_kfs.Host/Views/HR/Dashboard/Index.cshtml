<!-- Views/HR/Dashboard/Index.cshtml -->
@{
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "لوحة تحكم الموارد البشرية";
}

<div class="content-header">
    <div class="container-fluid">
        <h1>لوحة تحكم الموارد البشرية</h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <!-- طلبات ضم المدة -->
            <div class="col-lg-3 col-6">
                <a href="/ServicePeriods/PendingRequests" class="small-box bg-info">
                    <div class="inner">
                        <h3>ضم المدة</h3>
                        <p>طلبات معلقة</p>
                    </div>
                    <div class="icon"><i class="fas fa-clock"></i></div>
                </a>
            </div>

            <!-- طلبات إنهاء الخدمة -->
            <div class="col-lg-3 col-6">
                <a href="/Terminations/PendingRequests" class="small-box bg-danger">
                    <div class="inner">
                        <h3>إنهاء الخدمة</h3>
                        <p>طلبات معلقة</p>
                    </div>
                    <div class="icon"><i class="fas fa-door-open"></i></div>
                </a>
            </div>

            <!-- الإجازات -->
            <div class="col-lg-3 col-6">
                <a href="/LeaveRequests/ManagerPending" class="small-box bg-warning">
                    <div class="inner">
                        <h3>الإجازات</h3>
                        <p>بانتظار الموافقة</p>
                    </div>
                    <div class="icon"><i class="fas fa-umbrella-beach"></i></div>
                </a>
            </div>

            <!-- الموظفين -->
            <div class="col-lg-3 col-6">
                <a href="/Employees" class="small-box bg-success">
                    <div class="inner">
                        <h3>الموظفين</h3>
                        <p>عرض الملفات</p>
                    </div>
                    <div class="icon"><i class="fas fa-users"></i></div>
                </a>
            </div>
        </div>
    </div>
</section>