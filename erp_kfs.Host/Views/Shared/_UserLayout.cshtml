<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - المنصة الرقمية الموحدة</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.rtlcss.com/bootstrap/v4.5.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />

    <style>
            /* --- الأساسيات --- */
            body {
                font-family: 'Tajawal', sans-serif !important;
                background-color: #f8fafc;
                text-align: right;
            }

            /* --- القائمة الجانبية (Sidebar) --- */
            [dir="rtl"] .main-sidebar {
                right: 0 !important;
                left: auto !important;
                background-color: #1a2a32 !important; /* لون داكن كما في الصورة */
                box-shadow: -4px 0 10px rgba(0,0,0,0.1);
            }

            .main-sidebar .nav-sidebar .nav-link {
                border-radius: 0.5rem !important;
                margin: 0.2rem 0.8rem !important;
                padding: 0.6rem 1rem;
                color: #b8c7ce !important;
                transition: all 0.3s ease;
                font-weight: 500;
            }

                .main-sidebar .nav-sidebar .nav-link.active {
                    background-color: rgba(255,255,255,0.1) !important;
                    color: white !important;
                    font-weight: 700;
                }

                .main-sidebar .nav-sidebar .nav-link:hover:not(.active) {
                    background-color: rgba(255,255,255,0.05) !important;
                    color: #fff !important;
                    transform: translateX(-3px);
                }

            /* --- النافبار العلوي (Navbar) - مطابق للصورة --- */
            .main-header.navbar {
                background-color: #007c92 !important; /* اللون البترولي */
                border-bottom: 4px solid #ffb100 !important; /* الخط الأصفر السفلي */
                min-height: 65px;
                padding-right: 1.5rem;
                padding-left: 1.5rem;
            }

            .main-header .nav-link {
                color: #ffffff !important;
            }

                .main-header .nav-link:hover {
                    color: rgba(255, 255, 255, 0.8) !important;
                }

            /* --- بادج التاريخ الأصفر --- */
            .date-badge {
                background-color: #ffb100;
                color: #1a2a32;
                font-weight: 700;
                border-radius: 6px;
                padding: 0.4rem 1rem;
                font-size: 0.95rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            /* --- زر تسجيل الخروج --- */
            .nav-logout-btn {
                background-color: transparent;
                color: #ffffff !important;
                border: 1px solid rgba(255, 255, 255, 0.5);
                border-radius: 6px;
                font-weight: 600;
                padding: 0.3rem 1.2rem;
                transition: all 0.3s;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

                .nav-logout-btn:hover {
                    background-color: rgba(255, 255, 255, 0.1);
                    border-color: #ffffff;
                }

            /* --- البانر العائم (Floating Banner) - مطابق للصورة --- */
            .admin-header-banner {
                background-color: #007c92;
                color: white;
                padding: 1.5rem;
                border-radius: 12px;
                margin: 1.5rem 1.5rem 1rem 1.5rem;
                box-shadow: 0 4px 15px rgba(0, 124, 146, 0.15);
                position: relative;
            }

            .logo-container {
                background-color: #ffffff;
                padding: 10px;
                border-radius: 15px;
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            }

                .logo-container img {
                    width: 80px;
                    height: auto;
                }

            .banner-title {
                font-size: 2.2rem;
                font-weight: 800;
                margin: 0;
                line-height: 1.2;
            }

            .banner-subtitle {
                font-size: 1.1rem;
                color: rgba(255, 255, 255, 0.8);
                margin: 0.5rem 0 0 0;
                font-weight: 400;
            }

            /* --- التنبيهات (Alerts) --- */
            .alert-custom {
                border-radius: 0.75rem;
                border: none;
                box-shadow: 0 4px 6px rgba(0,0,0,0.05);
                margin: 0 1.5rem 1.5rem 1.5rem;
            }

            /* --- هوامش المحتوى (للـ RTL) --- */
            [dir="rtl"] .content-wrapper,
            [dir="rtl"] .main-footer,
            [dir="rtl"] .main-header {
                margin-right: 250px !important;
                margin-left: 0 !important;
                transition: margin-right .3s ease-in-out;
            }

            body.sidebar-collapse[dir="rtl"] .content-wrapper,
            body.sidebar-collapse[dir="rtl"] .main-header,
            body.sidebar-collapse[dir="rtl"] .main-footer {
                margin-right: 4.6rem !important;
            }

            @@media (max-width: 768px) {
                [dir="rtl"] .content-wrapper,
                [dir="rtl"] .main-header,
                [dir="rtl"] .main-footer {
                    margin-right: 0 !important;
                }

                .admin-header-banner {
                    margin: 1rem;
                    padding: 1rem;
                    text-align: center;
                }

                    .admin-header-banner .row {
                        flex-direction: column-reverse;
                        gap: 1rem;
                    }

                .banner-title {
                    font-size: 1.5rem;
                }
            }
    </style>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">

        <nav class="main-header navbar navbar-expand shadow-sm">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item d-none d-sm-flex align-items-center ml-3">
                    <h5 class="m-0 font-weight-bold text-white">نظام إدارة المؤسسة الموحد</h5>
                </li>
            </ul>

            <ul class="navbar-nav mr-auto align-items-center">
                <li class="nav-item d-none d-md-block px-2">
                    <div class="date-badge">
                        <span>@DateTime.Now.ToString("yyyy/MM/dd")</span>
                        <i class="far fa-calendar-alt"></i>
                    </div>
                </li>
                <li class="nav-item pl-2">
                    <form asp-area="Identity" asp-page="/Account/Manage/Logout"
                          asp-route-returnUrl="@Url.Page("/Account/Login", new { area = "Identity" })"
                          method="post" style="display:inline;">
                        <button type="submit" class="btn nav-logout-btn">
                            <span>خروج</span>
                            <i class="fas fa-power-off"></i>
                        </button>
                    </form>
                </li>
            </ul>
        </nav>

        @await Component.InvokeAsync("EmployeeSidebar")

        <div class="content-wrapper bg-transparent">

            <div class="admin-header-banner">
                <div class="row align-items-center justify-content-between">
                    <div class="col text-right">
                        <h1 class="banner-title">نظام إدارة المؤسسة الموحد</h1>
                        <p class="banner-subtitle">ديوان عام محافظة كفر الشيخ - قطاع التحول الرقمي</p>
                    </div>
                    <div class="col-auto">
                        <div class="logo-container">
                            <img src="~/image/kfs-logo (2).png" alt="شعار المحافظة" />
                        </div>
                    </div>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-custom alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
                    <button type="button" class="close" data-dismiss="alert" style="outline: none;">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }

            <section class="content">
                <div class="container-fluid px-3 pb-4">
                    @RenderBody()
                </div>
            </section>

        </div>

        <footer class="main-footer bg-white text-center py-3 border-top mt-auto">
            <span class="text-muted font-weight-bold" style="font-size: 0.9rem;">
                كافة الحقوق محفوظة &copy; @DateTime.Now.Year ديوان عام محافظة كفر الشيخ - قطاع النظم والتطبيقات
            </span>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function() {
        $('[data-toggle="tooltip"]').tooltip();

        setTimeout(function() {
        $('.alert-custom').slideUp(500, function() { $(this).remove(); });
        }, 4000);

        if ($.fn.select2) {
        $('.select2').select2({ dir: "rtl", width: '100%' });
        }

        // تمييز الرابط النشط بذكاء
        var currentPath = window.location.pathname;
        $('.nav-sidebar .nav-link').each(function() {
        var linkPath = $(this).attr('href');
        if (linkPath && currentPath.indexOf(linkPath) === 0 && linkPath !== "/") {
        $(this).addClass('active');
        $(this).parents('.nav-item').addClass('menu-open');
        $(this).parents('.nav-treeview').show();
        }
        });
        if(currentPath === "/" || currentPath.toLowerCase() === "/home") {
        $('.nav-sidebar .nav-link[href="/"]').addClass('active');
        }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>