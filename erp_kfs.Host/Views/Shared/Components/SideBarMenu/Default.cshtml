@model MyERP.Web.ViewComponents.SidebarMenuViewModel

<nav class="mt-2">
    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">
        <li class="nav-item">
            <a asp-controller="Home" asp-action="Index" class="nav-link">
                <i class="nav-icon fas fa-tachometer-alt"></i>
                <p>لوحة التحكم</p>
            </a>
        </li>

        @if (Model.UserRoles.Contains("Admin"))
        {
            <li class="nav-header">الإدارة</li>
            <li class="nav-item">
                <a asp-controller="Employees" asp-action="Index" class="nav-link">
                    <i class="nav-icon fas fa-users"></i>
                    <p>الموظفين</p>
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Departments" asp-action="Index" class="nav-link">
                    <i class="nav-icon fas fa-building"></i>
                    <p>الإدارات</p>
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="Leadership" asp-action="Index" class="nav-link">
                    <i class="nav-icon fas fa-sitemap"></i>
                    <p>الهيكل القيادي</p>
                </a>
            </li>
        }

        @if (Model.UserRoles.Contains("HR") || Model.UserRoles.Contains("Admin"))
        {
            <li class="nav-header">الموارد البشرية</li>
            <li class="nav-item">
                <a href="/ServicePeriods/PendingRequests" class="nav-link">
                    <i class="nav-icon fas fa-clock"></i>
                    <p>طلبات ضم المدة</p>
                </a>
            </li>
            <li class="nav-item">
                <a href="/Terminations/PendingRequests" class="nav-link">
                    <i class="nav-icon fas fa-door-open"></i>
                    <p>طلبات إنهاء الخدمة</p>
                </a>
            </li>
            <li class="nav-item">
                <a asp-controller="LeaveRequests" asp-action="ManagerPending" class="nav-link">
                    <i class="nav-icon fas fa-umbrella-beach"></i>
                    <p>
                        الإجازات
                        @if (Model.PendingLeaveRequestsCount > 0)
                        {
                            <span class="badge badge-warning navbar-badge">@Model.PendingLeaveRequestsCount</span>
                        }
                    </p>
                </a>
            </li>
        }

        <li class="nav-header">التقارير</li>
        <li class="nav-item">
            <a href="#" class="nav-link">
                <i class="nav-icon fas fa-chart-bar"></i>
                <p>تقرير الحضور</p>
            </a>
        </li>
        <li class="nav-item">
            <a href="#" class="nav-link">
                <i class="nav-icon fas fa-file-alt"></i>
                <p>تقرير الإجازات</p>
            </a>
        </li>
    </ul>
</nav>