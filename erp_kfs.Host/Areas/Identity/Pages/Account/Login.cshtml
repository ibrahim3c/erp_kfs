@page
@model erp_kfs.Host.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="All" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control w-100" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control w-100" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label"></label>
            </div>

            <div class="d-flex gap-2 mt-2">
                <button type="submit" class="btn btn-login w-100">تسجيل الدخول</button>
                <a href="~/" class="btn btn-outline-secondary btn-back w-100 d-flex justify-content-center align-items-center text-decoration-none">رجوع للرئيسية</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}