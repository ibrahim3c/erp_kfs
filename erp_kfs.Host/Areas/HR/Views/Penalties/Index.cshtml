@using HR.Domain.Penalties
@model List<HR.Application.Penalties.GetPenaltyList.GetPenaltyListResponse>
@{
    ViewData["Title"] = "سجل الجزاءات والمخالفات التأديبية";
}

<link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="~/plugins/select2/css/select2.min.css">
<link rel="stylesheet" href="~/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css">

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-exclamation-triangle text-danger me-2"></i>
                    سجل المخالفات والجزاءات
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">HR</a></li>
                    <li class="breadcrumb-item active">الجزاءات</li>
                </ol>
            </div>
        </div>
    </div>
</div>

@* ── Alerts ── *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mx-3">
        <i class="fas fa-check-circle me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mx-3">
        <i class="fas fa-exclamation-circle me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section class="content">
    <div class="container-fluid">

        @* ══ نموذج تسجيل جزاء (الكود الخاص بك كما هو) ══ *@
        <div class="card card-outline card-danger collapsed-card">
        </div>

        @* ══ أرشيف الجزاءات ══ *@
        <div class="card">
            <div class="card-header border-0">
                <h3 class="card-title fw-bold">أرشيف الجزاءات المسجلة</h3>
                <div class="card-tools">
                    <button class="btn btn-secondary btn-sm" onclick="window.print()" title="طباعة">
                        <i class="fas fa-print"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <table id="penaltyTable" class="table table-bordered table-striped text-center align-middle">
                    <thead class="bg-secondary text-white">
                        <tr>
                            <th>تاريخ القرار</th>
                            <th>الموظف</th>
                            <th>نوع المخالفة</th>
                            <th>الجزاء الموقع</th>
                            <th>شهر التنفيذ</th>
                            <th>رقم القرار</th>
                            <th>خيارات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr class="@(p.PenaltyType == "Hold" ? "table-warning" : "")">
                                <td>@p.ViolationDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-end fw-bold">@p.EmployeeName</td>
                                <td>@p.PenaltyType</td>
                                <td>
                                    @switch (p.ActionType)
                                    {
                                        case PenaltyActionType.Deduct:
                                            <span class="badge bg-danger fs-6 p-2">خصم @p.DeductionDays أيام</span>
                                            break;
                                        case PenaltyActionType.Warning:
                                            <span class="badge bg-warning text-dark fs-6 p-2">لفت نظر (إنذار)</span>
                                            break;
                                        case PenaltyActionType.Hold:
                                            <span class="badge bg-dark fs-6 p-2">وقف عن العمل</span>
                                            break;
                                        case PenaltyActionType.Postpone:
                                            <span class="badge bg-secondary fs-6 p-2">تأجيل ترقية</span>
                                            break;
                                    }
                                </td>
                                <td>@p.ExecutionMonth.ToString("MMMM yyyy", new System.Globalization.CultureInfo("ar-EG"))</td>
                                <td>@p.DecisionReference</td>
                                <td>
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-outline-info" title="التفاصيل"
                                                data-bs-toggle="modal" data-bs-target="#detailsModal"
                                                data-emp="@p.EmployeeName" data-type="@p.PenaltyType"
                                                data-date="@p.ViolationDate.ToString("yyyy-MM-dd")"
                                                data-action="@p.ActionType.ToString()" data-days="@p.DeductionDays"
                                                data-ref="@p.DecisionReference" data-month="@p.ExecutionMonth.ToString("yyyy-MM")">
                                            <i class="fas fa-eye"></i>
                                        </button>

                                        <button type="button" class="btn btn-sm btn-outline-primary" title="تعديل"
                                                data-bs-toggle="modal" data-bs-target="#editModal"
                                                data-id="@p.Id" data-emp="@p.EmployeeName"
                                                data-type="@p.PenaltyType" data-date="@p.ViolationDate.ToString("yyyy-MM-dd")"
                                                data-action="@p.ActionType.ToString()" data-days="@p.DeductionDays"
                                                data-ref="@p.DecisionReference" data-month="@p.ExecutionMonth.ToString("yyyy-MM")">
                                            <i class="fas fa-edit"></i>
                                        </button>

                                        <form asp-action="Delete" asp-controller="Penalties" asp-area="HR" method="post" class="d-inline" onsubmit="return confirm('هل تريد حذف هذا الجزاء؟')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف"><i class="fas fa-trash-alt"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>

<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-info-circle me-2"></i> تفاصيل الجزاء</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table class="table table-bordered">
                    <tr><th class="bg-light w-25">الموظف</th><td id="detEmp" class="fw-bold"></td></tr>
                    <tr><th class="bg-light">نوع المخالفة</th><td id="detType"></td></tr>
                    <tr><th class="bg-light">تاريخ المخالفة</th><td id="detDate"></td></tr>
                    <tr><th class="bg-light">نوع الجزاء</th><td id="detAction"></td></tr>
                    <tr><th class="bg-light">عدد الأيام</th><td id="detDays"></td></tr>
                    <tr><th class="bg-light">شهر التنفيذ</th><td id="detMonth"></td></tr>
                    <tr><th class="bg-light">رقم القرار</th><td id="detRef"></td></tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-edit me-2"></i> تعديل بيانات الجزاء</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Edit" asp-controller="Penalties" asp-area="HR" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editId" />
                
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">الموظف (لا يمكن تعديله)</label>
                            <input type="text" class="form-control" id="editEmp" readonly disabled>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">نوع المخالفة</label>
                            <select name="violationType" class="form-select" id="editType" required>
                                <option value="تأخير وغياب">تأخير وغياب</option>
                                <option value="سلوك غير لائق">سلوك غير لائق</option>
                                <option value="إهمال وتقصير">إهمال وتقصير</option>
                                <option value="مخالفة تعليمات إدارية">مخالفة تعليمات إدارية</option>
                                <option value="تغيب بدون إذن">تغيب بدون إذن</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">تاريخ المخالفة</label>
                            <input type="date" name="violationDate" id="editDate" class="form-control" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label text-danger">نوع الجزاء</label>
                            <select name="penaltyType" id="editAction" class="form-select text-danger fw-bold" required onchange="toggleEditDeduct()">
                                <option value="Warning">إنذار / لفت نظر</option>
                                <option value="Deduct">خصم من الراتب (أيام)</option>
                                <option value="Hold">وقف عن العمل</option>
                                <option value="Postpone">تأجيل ترقية</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3" id="editDaysDiv">
                            <label class="form-label">عدد أيام الخصم</label>
                            <input type="number" name="deductionDays" id="editDays" class="form-control fw-bold border-danger" min="0">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">شهر التنفيذ</label>
                            <input type="month" name="executionMonth" id="editMonth" class="form-control" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">رقم القرار</label>
                            <input type="text" name="decisionReference" id="editRef" class="form-control">
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">تحديث المرفق (اختياري)</label>
                            <input type="file" name="decisionFile" class="form-control" accept=".pdf,.jpg,.jpeg,.png">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/plugins/select2/js/select2.full.min.js"></script>

    <script>
        $(function () {
            $('.select2').select2({ theme: 'bootstrap4' });
            $('#penaltyTable').DataTable({
                language: { url: "//cdn.datatables.net/plug-ins/1.10.25/i18n/Arabic.json" },
                autoWidth: false,
                order: [[0, 'desc']]
            });

            // ─── تعبئة بيانات Modal التفاصيل ───
            $('#detailsModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var modal = $(this);
                modal.find('#detEmp').text(button.data('emp'));
                modal.find('#detType').text(button.data('type'));
                modal.find('#detDate').text(button.data('date'));
                modal.find('#detAction').text(button.data('action'));
                modal.find('#detDays').text(button.data('days'));
                modal.find('#detMonth').text(button.data('month'));
                modal.find('#detRef').text(button.data('ref'));
            });

            // ─── تعبئة بيانات Modal التعديل ───
            $('#editModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var modal = $(this);
                
                modal.find('#editId').val(button.data('id'));
                modal.find('#editEmp').val(button.data('emp'));
                modal.find('#editType').val(button.data('type'));
                modal.find('#editDate').val(button.data('date'));
                modal.find('#editAction').val(button.data('action'));
                modal.find('#editDays').val(button.data('days'));
                modal.find('#editMonth').val(button.data('month'));
                modal.find('#editRef').val(button.data('ref'));
                
                // تشغيل دالة إخفاء/إظهار حقل الأيام حسب النوع
                toggleEditDeduct();
            });
        });

        // دوال إخفاء وإظهار الأيام للفورمات (الإنشاء والتعديل)
        function toggleDeduct() {
            var type = document.getElementById('penaltyTypeSelect').value;
            var div  = document.getElementById('daysDiv');
            var show = type === 'Deduct' || type === 'Hold';
            div.style.visibility = show ? 'visible' : 'hidden';
            div.style.opacity    = show ? '1' : '0';
        }

        function toggleEditDeduct() {
            var type = document.getElementById('editAction').value;
            var div  = document.getElementById('editDaysDiv');
            var show = type === 'Deduct' || type === 'Hold';
            div.style.visibility = show ? 'visible' : 'hidden';
            div.style.opacity    = show ? '1' : '0';
        }
    </script>
}