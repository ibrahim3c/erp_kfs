@{
    ViewData["Title"] = "سجل الموظفين العام";
}

<link rel="stylesheet" href="~/css/global/hr-custom.css" asp-append-version="true">

<div class="hr-page-container animate__animated animate__fadeIn">
    <!-- 1. Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h5 font-weight-bold text-dark mb-1">سجل الموظفين العام</h1>
            <p class="text-muted mb-0 small">إدارة ومتابعة بيانات العاملين بالمحافظة</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="hr-btn hr-btn-primary">
                <i class="fas fa-plus"></i> إضافة موظف جديد
            </a>
        </div>
    </div>

    <!-- 2. Search & Filter Section -->
    <div class="hr-card mb-4">
        <div class="hr-card-header" data-bs-toggle="collapse" href="#filterCollapse" role="button" aria-expanded="false" style="cursor: pointer;">
            <h3 class="hr-card-title">
                <i class="fas fa-filter"></i> أدوات البحث والتصفية المتقدمة
            </h3>
            <i class="fas fa-chevron-down text-muted"></i>
        </div>
        <div class="collapse" id="filterCollapse">
            <div class="hr-filter-section">
                <form>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="hr-form-label">الرقم القومي / الوظيفي</label>
                            <input type="text" class="form-control hr-form-control" placeholder="أدخل الرقم...">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="hr-form-label">اسم الموظف</label>
                            <input type="text" class="form-control hr-form-control" placeholder="بحث بالاسم...">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="hr-form-label">الإدارة / القسم</label>
                            <select class="form-select hr-form-control">
                                <option value="">-- الكل --</option>
                                <option>الإدارة العامة لنظم المعلومات</option>
                                <option>التخطيط العمراني</option>
                                <option>الشئون الهندسية</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="hr-form-label">حالة الموظف</label>
                            <select class="form-select hr-form-control">
                                <option value="1">على رأس العمل</option>
                                <option value="2">إجازة بدون مرتب</option>
                                <option value="3">منتهية خدمته</option>
                            </select>
                        </div>
                        <div class="col-12 mt-2 d-flex justify-content-end gap-2">
                            <button type="submit" class="hr-btn hr-btn-primary">تطبيق البحث</button>
                            <button type="reset" class="hr-btn hr-btn-outline">إعادة تعيين</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 3. Employee Listing Table -->
    <div class="hr-card">
        <div class="hr-card-header">
            <h3 class="hr-card-title">
                <i class="fas fa-list-ul"></i> قاعدة بيانات العاملين
            </h3>
        </div>
        <div class="hr-table-wrapper">
            <table id="employeesTable" class="table hr-table text-center mb-0" style="width:100%">
                <thead>
                    <tr>
                        <th style="width: 5%">#</th>
                        <th style="width: 8%">كود</th>
                        <th style="width: 25%">الاسم بالكامل</th>
                        <th>الوظيفة / التخصص</th>
                        <th>الدرجة</th>
                        <th>الإدارة</th>
                        <th>الحالة</th>
                        <th style="width: 10%">الخيارات</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td><span class="font-weight-bold text-primary">1001</span></td>
                        <td class="text-right">فاطمة عبدالفتاح الشرباني</td>
                        <td>مدير عام (أخصائي عمراني)</td>
                        <td><span class="hr-badge hr-badge-warning">مدير عام</span></td>
                        <td>التخطيط العمراني</td>
                        <td><span class="hr-badge hr-badge-success">يعمل</span></td>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-light btn-sm rounded-pill" type="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-ellipsis-h text-muted"></i>
                                </button>
                                <div class="dropdown-menu hr-dropdown-menu dropdown-menu-end shadow">
                                    <a class="dropdown-item hr-dropdown-item" href="#"><i class="fas fa-eye text-primary"></i> عرض الملف</a>
                                    <a class="dropdown-item hr-dropdown-item" href="#"><i class="fas fa-edit text-warning"></i> تعديل</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item hr-dropdown-item text-danger" href="#"><i class="fas fa-trash"></i> حذف</a>
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td><span class="font-weight-bold text-primary">1002</span></td>
                        <td class="text-right">محمد فؤاد ابراهيم</td>
                        <td>كبير اخصائيين</td>
                        <td><span class="hr-badge hr-badge-primary">الأولى</span></td>
                        <td>الشئون الهندسية</td>
                        <td><span class="hr-badge hr-badge-success">يعمل</span></td>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-light btn-sm rounded-pill" type="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-ellipsis-h text-muted"></i>
                                </button>
                                <div class="dropdown-menu shadow">
                                    <a class="dropdown-item" href="#"><i class="fas fa-eye text-primary"></i> عرض الملف</a>
                                    <a class="dropdown-item" href="#"><i class="fas fa-edit text-warning"></i> تعديل</a>
                                </div>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#employeesTable').DataTable({
                "responsive": true,
                "lengthChange": true,
                "autoWidth": false,
                "language": {
                    "sProcessing": "جاري التحميل...",
                    "sLengthMenu": "عرض _MENU_",
                    "sZeroRecords": "لا توجد نتائج",
                    "sEmptyTable": "لا توجد بيانات",
                    "sInfo": "سجل _START_ - _END_ من _TOTAL_",
                    "sInfoEmpty": "سجل 0 - 0 من 0",
                    "sInfoFiltered": "(من _MAX_)",
                    "sInfoPostFix": "",
                    "sSearch": "بحث شامل:",
                    "sUrl": "",
                    "sInfoThousands": ",",
                    "sLoadingRecords": "جاري التحميل...",
                    "oPaginate": {
                        "sFirst": "الأول",
                        "sLast": "الأخير",
                        "sNext": "التالي",
                        "sPrevious": "السابق"
                    },
                    "search": "",
                    "searchPlaceholder": "بحث في النتائج..."
                },
                "dom": '<"hr-dt-top p-3 border-bottom w-100"B><"hr-dt-bottom p-3 d-flex align-items-center justify-content-between w-100"lf>rt<"p-3 d-flex flex-column align-items-center gap-2 w-100"pi>',
                "buttons": [
                    { extend: 'copy', text: '<i class="fas fa-copy"></i> نسخ', className: 'hr-btn-dt' },
                    { extend: 'excel', text: '<i class="fas fa-file-excel"></i> إكسيل', className: 'hr-btn-dt' },
                    { extend: 'print', text: '<i class="fas fa-print"></i> طباعة', className: 'hr-btn-dt' },
                    { extend: 'colvis', text: '<i class="fas fa-columns"></i> الأعمدة', className: 'hr-btn-dt' }
                ]
            });
        });
    </script>
}
