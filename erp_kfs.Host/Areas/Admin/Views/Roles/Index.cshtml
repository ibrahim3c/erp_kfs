@model List<Microsoft.AspNetCore.Identity.IdentityRole>
@using MyERP.Web.Areas.Admin.Models
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "إدارة الأدوار";
    var stats = ViewBag.RoleStats as Dictionary<string, RoleStatsViewModel> ?? new();
    var protectedRoles = new[] { "Admin", "HR", "Recruiter", "Employee" };
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1><i class="fas fa-user-tag mr-2"></i> إدارة الأدوار</h1>
            </div>
            <div class="col-sm-6 text-left">
                <a asp-action="Create" class="btn btn-success">
                    <i class="fas fa-plus mr-1"></i> إضافة دور جديد
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            @foreach (var role in Model)
            {
                var stat = stats.ContainsKey(role.Id) ? stats[role.Id] : new RoleStatsViewModel();
                var isProtected = protectedRoles.Contains(role.Name);

                <div class="col-md-4 col-sm-6 mb-4">
                    <div class="card card-outline @(isProtected ? "card-warning" : "card-primary") h-100">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-@(isProtected ? "shield-alt" : "user-tag") mr-1"></i>
                                @role.Name
                            </h3>
                            @if (isProtected)
                            {
                                <span class="badge badge-warning float-left">أساسي</span>
                            }
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-6">
                                    <div class="info-box-content">
                                        <span class="info-box-text text-muted">المستخدمين</span>
                                        <span class="info-box-number h4">@stat.UserCount</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="info-box-content">
                                        <span class="info-box-text text-muted">الصلاحيات</span>
                                        <span class="info-box-number h4">@stat.PermissionCount</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="btn-group btn-group-sm d-flex">
                                <a asp-area="Admin" asp-controller="Permissions" asp-action="Assign"
                                   asp-route-roleId="@role.Id"
                                   class="btn btn-info flex-fill" title="صلاحيات الدور">
                                    <i class="fas fa-key"></i> الصلاحيات
                                </a>
                                <a asp-action="Users" asp-route-id="@role.Id"
                                   class="btn btn-primary flex-fill" title="مستخدمي الدور">
                                    <i class="fas fa-users"></i> المستخدمين
                                </a>
                                @if (!isProtected)
                                {
                                    <a asp-action="Edit" asp-route-id="@role.Id"
                                       class="btn btn-warning flex-fill" title="تعديل">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" method="post" class="flex-fill"
                                          onsubmit="return confirm('هل أنت متأكد من حذف هذا الدور؟');">
                                        <input type="hidden" name="id" value="@role.Id" />
                                        <button type="submit" class="btn btn-danger btn-block" title="حذف">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>