@model MyERP.Web.Areas.Admin.Models.RoleUsersViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = $"مستخدمي الدور: {Model.RoleName}";
    var availableUsers = Model.AllUsers
        .Where(u => !Model.UsersInRole.Any(ur => ur.Id == u.Id))
        .ToList();
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>
                    <i class="fas fa-users mr-2"></i>
                    مستخدمي الدور: <span class="badge badge-primary">@Model.RoleName</span>
                </h1>
            </div>
            <div class="col-sm-6 text-left">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-right mr-1"></i> العودة للأدوار
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <!-- المستخدمين الحاليين -->
            <div class="col-md-7">
                <div class="card card-primary card-outline">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-user-check mr-1"></i>
                            المستخدمين في هذا الدور (@Model.UsersInRole.Count)
                        </h3>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.UsersInRole.Any())
                        {
                            <table class="table table-hover mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th>الاسم</th>
                                        <th>البريد</th>
                                        <th>إجراء</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model.UsersInRole)
                                    {
                                        <tr>
                                            <td>
                                                <i class="fas fa-user-circle text-primary mr-1"></i>
                                                @user.FullName
                                            </td>
                                            <td>@user.Email</td>
                                            <td>
                                                <form asp-action="RemoveUserFromRole" method="post"
                                                      onsubmit="return confirm('هل أنت متأكد من إزالة هذا المستخدم من الدور؟');">
                                                    <input type="hidden" name="roleId" value="@Model.RoleId" />
                                                    <input type="hidden" name="userId" value="@user.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="fas fa-user-minus"></i> إزالة
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="p-3 text-center text-muted">
                                <i class="fas fa-users-slash fa-2x mb-2"></i>
                                <p>لا يوجد مستخدمين في هذا الدور.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- إضافة مستخدم -->
            <div class="col-md-5">
                <div class="card card-success card-outline">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-user-plus mr-1"></i> إضافة مستخدم للدور
                        </h3>
                    </div>
                    <div class="card-body">
                        @if (availableUsers.Any())
                        {
                            <form asp-action="AddUserToRole" method="post">
                                <input type="hidden" name="roleId" value="@Model.RoleId" />

                                <div class="form-group">
                                    <label>اختر المستخدم:</label>
                                    <select name="userId" class="form-control select2" required>
                                        <option value="">-- اختر مستخدم --</option>
                                        @foreach (var user in availableUsers)
                                        {
                                            <option value="@user.Id">@user.FullName (@user.Email)</option>
                                        }
                                    </select>
                                </div>

                                <button type="submit" class="btn btn-success btn-block">
                                    <i class="fas fa-plus mr-1"></i> إضافة للدور
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="text-center text-muted">
                                <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                                <p>جميع المستخدمين مضافين لهذا الدور.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($.fn.select2) {
                $('.select2').select2({
                    dir: "rtl",
                    width: '100%',
                    placeholder: "ابحث عن مستخدم..."
                });
            }
        });
    </script>
}