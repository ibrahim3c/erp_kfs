@model MyERP.Web.Areas.Admin.Models.CreateRoleViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "إضافة دور جديد";
}

<div class="content-header">
    <div class="container-fluid">
        <h1><i class="fas fa-plus-circle mr-2"></i> إضافة دور جديد</h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">بيانات الدور</h3>
                    </div>
                    <form asp-action="Create" method="post">
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="form-group">
                                <label asp-for="Name"></label>
                                <input asp-for="Name" class="form-control" placeholder="مثال: Accountant أو محاسب" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                                <small class="text-muted">يُفضل استخدام اسم إنجليزي مثل: Accountant, Reviewer, ProjectManager</small>
                            </div>

                            <div class="form-group">
                                <label asp-for="Description"></label>
                                <textarea asp-for="Description" class="form-control" rows="3"
                                          placeholder="وصف مختصر للدور ومسؤولياته..."></textarea>
                            </div>

                            <div class="alert alert-info">
                                <i class="fas fa-info-circle mr-1"></i>
                                بعد إنشاء الدور، يمكنك تعيين الصلاحيات له من صفحة "صلاحيات الأدوار".
                            </div>
                        </div>
                        <div class="card-footer">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save mr-1"></i> حفظ الدور
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times mr-1"></i> إلغاء
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}