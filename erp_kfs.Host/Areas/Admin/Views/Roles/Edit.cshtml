@model MyERP.Web.Areas.Admin.Models.EditRoleViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "تعديل الدور";
    bool isProtected = ViewBag.IsProtected as bool? ?? false;
}

<div class="content-header">
    <div class="container-fluid">
        <h1><i class="fas fa-edit mr-2"></i> تعديل الدور</h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-6">
                @if (isProtected)
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle mr-1"></i>
                        هذا دور أساسي في النظام ولا يمكن تعديل اسمه.
                    </div>
                }

                <div class="card card-warning">
                    <div class="card-header">
                        <h3 class="card-title">تعديل بيانات الدور</h3>
                    </div>
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="form-group">
                                <label asp-for="Name"></label>
                               <input asp-for="Name" class="form-control" readonly="@isProtected" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="card-footer">
                            @if (!isProtected)
                            {
                                <button type="submit" class="btn btn-warning">
                                    <i class="fas fa-save mr-1"></i> حفظ التعديلات
                                </button>
                            }
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-right mr-1"></i> العودة
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}