@model LeadershipAssignment
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "تعيين قيادة";
}

<div class="content-header">
    <h1>تعيين قيادة جديدة</h1>
</div>

<form asp-action="Create" method="post">
    <div class="card">
        <div class="card-body">
            <div class="form-group">
                <label>القائد</label>
                <select asp-for="EmployeeId" class="form-control" required>
                    <option value="">اختر القيادة</option>
                    @foreach (var emp in ViewBag.Employees as List<EmployeeAdmin>)
                    {
                        <option value="@emp.Id">@emp.FullName</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>المنصب القيادي</label>
                <select asp-for="PositionId" class="form-control" required>
                    <option value="">اختر منصبًا</option>
                    @foreach (var pos in ViewBag.Positions as List<GlobalLeadershipPosition>)
                    {
                        <option value="@pos.Id">@pos.DisplayName</option>
                    }
                </select>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">حفظ التعيين</button>
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
        </div>
    </div>
</form>