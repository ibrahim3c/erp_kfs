@using erp_kfs.Host.Models
@model Department
@{
    ViewData["Title"] = "تعديل قسم";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">@ViewData["Title"]</h3>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="ManagerId" class="control-label"></label>
                <select asp-for="ManagerId" class="form-control select2" style="width: 100%;">
                    <option value="">-- اختر مديرًا --</option>
                    @if (ViewBag.Employees != null)
                    {
                        @foreach (var emp in ViewBag.Employees as List<EmployeeAdmin>)
                        {
                            <option value="@emp.Id">@emp.FullName</option>
                        }
                    }
                </select>
                <span asp-validation-for="ManagerId" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i> حفظ التغييرات
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times"></i> إلغاء
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            // لتحسين مظهر الـ Dropdown
            $('.select2').select2({
                placeholder: "اختر مديرًا",
                allowClear: true
            });
        });
    </script>
}