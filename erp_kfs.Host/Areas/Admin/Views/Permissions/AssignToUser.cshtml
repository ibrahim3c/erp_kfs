@using erp_kfs.Host.Models
@model AssignTasksViewModel
@{
     Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    ViewData["Title"] = $"تعيين مهام العمل لـ {Model.UserName}";
}

<div class="content-header">
    <div class="container-fluid">
        <h1><i class="fas fa-user-tie mr-2"></i> تعيين مهام العمل</h1>
        <h4 class="text-muted">@Model.UserName</h4>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <form asp-action="AssignTasks" asp-area="Admin" method="post">
            <input type="hidden" name="UserId" value="@Model.UserId" />
            
            <div class="card">
                <div class="card-header bg-gradient-info">
                    <h3 class="card-title">اختر المهام وفقاً لقانون الخدمة المدنية</h3>
                </div>
                <div class="card-body">
                    @foreach (var category in Model.Permissions.GroupBy(p => p.Category))
                    {
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">
                                    <i class="fas fa-folder mr-2"></i> @GetCategoryName(category.Key)
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    @foreach (var perm in category)
                                    {
                                        <div class="col-md-6 mb-3">
                                            <div class="card shadow-sm border-left-info">
                                                <div class="card-body p-3">
                                                    <div class="form-check">
                                                        <input class="form-check-input" 
                                                               type="checkbox" 
                                                               name="SelectedTaskIds" 
                                                               value="@perm.Id" 
                                                               id="task-@perm.Id"
                                                               @(Model.SelectedTaskIds?.Contains(perm.Id) == true ? "checked" : "")>
                                                        <label class="form-check-label font-weight-bold" for="task-@perm.Id">
                                                            @perm.DisplayName
                                                        </label>
                                                        <p class="text-muted small mt-1 mb-0">@perm.LegalDescription</p>
                                                        @if (!string.IsNullOrEmpty(perm.LegalReference))
                                                        {
                                                            <small class="text-success d-block mt-1">
                                                                <i class="fas fa-balance-scale mr-1"></i> @perm.LegalReference
                                                            </small>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="card-footer text-right">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="fas fa-save mr-1"></i> حفظ المهام
                    </button>
                    <a asp-action="Index" asp-area="Admin" class="btn btn-secondary btn-lg">
                        <i class="fas fa-times mr-1"></i> إلغاء
                    </a>
                </div>
            </div>
        </form>
    </div>
</section>
@functions {
    string GetCategoryName(string category)
    {
        return category switch
        {
            "Recruitment" => "التوظيف",
            "HR" => "الموارد البشرية",
            "Departments" => "الإدارات",
            "Leadership" => "الهيكل القيادي",
            "Employee" => "مهام الموظف",
            "Attendance" => "الحضور والانصراف",
            "Payroll" => "المرتبات",
            _ => "عام"
        };
    }
}