@using erp_kfs.Host.Models
@model List<ApplicationUser>
@{

   Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
     ViewData["Title"] = "مهام العمل - الموظفون";

}

<div class="content-header">
    <div class="container-fluid">
        <h1><i class="fas fa-tasks mr-2"></i> مهام العمل للموظفين</h1>
        <p class="text-muted">إدارة المهام وفقاً لقانون الخدمة المدنية رقم 81 لسنة 2016</p>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">قائمة الموظفين</h3>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-hover">
                    <thead class="bg-light">
                        <tr>
                            <th>الاسم</th>
                            <th>البريد</th>
                            <th>الدور</th>
                            <th>عدد المهام</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.Email == "admin@erp.com") { <span class="badge badge-danger">مدير النظام</span> }
                                    else if (user.Email == "recruiter@erp.com") { <span class="badge badge-info">مسؤول التوظيف</span> }
                                    else { <span class="badge badge-success">موظف</span> }
                                </td>
                                <td>
                                    @{
                                        var taskCount = ViewBag.UserTaskCounts[user.Id] as int? ?? 0;
                                    }
                                    <span class="badge badge-primary">@taskCount مهمة</span>
                                </td>
                                <td>
                                    <a asp-action="AssignTasks" asp-route-userId="@user.Id" class="btn btn-sm btn-warning">
                                        <i class="fas fa-tasks mr-1"></i> تعيين المهام
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@if (TempData["Success"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            alert("@TempData["Success"]");
        });
    </script>
}
