@{
Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "تعيين الصلاحيات";
    var roles = ViewBag.Roles as List<string>;
    var users = ViewBag.Users as List<dynamic>;
    var permissions = ViewBag.Permissions as List<Permission>;
}

<div class="content-header">
    <h1>تعيين الصلاحيات</h1>
</div>

<div class="row">
    <!-- تعيين صلاحيات للأدوار -->
    <div class="col-md-6">
        <div class="card card-primary">
            <div class="card-header">
                <h5 class="card-title">صلاحيات الأدوار</h5>
            </div>
            <form asp-action="AssignRolePermissions" method="post">
                <div class="card-body">
                    <div class="form-group">
                        <label>اختر الدور</label>
                        <select name="roleName" class="form-control" required>
                            <option value="">-- اختر دور --</option>
                            @if (roles != null)
                            {
                                foreach (var role in roles)
                                {
                                    <option value="@role">@role</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>الصلاحيات</label>
                        <div class="border p-2" style="max-height: 300px; overflow-y: auto;">
                            @if (permissions != null)
                            {
                                foreach (var perm in permissions)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="selectedPermissions" value="@perm.Id" id="perm_@perm.Id">
                                        <label class="form-check-label" for="perm_@perm.Id">
                                            @perm.DisplayName
                                            <small class="text-muted">(@perm.Name)</small>
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-success">تحديث صلاحيات الدور</button>
                </div>
            </form>
        </div>
    </div>

    <!-- تعيين صلاحيات للمستخدمين -->
    <div class="col-md-6">
        <div class="card card-warning">
            <div class="card-header">
                <h5 class="card-title">صلاحيات المستخدمين</h5>
            </div>
            <form asp-action="AssignUserPermissions" method="post">
                <div class="card-body">
                    <div class="form-group">
                        <label>اختر المستخدم</label>
                        <select name="userId" class="form-control" required>
                            <option value="">-- اختر مستخدم --</option>
                            @if (users != null)
                            {
                                foreach (var user in users)
                                {
                                    <option value="@user.Id">@user.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>الصلاحيات</label>
                        <div class="border p-2" style="max-height: 300px; overflow-y: auto;">
                            @if (permissions != null)
                            {
                                foreach (var perm in permissions)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="selectedPermissions" value="@perm.Id" id="user_perm_@perm.Id">
                                        <label class="form-check-label" for="user_perm_@perm.Id">
                                            @perm.DisplayName
                                            <small class="text-muted">(@perm.Name)</small>
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-warning">تحديث صلاحيات المستخدم</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @if (TempData["Success"] != null)
    {
        <script>
            alert("@TempData["Success"]");
        </script>
    }
}