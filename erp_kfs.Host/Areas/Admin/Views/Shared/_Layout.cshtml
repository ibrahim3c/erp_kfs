<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - المنصة الرقمية الموحدة</title>

    <meta name="description" content="المنصة الرقمية الموحدة لمحافظة كفر الشيخ - نظام ERP شامل لإدارة الموارد البشرية، المخازن، الشئون القانونية، والحملة">
    <meta name="keywords" content="ERP, كفر الشيخ, موارد بشرية, مخازن, حكومة الكترونية, تحول رقمي">
    <meta name="author" content="الإدارة العامة لنظم المعلومات والتحول الرقمي">

    <link rel="stylesheet" href="~/css/bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/all.min.css">
    <link rel="stylesheet" href="~/css/animate/animate.css">
    <link rel="stylesheet" href="~/css/global/main.css">
    <link rel="stylesheet" href="~/css/global/adminlte.css">
    <link rel="stylesheet" href="~/css/global/dash-style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap">

    <style>
            :root {
                --dark-navbar: #0f172a;
            }

            body {
                font-family: 'Cairo', sans-serif !important;
                margin: 0;
                background-color: #f4f6f9;
            }
            /* إعدادات النافبار والقائمة الجانبية لتثبيتهما بشكل صحيح */
            .main-header-custom {
                background: var(--dark-navbar) !important;
                border-bottom: 1px solid rgba(255,255,255,0.1);
                height: 62px;
                z-index: 1040;
            }

            .main-sidebar {
                top: 62px !important;
                height: calc(100vh - 62px) !important;
                position: fixed !important;
                background: var(--dark-navbar) !important;
                border-left: 1px solid rgba(255,255,255,0.05);
            }

            .sidebar {
                height: calc(100% - 10px) !important;
                overflow-y: auto;
            }

            .content-wrapper {
                margin-top: 0 !important;
                padding-top: 20px; /* مسافة جمالية للمحتوى */
            }

            /* أزرار وحقول النافبار */
            .btn-login-style {
                background: transparent;
                border: 1px solid #3b82f6;
                border-radius: 8px;
                color: #3b82f6;
                font-size: 0.9rem;
                font-weight: 700;
                transition: all 0.3s ease;
            }

                .btn-login-style:hover {
                    background: #3b82f6 !important;
                    color: #fff !important;
                    box-shadow: 0 0 15px rgba(59, 130, 246, 0.4);
                }

            /* زر تسجيل الخروج (جديد) */
            .btn-logout-style {
                background: transparent;
                border: 1px solid rgba(239, 68, 68, 0.7);
                border-radius: 8px;
                color: #ef4444 !important;
                font-size: 0.9rem;
                font-weight: 700;
                transition: all 0.3s ease;
                padding: 0.25rem 1rem;
            }

                .btn-logout-style:hover {
                    background: #ef4444 !important;
                    color: #fff !important;
                    box-shadow: 0 0 15px rgba(239, 68, 68, 0.4);
                    border-color: #ef4444;
                }

            .search-permanent input::placeholder {
                color: rgba(255,255,255,0.4);
            }

            .search-permanent input:focus {
                outline: none;
                box-shadow: none;
            }

            /* تعديلات احترافية لبطاقات لوحة التحكم (Cards) */
            .small-box {
                border-radius: 12px;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
                transition: transform 0.3s ease, box-shadow 0.3s ease;
                overflow: hidden;
                margin-bottom: 25px;
            }

                .small-box:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.15);
                }
                /* ضبط الأيقونة الكبيرة لتناسب اللغة العربية (تكون على اليسار) */
                .small-box .icon > i {
                    right: auto !important;
                    left: 15px !important;
                    transition: transform 0.3s ease;
                }

                .small-box:hover .icon > i {
                    transform: scale(1.15);
                }

                .small-box > .small-box-footer {
                    background-color: rgba(0,0,0,0.15);
                    font-weight: 500;
                }

            /* تنسيق الفوتر */
            .main-footer-custom {
                background: var(--dark-navbar) !important;
                border-top: 1px solid rgba(255,255,255,0.1) !important;
                padding: 1.2rem 0;
                color: #fff;
            }
    </style>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">

        <nav class="navbar sticky-top shadow-sm main-header-custom px-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <a class="nav-link text-white p-2 rounded-3" data-widget="pushmenu" href="#" role="button" title="فتح/غلق القائمة">
                    <i class="fas fa-bars fs-5"></i>
                </a>
                <div class="navbar-brand d-flex align-items-center m-0" style="cursor: default;">
                    <img src="~/imgs/kfslogo.jpg" style="height: 42px; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.3);" alt="شعار المحافظة">
                    <div class="d-flex flex-column me-3 d-none d-md-flex" style="gap: 2px;">
                        <span style="color: #fff; font-weight: 800; font-size: 1.1rem; line-height: 1;">الإدارة المركزية</span>
                        <small style="color: rgba(255,255,255,0.7); font-size: 0.75rem;">محافظة كفر الشيخ</small>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <div class="search-permanent d-none d-lg-block" style="width: 280px;">
                    <div class="input-group overflow-hidden shadow-sm d-flex flex-row-reverse" style="background: rgba(255,255,255,0.08); border-radius: 50px; border: 1px solid rgba(255,255,255,0.1); padding: 2px 15px;">
                        <span class="input-group-text border-0 bg-transparent p-0 d-flex align-items-center">
                            <i class="fas fa-search text-white opacity-50"></i>
                        </span>
                        <input class="form-control border-0 bg-transparent text-white me-2" type="search" placeholder="بحث سريع..." aria-label="Search" style="font-size: 0.9rem; height: 34px;">
                    </div>
                </div>

                <a class="nav-link text-white opacity-75 hover-opacity-100 d-none d-sm-block ms-2" data-widget="fullscreen" href="#" role="button" title="تكبير الشاشة">
                    <i class="fas fa-expand-arrows-alt fs-5"></i>
                </a>

                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-login-style ms-2 d-flex align-items-center gap-2 px-3 py-1">
                    <i class="fa-solid fa-house-user"></i>
                    <span class="d-none d-sm-inline">الرئيسية</span>
                </a>

                <form asp-area="Identity" asp-page="/Account/Manage/Logout" asp-route-returnUrl="@Url.Page("/Account/Login", new { area = "Identity" })"
                      method="post" style="display:inline;">
                    <button type="submit" class="btn btn-logout-style ms-2 d-flex align-items-center gap-2 py-1">
                        <i class="fa-solid fa-power-off"></i>
                        <span class="d-none d-sm-inline">خروج</span>
                    </button>
                </form>
            </div>
        </nav>

        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <div class="sidebar p-0 mt-2">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="nav-link active">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>لوحة التحكم الرئيسية</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link text-warning">
                                <i class="nav-icon fas fa-user-shield"></i>
                                <p>الأمان والمستخدمين <i class="right fas fa-angle-left"></i></p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="nav-link">
                                        <i class="fas fa-users nav-icon"></i>
                                        <p>إدارة المستخدمين</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Roles" asp-action="Index" class="nav-link">
                                        <i class="fas fa-key nav-icon"></i>
                                        <p>الأدوار والصلاحيات</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="UserRoles" asp-action="Index" class="nav-link">
                                        <i class="fas fa-user-tag nav-icon"></i>
                                        <p>توزيع الصلاحيات</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Audit" asp-action="LoginHistory" class="nav-link">
                                        <i class="fas fa-history nav-icon"></i>
                                        <p>سجل الدخول</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-database"></i>
                                <p>البيانات الأساسية <i class="fas fa-angle-left right"></i></p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Organization" asp-action="Branches" class="nav-link">
                                        <i class="far fa-building nav-icon"></i>
                                        <p>الفروع والمكاتب</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Organization" asp-action="Departments" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>الهيكل الإداري</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Lookups" asp-action="Index" class="nav-link">
                                        <i class="far fa-list-alt nav-icon"></i>
                                        <p>قوائم النظام (Lookups)</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-header">إعدادات المنصة</li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Settings" asp-action="General" class="nav-link">
                                <i class="nav-icon fas fa-cogs"></i>
                                <p>الإعدادات العامة</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Settings" asp-action="Modules" class="nav-link">
                                <i class="nav-icon fas fa-cubes"></i>
                                <p>إدارة الموديولات</p>
                            </a>
                        </li>

                        <li class="nav-header">الصيانة والتقارير</li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Audit" asp-action="SystemLogs" class="nav-link">
                                <i class="nav-icon fas fa-clipboard-list"></i>
                                <p>سجل الأحداث (Logs)</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Backup" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-download"></i>
                                <p>النسخ الاحتياطي</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Notifications" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-bell"></i>
                                <p>إرسال إشعارات عامة</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <div class="content-wrapper">
            @RenderBody()
        </div>

        <footer class="main-footer-custom text-center">
            <div class="container-fluid">
                <p class="m-0 fs-6 opacity-75">
                    حقوق الطبع والنشر &copy; الإدارة العامة لنظم المعلومات والتحول الرقمي
                    <a href="#" class="text-primary fw-bold text-decoration-none">إدارة النظم والتطبيقات</a>.
                </p>
            </div>
        </footer>

    </div>
    <script src="~/js/jquery/jquery.min.js"></script>
    <script src="~/js/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/js/all.min.js"></script>
    <script src="~/js/global/adminlte.js"></script>
    <script src="~/js/global/main.js"></script>
    <script src="~/js/animate/wow.min.js"></script>

    <script>
        new WOW().init();
        $(function () {
        // تفعيل Select2 إذا كانت مستخدمة
        if($('.select2').length) {
        $('.select2').select2();
        }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>