@model LeaveRequest
@{
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "طلب إجازة جديدة";

    var employee = ViewBag.Employee as EmployeeAdmin;
    var canTakeLeave = ViewBag.CanTakeLeave as bool? ?? true;
    var disableReason = ViewBag.DisableReason as string;
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">طلب إجازة جديدة</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <!-- عرض الرصيد -->
                @if (employee != null)
                {
                    <div class="alert alert-info">
                        <strong>رصيد الإجازة الاعتيادية:</strong> 
                        @employee.RemainingAnnualLeave من @employee.AnnualLeaveEntitlement يوم
                    </div>
                }

                @if (!canTakeLeave)
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i> @disableReason
                    </div>
                }

                <form asp-action="Create" method="post">
                    <div class="form-group">
                        <label>نوع الإجازة</label>
                       @{
    var selectDisabled = !canTakeLeave ? "disabled" : "";
}
@{
    var isDisabled = !canTakeLeave ? "disabled" : "";
}
<select asp-for="LeaveTypeId" class="form-control"
        disabled="@((bool)ViewBag.IsLeaveRequestDisabled)">
    <option value="">-- اختر نوع الإجازة --</option>
    @foreach (var type in ViewBag.LeaveTypes as List<LeaveType>)
    {
                                // منع الإجازات الجنسية لو مش مناسبة
                                if (type.IsGenderSpecific && employee?.Gender != "أنثى")
                                {
                                    continue;
                                }
                                // منع الإجازة الاعتيادية لو الرصيد = 0
                                if (type.IsAnnualBasedOnService && employee != null && employee.RemainingAnnualLeave <= 0)
                                {
                                    continue;
                                }
                                <option value="@type.Id">@type.DisplayName</option>
                            }
                        </select>
                        @if (!canTakeLeave)
                        {
                            <input type="hidden" asp-for="LeaveTypeId" />
                        }
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>من تاريخ</label>
                                <input asp-for="StartDate" type="date" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>إلى تاريخ</label>
                                <input asp-for="EndDate" type="date" class="form-control" required />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>عدد الأيام (يُحسب تلقائيًّا)</label>
                        <input asp-for="DaysRequested" type="number" step="0.5" class="form-control" readonly />
                    </div>

                    <div class="form-group">
                        <label>ملاحظات (اختياري)</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    </div>

                    @if (canTakeLeave)
                    {
                        <button type="submit" class="btn btn-primary">إرسال الطلب</button>
                    }
                    <a asp-action="MyRequests" class="btn btn-secondary">إلغاء</a>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.getElementById('StartDate').addEventListener('change', calculateDays);
        document.getElementById('EndDate').addEventListener('change', calculateDays);

        function calculateDays() {
            const startInput = document.getElementById('StartDate');
            const endInput = document.getElementById('EndDate');
            const daysInput = document.getElementById('DaysRequested');

            const start = startInput.value ? new Date(startInput.value) : null;
            const end = endInput.value ? new Date(endInput.value) : null;

            if (!start || !end || end < start) {
                daysInput.value = '';
                return;
            }

            const diffTime = Math.abs(end - start);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
            daysInput.value = diffDays;
        }
    </script>
}