@model List<LeaveRequest>
@{
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "سجل الموافقات";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">سجل طلبات الموظفين التابعين</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                @if (Model.Count == 0)
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle mr-1"></i> لا توجد طلبات حتى الآن.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead class="bg-light">
                                <tr>
                                    <th>الموظف</th>
                                    <th>نوع الإجازة</th>
                                    <th>الفترة</th>
                                    <th>الأيام</th>
                                    <th>الحالة</th>
                                    <th>تاريخ الطلب</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model)
                                {
                                    <tr>
                                        <td>@r.Employee?.FullName</td>
                                        <td>@r.LeaveType?.DisplayName</td>
                                        <td>@r.StartDate?.ToString("dd/MM/yyyy") - @r.EndDate?.ToString("dd/MM/yyyy")</td>
                                        <td>@r.DaysRequested</td>
                                        <td>
                                            @switch (r.Status)
                                            {
                                                case "HRApproved":
                                                    <span class="badge badge-success">معتمدة</span>
                                                    break;
                                                case "Rejected":
                                                    <span class="badge badge-danger">مرفوضة</span>
                                                    break;
                                                case "PendingHR":
                                                    <span class="badge badge-warning">بانتظار HR</span>
                                                    break;
                                                case "PendingManager":
                                                    <span class="badge badge-info">بانتظار الموافقة</span>
                                                    break;
                                                default:
                                                    <span class="badge badge-secondary">@r.Status</span>
                                                    break;
                                            }
                                        </td>
                                        <td>@r.RequestDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</section>