@model List<LeaveRequest>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "سجل الإجازات المعتمدة";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">الإجازات المعتمدة</h3>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>نوع الإجازة</th>
                        <th>من</th>
                        <th>إلى</th>
                        <th>الأيام</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lr in Model)
                    {
                        <tr>
                            <td>@lr.LeaveType?.DisplayName</td>
                            <td>@lr.StartDate?.ToString("dd/MM/yyyy")</td>
                            <td>@lr.EndDate?.ToString("dd/MM/yyyy")</td>
                            <td>@lr.DaysRequested</td>
                            <td><span class="badge badge-success">معتمدة</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">لا يوجد إجازات معتمدة حتى الآن.</p>
        }
    </div>
</div>