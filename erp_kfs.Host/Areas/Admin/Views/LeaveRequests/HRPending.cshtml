@model List<LeaveRequest>
@{
    ViewData["Title"] = "طلبات اعتماد HR";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">طلبات اعتماد الموارد البشرية</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                @if (Model == null || !Model.Any())
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> لا توجد طلبات بانتظار الاعتماد.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>الموظف</th>
                                    <th>نوع الإجازة</th>
                                    <th>من</th>
                                    <th>إلى</th>
                                    <th>الأيام</th>
                                    <th>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var lr in Model)
                                {
                                    <tr>
                                        <td>@lr.Employee?.FullName</td>
                                        <td>@lr.LeaveType?.DisplayName</td>
                                        <td>@lr.StartDate?.ToString("dd/MM/yyyy")</td>
                                        <td>@lr.EndDate?.ToString("dd/MM/yyyy")</td>
                                        <td>@lr.DaysRequested</td>
                                        <td>
                                            <form asp-action="ApproveByHR" method="post" style="display:inline;">
                                                <input type="hidden" name="id" value="@lr.Id" />
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    <i class="fas fa-check"></i> اعتماد
                                                </button>
                                            </form>
                                            <form asp-action="RejectByHR" method="post" style="display:inline;">
                                                <input type="hidden" name="id" value="@lr.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="fas fa-times"></i> رفض
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</section>