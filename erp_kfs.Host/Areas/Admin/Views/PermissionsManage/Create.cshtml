@model MyERP.Web.Areas.Admin.Models.CreatePermissionViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "إضافة صلاحية جديدة";
    var categories = ViewBag.Categories as List<string> ?? new();
}

<div class="content-header">
    <div class="container-fluid">
        <h1><i class="fas fa-plus-circle mr-2"></i> إضافة صلاحية جديدة</h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">بيانات الصلاحية</h3>
                    </div>
                    <form asp-action="Create" method="post">
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Name"></label>
                                        <input asp-for="Name" class="form-control" dir="ltr"
                                               placeholder="مثل: Reports.Financial" />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                        <small class="text-muted">
                                            صيغة الكود: <code>Category.Action</code>
                                            <br />أمثلة: <code>Reports.View</code>، <code>Payroll.Export</code>
                                        </small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="DisplayName"></label>
                                        <input asp-for="DisplayName" class="form-control"
                                               placeholder="مثل: التقارير المالية - عرض" />
                                        <span asp-validation-for="DisplayName" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Category"></label>
                                        <select asp-for="Category" class="form-control">
                                            @foreach (var cat in categories)
                                            {
                                                <option value="@cat">@cat</option>
                                            }
                                        </select>
                                        <span asp-validation-for="Category" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="NewCategory"></label>
                                        <input asp-for="NewCategory" class="form-control"
                                               placeholder="اكتب اسم فئة جديدة (اختياري)" />
                                        <small class="text-muted">لو عاوز فئة جديدة غير الموجودة</small>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label asp-for="LegalDescription"></label>
                                <textarea asp-for="LegalDescription" class="form-control" rows="2"
                                          placeholder="وصف المهمة وفقاً لقانون الخدمة المدنية..."></textarea>
                            </div>

                            <div class="form-group">
                                <label asp-for="LegalReference"></label>
                                <input asp-for="LegalReference" class="form-control"
                                       placeholder="مثل: قانون 81/2016 - المادة 47" />
                            </div>
                        </div>
                        <div class="card-footer">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save mr-1"></i> حفظ الصلاحية
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times mr-1"></i> إلغاء
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}