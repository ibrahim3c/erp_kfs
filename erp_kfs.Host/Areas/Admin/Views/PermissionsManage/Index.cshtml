@model List<MyERP.Web.Models.Permission>
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "إدارة الصلاحيات";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1><i class="fas fa-shield-alt mr-2"></i> إدارة الصلاحيات</h1>
            </div>
            <div class="col-sm-6 text-left">
                <a asp-action="Create" asp-area="Admin" class="btn btn-success">
                    <i class="fas fa-plus mr-1"></i> إضافة صلاحية جديدة
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                @TempData["Success"]
            </div>
        }

        @if (Model.Count == 0)
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle mr-1"></i> لا توجد صلاحيات مُضافة حتى الآن.
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-header bg-gradient-info">
                    <h3 class="card-title">قائمة الصلاحيات</h3>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th style="width: 10%;">الكود</th>
                                    <th style="width: 30%;">الاسم</th>
                                    <th style="width: 25%;">الفئة</th>
                                    <th style="width: 25%;">الوصف القانوني</th>
                                    <th style="width: 10%;">الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="align-middle">@item.Name</td>
                                        <td class="align-middle">@item.DisplayName</td>
                                        <td class="align-middle">@item.Category</td>
                                        <td class="align-middle">@item.LegalDescription</td>
                                        <td class="text-center align-middle text-nowrap">
                                            <a asp-action="Edit" asp-area="Admin" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="تعديل">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form asp-action="Delete" asp-area="Admin" method="post" style="display:inline;" onsubmit="return confirm('هل أنت متأكد من حذف هذه الصلاحية؟');">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger" title="حذف">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</section>