@model MyERP.Web.Areas.Admin.Models.EditPermissionViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "تعديل الصلاحية";
    var categories = ViewBag.Categories as List<string> ?? new();
}

<div class="content-header">
    <div class="container-fluid">
        <h1><i class="fas fa-edit mr-2"></i> تعديل الصلاحية</h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card card-warning">
                    <div class="card-header">
                        <h3 class="card-title">تعديل بيانات الصلاحية</h3>
                    </div>
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Name"></label>
                                        <input asp-for="Name" class="form-control" dir="ltr" />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="DisplayName"></label>
                                        <input asp-for="DisplayName" class="form-control" />
                                        <span asp-validation-for="DisplayName" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="Category"></label>
                                        <select asp-for="Category" class="form-control">
                                            @foreach (var cat in categories)
                                            {
                                                <option value="@cat">@cat</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="NewCategory"></label>
                                        <input asp-for="NewCategory" class="form-control"
                                               placeholder="فئة جديدة (اختياري)" />
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label asp-for="LegalDescription"></label>
                                <textarea asp-for="LegalDescription" class="form-control" rows="2"></textarea>
                            </div>

                            <div class="form-group">
                                <label asp-for="LegalReference"></label>
                                <input asp-for="LegalReference" class="form-control" />
                            </div>
                        </div>
                        <div class="card-footer">
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save mr-1"></i> حفظ التعديلات
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times mr-1"></i> إلغاء
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}